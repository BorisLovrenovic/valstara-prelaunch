---
import type { HeroBanner } from '../content/landing-hero.ts';
import { providerShowcaseCopy } from '../copy/provider-showcase.ts';

interface Props {
  banner: HeroBanner;
  // The large and medium stack draws the logo and category; the small strip
  // draws the name only.
  size: 'stack' | 'strip';
}
const { banner, size } = Astro.props;
const { provider } = banner;
const category =
  providerShowcaseCopy.categories[
    provider.category as keyof typeof providerShowcaseCopy.categories
  ];
---

{
  /*
  A composed hero banner (E11.5-11c): the brand colour, one tonal shape and the
  name chip. Its parent stack or strip is aria-hidden, so the logo is
  decorative. The tone is clipped by its own box, so the banner never reports
  clipped text.
*/
}
<div
  class:list={[
    'hero-banner',
    `hero-banner--${size}`,
    `hero-banner--tone-${banner.tone}`,
    `hero-banner--on-${banner.foreground}`,
  ]}
  style={`--provider-colour: ${provider.brandColor}`}
  data-hero-banner={provider.name}
>
  <span class="hero-banner__clip">
    <span
      class:list={['hero-banner__tone', `hero-banner__tone--${banner.shape}`]}
    ></span>
  </span>
  <span class="hero-banner__chip">
    {
      size === 'stack' && (
        <img
          src={provider.logo}
          alt=""
          width={banner.logoWidth}
          height={banner.logoHeight}
          loading="lazy"
          decoding="async"
        />
      )
    }
    {provider.name}
  </span>
  {size === 'stack' && <span class="hero-banner__category">{category}</span>}
</div>

<style>
  .hero-banner {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    min-inline-size: 0;
    background: var(--provider-colour);
    border-radius: var(--radius-card);
  }

  .hero-banner--on-white {
    color: var(--banner-white);
  }

  .hero-banner--on-ink {
    color: var(--banner-ink);
  }

  /* Medium: 136px tall with 16px padding. Large: 184px with 24px padding. */
  .hero-banner--stack {
    block-size: calc(var(--space-1) * 17);
    padding: var(--space-2);
    box-shadow: var(--shadow-2), var(--banner-edge-hero);
  }

  /* Small: 56px tall with 8px padding; 4px below 22.5rem, the 320 frame. */
  .hero-banner--strip {
    block-size: var(--space-7);
    padding: var(--space-1);
    justify-content: center;
    box-shadow: var(--shadow-1), var(--banner-edge);
  }

  .hero-banner__clip {
    position: absolute;
    inset: var(--space-0);
    overflow: hidden;
    border-radius: inherit;
  }

  .hero-banner__tone {
    position: absolute;
    pointer-events: none;
  }

  .hero-banner--tone-dark .hero-banner__tone {
    background: var(--banner-tone-dark);
  }

  .hero-banner--tone-light .hero-banner__tone {
    background: var(--banner-tone-light);
  }

  .hero-banner--tone-ink .hero-banner__tone {
    background: var(--banner-tone-ink);
  }

  /* The wireframe's .t1 to .t3 shapes, proportional to the banner. */
  .hero-banner__tone--t1 {
    top: calc(100% * -0.8);
    right: calc(100% * -0.12);
    width: 55%;
    height: 260%;
    transform: rotate(24deg);
  }

  .hero-banner__tone--t2 {
    right: calc(100% * -0.2);
    bottom: calc(100% * -0.75);
    width: 62%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
  }

  .hero-banner__tone--t3 {
    top: calc(100% * -1.4);
    left: calc(100% * -0.34);
    width: 80%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
  }

  /* The chip stays light in both themes, with the ink name. */
  .hero-banner__chip {
    position: relative;
    box-sizing: border-box;
    display: inline-flex;
    flex: none;
    gap: var(--space-1);
    align-items: center;
    block-size: var(--space-5);
    padding-inline: calc(var(--space-1) * 1.75);
    color: var(--banner-ink);
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-2);
    white-space: nowrap;
    background: var(--banner-white);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-chip);
  }

  .hero-banner__chip img {
    display: block;
    inline-size: auto;
    block-size: var(--icon-sm);
  }

  .hero-banner--strip .hero-banner__chip {
    gap: var(--space-0-75);
    block-size: var(--space-4);
    padding-inline: var(--space-1);
    font-size: var(--step-0);
    line-height: var(--leading-0);
  }

  .hero-banner__category {
    position: relative;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: var(--weight-medium);
    line-height: var(--leading-0);
  }

  @media (width < 22.5rem) {
    .hero-banner--strip {
      padding: var(--space-0-5);
    }

    .hero-banner--strip .hero-banner__chip {
      padding-inline: var(--space-0-75);
    }
  }

  @media (min-width: 64rem) {
    .hero-banner--stack {
      block-size: calc(var(--space-1) * 23);
      padding: var(--space-3);
    }

    .hero-banner--stack .hero-banner__chip {
      block-size: var(--control-height);
      padding-inline: var(--space-2);
    }
  }
</style>
