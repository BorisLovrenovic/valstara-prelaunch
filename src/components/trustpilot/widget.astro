---
interface Props {
  businessUnitId: string;
  templateId: string;
}

const { businessUnitId, templateId } = Astro.props;
// Only /legit emits this component after trustpilot.widget and count checks.
---

<div
  class="trustpilot-widget"
  data-locale="en-US"
  data-template-id={templateId}
  data-businessunit-id={businessUnitId}
>
</div>
<script
  is:inline
  src="https://widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js"
  async></script>
