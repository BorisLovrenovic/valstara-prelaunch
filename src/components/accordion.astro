---
import type { HTMLAttributes } from 'astro/types';
import Icon from './icon.astro';

type Props = HTMLAttributes<'details'> & {
  summary: string;
};

const { class: className, summary, ...attributes } = Astro.props;
---

<details {...attributes} class:list={['accordion', className]}>
  <summary class="accordion__summary">
    <span class="accordion__question">{summary}</span>
    <span class="accordion__disc" aria-hidden="true">
      <Icon name="chevron-down" size="base" class="accordion__chevron" />
    </span>
  </summary>
  <div class="accordion__content">
    <slot />
  </div>
</details>

<style>
  /* The FAQ item is unboxed: the card that holds a list of items belongs to
     the section, and consecutive items are divided by a 1px line. */
  .accordion {
    color: var(--ink);
    font-family: var(--font-sans);
  }

  .accordion + .accordion {
    border-block-start: var(--border-thin) solid var(--line);
  }

  .accordion__summary {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
    min-block-size: var(--space-8);
    box-sizing: border-box;
    padding-block: var(--space-2-5);
    padding-inline: var(--space-0);
    font-size: var(--step-2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-2);
    list-style: none;
    cursor: pointer;
    border-radius: var(--radius-check);
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__summary:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  /* The 20px chevron on its 32px disc. */
  .accordion__disc {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-4);
    block-size: var(--space-4);
    color: var(--ink-600);
    background-color: var(--wash);
    border-radius: var(--radius-pill);
    transition-property: background-color, color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .accordion__summary:hover .accordion__disc {
    color: var(--ink);
    background-color: var(--wash-strong);
  }

  .accordion[open] .accordion__disc {
    color: var(--ink);
  }

  .accordion :global(.accordion__chevron) {
    transition-property: transform;
    transition-duration: var(--duration-base);
    transition-timing-function: var(--ease-out);
  }

  .accordion[open] :global(.accordion__chevron) {
    transform: rotate(180deg);
  }

  .accordion__content {
    box-sizing: border-box;
    max-inline-size: var(--measure);
    padding-block-end: var(--space-3);
    color: var(--ink-600);
    font-size: var(--step-2);
    line-height: var(--leading-2);
    text-wrap: pretty;
  }

  @media (min-width: 48rem) {
    .accordion__content {
      padding-inline-end: var(--space-6);
    }
  }

  /* The answer opens and closes smoothly where the browser can animate to its
     natural height. Elsewhere, and with reduced motion, it opens instantly. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) and selector(::details-content) {
      .accordion {
        interpolate-size: allow-keywords;
      }

      .accordion::details-content {
        block-size: 0;
        overflow-y: clip;
        transition-property: block-size, content-visibility;
        transition-behavior: allow-discrete;
        transition-duration: var(--duration-base);
        transition-timing-function: var(--ease-out);
      }

      .accordion[open]::details-content {
        block-size: auto;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .accordion__disc,
    .accordion :global(.accordion__chevron) {
      transition-property: none;
    }
  }
</style>
