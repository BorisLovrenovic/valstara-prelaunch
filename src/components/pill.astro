---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'span'> & {
  // pill: the coral-tint reward pill, with an optional 16px icon.
  // coral: the solid coral pill; wrap its figures in .tabular-figure.
  // badge: the coral marker for a figure or state, set wholly in mono
  // (identity §6.2), such as the access-wave badge.
  // step: the 24px ink step badge, set in mono.
  variant?: 'pill' | 'coral' | 'badge' | 'step';
};

const { class: className, variant = 'pill', ...attributes } = Astro.props;
---

<span
  {...attributes}
  class:list={['pill', variant !== 'pill' && `pill--${variant}`, className]}
>
  <slot />
</span>

<style>
  .pill {
    display: inline-flex;
    gap: var(--space-0-75);
    align-items: center;
    padding-block: var(--space-0-5);
    padding-inline: var(--space-1-5);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-0);
    white-space: nowrap;
    background-color: var(--coral-tint);
    border-radius: var(--radius-pill);
  }

  .pill--coral,
  .pill--badge {
    color: var(--on-coral);
    background-color: var(--coral);
  }

  .pill--badge {
    font-family: var(--font-mono);
  }

  .pill--step {
    box-sizing: border-box;
    justify-content: center;
    min-inline-size: var(--badge-size);
    block-size: var(--badge-size);
    padding-block: var(--space-0);
    padding-inline: var(--space-0-75);
    color: var(--paper);
    font-family: var(--font-mono);
    background-color: var(--ink);
  }
</style>
