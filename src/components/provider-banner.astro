---
import type { ProviderBannerModel } from './provider-banner.ts';
import { providerShowcaseCopy } from '../copy/provider-showcase.ts';

interface Props {
  banner: ProviderBannerModel;
  // catalogue: the 104px catalogue banner, chip with logo and category.
  // stack: the hero stack's 136px (medium) and 184px (large) banner.
  // strip: the small hero strip's 56px banner, a name-only chip.
  // final: the final call to action's logo-only banner (E11.5-11p), inside
  // an aria-hidden visual, so its logo is decorative.
  size: 'catalogue' | 'stack' | 'strip' | 'final';
  // The catalogue's large-width column, 0 to 4: the banner reveals on
  // scroll in reading order (E11.5-11n). Below 64rem the rail reveals whole.
  // A final banner's place in its row, 1 to 3: it rises after the card's
  // text (E11.5-11p).
  revealIndex?: number;
}
const { banner, size, revealIndex } = Astro.props;
const { provider } = banner;
const category =
  providerShowcaseCopy.categories[
    provider.category as keyof typeof providerShowcaseCopy.categories
  ];
const hero = size === 'stack' || size === 'strip';
const final = size === 'final';
const wordmark = !hero && banner.wordmarkHeight !== null;
const logo = {
  src: provider.logo,
  width: banner.logoWidth,
  height: banner.logoHeight,
  loading: 'lazy',
  decoding: 'async',
} as const;
// Every value here is data: the brand colour, the wordmark's optical height
// from the showcase file, and the reveal column.
const style = [
  `--provider-colour: ${provider.brandColor}`,
  wordmark && `--wordmark-height: ${banner.wordmarkHeight}px`,
  revealIndex !== undefined && `--reveal-index: ${revealIndex}`,
]
  .filter(Boolean)
  .join('; ');
---

{
  /*
  A composed provider banner (E11.5-11d, the catalogue size restyled by
  E11.5-11n): the full-bleed brand colour, the tonal layer (one shape in the
  hero; a shape and a ring in the catalogue), the name chip and the category
  label. In the catalogue a wordmark that spells the name shows alone, with
  the name as its alt text; an icon mark sits beside the name. The tone is clipped by
  its own box, so the banner never reports clipped text. The hero's stack and
  strip are aria-hidden, so their logos are decorative; in the catalogue the
  logo carries the name and the visible name is hidden from assistive
  technology. The hero-banner hooks are the classes the E11.5-11c geometry
  tests and the landing layout read.
*/
}
<div
  class:list={[
    'provider-banner',
    `provider-banner--${size}`,
    `provider-banner--tone-${banner.tone}`,
    `provider-banner--on-${banner.foreground}`,
    { 'hero-banner': hero },
  ]}
  style={style}
  data-provider-banner={size === 'catalogue' ? provider.name : undefined}
  data-hero-banner={hero ? provider.name : undefined}
  data-final-banner={final ? provider.name : undefined}
  data-reveal={revealIndex === undefined ? undefined : ''}
>
  {
    hero ? (
      <span class="provider-banner__clip" aria-hidden="true">
        <span
          class:list={[
            'provider-banner__tone',
            `provider-banner__tone--${banner.shape}`,
          ]}
        />
      </span>
    ) : (
      <span class="provider-banner__clip" aria-hidden="true">
        <span class="provider-banner__tones">
          <span
            class:list={[
              'provider-banner__tone',
              `provider-banner__tone--${banner.shape}`,
            ]}
          />
          <span
            class:list={[
              'provider-banner__ring',
              `provider-banner__ring--${banner.shape}`,
            ]}
          />
        </span>
      </span>
    )
  }
  <span
    class:list={[
      'provider-banner__logo',
      `provider-banner__logo--${banner.chipTone}`,
      { 'hero-banner__chip': hero },
      { 'provider-banner__logo--wordmark': wordmark },
    ]}
  >
    {
      final ? (
        <img
          {...logo}
          class:list={{ 'provider-banner__wordmark': wordmark }}
          alt=""
        />
      ) : size === 'catalogue' ? (
        wordmark ? (
          <img
            {...logo}
            class="provider-banner__wordmark"
            alt={provider.name}
          />
        ) : (
          <>
            <img {...logo} alt={provider.name} />
            <span class="provider-banner__name" aria-hidden="true">
              {provider.name}
            </span>
          </>
        )
      ) : (
        <>
          {size === 'stack' && <img {...logo} alt="" />}
          {provider.name}
        </>
      )
    }
  </span>
  {
    (size === 'catalogue' || size === 'stack') && (
      <span
        class:list={[
          'provider-banner__category',
          { 'hero-banner__category': hero },
        ]}
      >
        {category}
      </span>
    )
  }
</div>

<style>
  .provider-banner {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    min-inline-size: 0;
    background: var(--provider-colour);
    border-radius: var(--radius-card);
  }

  .provider-banner--on-white {
    color: var(--banner-white);
  }

  .provider-banner--on-ink {
    color: var(--banner-ink);
  }

  /*
    Catalogue (E11.5-11n, Main.dc.html): at least 104px tall with 14px
    padding and 12px between the chip and the label. It may grow where a
    narrow large-width column wraps its chip or category label, so no text
    ever overflows. On hover, and on focus-visible should a banner ever take
    focus (it is not in the tab order: founder decision 2026-11-08), it rises
    by --lift from shadow 1 to shadow 2 and its tonal layer shifts by
    --tone-shift, over --duration-base.
  */
  .provider-banner--catalogue {
    gap: var(--space-1-5);
    min-block-size: calc(var(--space-1) * 13);
    padding: var(--space-1-75);
    box-shadow: var(--shadow-1), var(--banner-edge);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .provider-banner--catalogue:hover,
  .provider-banner--catalogue:focus-visible {
    box-shadow: var(--shadow-2), var(--banner-edge);
    transform: translateY(var(--lift));
  }

  .provider-banner--catalogue:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  .provider-banner__tones {
    position: absolute;
    inset: var(--space-0);
    transition: translate var(--duration-base) var(--ease-out);
  }

  .provider-banner--catalogue:hover .provider-banner__tones,
  .provider-banner--catalogue:focus-visible .provider-banner__tones {
    translate: var(--tone-shift) var(--tone-shift);
  }

  /*
    Final call to action (E11.5-11p, Main.dc.html .cta__visual): at least
    96px tall with 12px padding, the logo chip centred. It takes the
    catalogue's hover lift: it rises by --lift from shadow 1 to shadow 2 over
    --duration-base. It is never focusable, and its tonal layer stays put.
  */
  .provider-banner--final {
    align-items: center;
    justify-content: center;
    min-block-size: calc(var(--space-1) * 12);
    padding: var(--space-1-5);
    box-shadow: var(--shadow-1), var(--banner-edge);
    transition:
      box-shadow var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .provider-banner--final:hover {
    box-shadow: var(--shadow-2), var(--banner-edge);
    transform: translateY(var(--lift));
  }

  /* Below 64rem the rail reveals as a whole, never banner by banner. */
  @media (width < 64rem) {
    .provider-banner--catalogue[data-reveal] {
      animation-name: none;
    }
  }

  /* Medium: 136px tall with 16px padding. Large: 184px with 24px padding. */
  .provider-banner--stack {
    block-size: calc(var(--space-1) * 17);
    padding: var(--space-2);
    box-shadow: var(--shadow-2), var(--banner-edge-hero);
  }

  /* Small: 56px tall with 8px padding; 4px below 22.5rem, the 320 frame. */
  .provider-banner--strip {
    block-size: var(--space-7);
    padding: var(--space-1);
    justify-content: center;
    box-shadow: var(--shadow-1), var(--banner-edge);
  }

  .provider-banner__clip {
    position: absolute;
    inset: var(--space-0);
    overflow: hidden;
    border-radius: inherit;
  }

  .provider-banner__tone {
    position: absolute;
    pointer-events: none;
  }

  .provider-banner--tone-dark .provider-banner__tone {
    background: var(--banner-tone-dark);
  }

  .provider-banner--tone-light .provider-banner__tone {
    background: var(--banner-tone-light);
  }

  .provider-banner--tone-ink .provider-banner__tone {
    background: var(--banner-tone-ink);
  }

  /* The wireframe's .t1 to .t6 shapes, proportional to the banner. */
  .provider-banner__tone--t1 {
    top: var(--banner-shape-t1-top);
    right: var(--banner-shape-t1-right);
    width: 55%;
    height: 260%;
    transform: rotate(24deg);
  }

  .provider-banner__tone--t2 {
    right: var(--banner-shape-t2-right);
    bottom: var(--banner-shape-t2-bottom);
    width: 62%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
  }

  .provider-banner__tone--t3 {
    top: var(--banner-shape-t3-top);
    left: var(--banner-shape-t3-left);
    width: 80%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
  }

  .provider-banner__tone--t4 {
    top: var(--banner-shape-t4-top);
    right: var(--banner-shape-t4-right);
    width: 36%;
    height: 280%;
    transform: rotate(-22deg);
  }

  .provider-banner__tone--t5 {
    top: var(--banner-shape-t5-top);
    right: var(--banner-shape-t5-right);
    width: 46%;
    aspect-ratio: 1;
    border-radius: var(--radius-pill);
  }

  .provider-banner__tone--t6 {
    top: var(--banner-shape-t6-top);
    left: var(--banner-shape-t6-left);
    width: 80%;
    height: 110%;
    transform: rotate(-14deg);
    border-radius: var(--radius-card);
  }

  /*
    The catalogue's second tonal layer (E11.5-11n): a 1.5px ring, white at 20%
    under white text and ink at 14% under ink, placed per composition as the
    canvas's .banner--t1 to .banner--t6 rings.
  */
  .provider-banner__ring {
    position: absolute;
    box-sizing: border-box;
    aspect-ratio: 1;
    border: var(--border-check) solid var(--banner-ring-dark);
    border-radius: var(--radius-pill);
    pointer-events: none;
  }

  .provider-banner--on-ink .provider-banner__ring {
    border-color: var(--banner-ring-ink);
  }

  .provider-banner__ring--t1 {
    right: var(--banner-ring-t1-right);
    bottom: var(--banner-ring-t1-bottom);
    width: 46%;
  }

  .provider-banner__ring--t2 {
    top: var(--banner-ring-t2-top);
    right: var(--banner-ring-t2-right);
    width: 38%;
  }

  .provider-banner__ring--t3 {
    right: var(--banner-ring-t3-right);
    bottom: var(--banner-ring-t3-bottom);
    width: 56%;
  }

  .provider-banner__ring--t4 {
    top: var(--banner-ring-t4-top);
    right: var(--banner-ring-t4-right);
    width: 30%;
  }

  .provider-banner__ring--t5 {
    top: var(--banner-ring-t5-top);
    right: var(--banner-ring-t5-right);
    width: 70%;
  }

  .provider-banner__ring--t6 {
    top: var(--banner-ring-t6-top);
    left: var(--banner-ring-t6-left);
    width: 34%;
  }

  /*
    The chip stays light in both themes, with the ink name; a white-only logo
    takes the dark chip. The catalogue chip is 36px with 14/20 text and may
    wrap rather than overflow; the hero chips keep one line.
  */
  .provider-banner__logo {
    position: relative;
    box-sizing: border-box;
    display: inline-flex;
    flex: none;
    gap: var(--space-1);
    align-items: center;
    min-block-size: calc(var(--space-1) * 4.5);
    padding-inline: var(--space-1-5);
    color: var(--banner-ink);
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-1);
    background: var(--banner-white);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-chip);
  }

  /*
    The catalogue chip (E11.5-11n): 40px tall, 0 12px padding, the 20px icon
    mark 6px from the name, which wraps (balanced) rather than overflow. A
    wordmark shows alone at its optical height from the data file, at most
    152px wide and 36px tall, scaled whole.
  */
  .provider-banner--catalogue .provider-banner__logo {
    gap: var(--space-0-75);
    max-inline-size: 100%;
    min-block-size: var(--space-5);
    padding-inline: var(--space-1-5);
  }

  .provider-banner--catalogue .provider-banner__logo img {
    block-size: var(--icon-base);
  }

  .provider-banner--catalogue
    .provider-banner__logo
    img.provider-banner__wordmark {
    max-inline-size: calc(var(--space-1) * 19);
    max-block-size: calc(var(--space-1) * 4.5);
    block-size: var(--wordmark-height);
    object-fit: contain;
    object-position: left center;
  }

  /*
    The final chip: 40px tall, 0 12px padding, holding the logo alone: an
    icon mark 24px tall, or a wordmark at its optical height from the data
    file, at most 152px wide.
  */
  .provider-banner--final .provider-banner__logo {
    max-inline-size: 100%;
    min-block-size: var(--space-5);
  }

  .provider-banner--final .provider-banner__logo img {
    block-size: var(--icon-md);
  }

  .provider-banner--final .provider-banner__logo img.provider-banner__wordmark {
    max-inline-size: calc(var(--space-1) * 19);
    block-size: var(--wordmark-height);
    object-fit: contain;
    object-position: left center;
  }

  .provider-banner__name {
    min-inline-size: 0;
    text-wrap: balance;
  }

  .provider-banner__logo--dark {
    color: var(--banner-white);
    background: var(--banner-ink);
    box-shadow: var(--shadow-chip-dark);
  }

  .provider-banner__logo img {
    display: block;
    flex: none;
    inline-size: auto;
    block-size: var(--icon-sm);
  }

  .provider-banner--stack .provider-banner__logo {
    min-block-size: var(--space-5);
    padding-inline: var(--space-1-75);
    font-size: var(--step-2);
    line-height: var(--leading-2);
    white-space: nowrap;
  }

  .provider-banner--strip .provider-banner__logo {
    gap: var(--space-0-75);
    min-block-size: var(--space-4);
    padding-inline: var(--space-1);
    font-size: var(--step-0);
    line-height: var(--leading-0);
    white-space: nowrap;
  }

  .provider-banner__category {
    position: relative;
    font-family: var(--font-sans);
    font-size: var(--step-0);
    font-weight: var(--weight-medium);
    line-height: var(--leading-0);
  }

  @media (prefers-reduced-motion: reduce) {
    .provider-banner--catalogue,
    .provider-banner--final,
    .provider-banner__tones {
      transition: none;
    }
  }

  @media (width < 22.5rem) {
    .provider-banner--strip {
      padding: var(--space-0-5);
    }

    .provider-banner--strip .provider-banner__logo {
      padding-inline: var(--space-0-75);
    }
  }

  /*
    Large widths below 80rem narrow the catalogue banner below the 1440
    frame's 227px, so its chip takes the compact style (Landing1024.dc.html):
    13/18 with 6px 8px padding, at least 32px tall, and a wordmark at 80% of
    its optical height, at most 120px wide.
  */
  @media (min-width: 64rem) and (width < 80rem) {
    .provider-banner--catalogue .provider-banner__logo {
      min-block-size: var(--space-4);
      padding-block: var(--space-0-75);
      padding-inline: var(--space-1);
      font-size: var(--step-0);
      line-height: var(--leading-0);
    }

    .provider-banner--catalogue
      .provider-banner__logo
      img.provider-banner__wordmark {
      max-inline-size: calc(var(--space-1) * 15);
      block-size: calc(var(--wordmark-height) * 0.8);
    }
  }

  @media (min-width: 64rem) {
    .provider-banner--stack {
      block-size: calc(var(--space-1) * 23);
      padding: var(--space-3);
    }

    .provider-banner--stack .provider-banner__logo {
      min-block-size: var(--control-height);
      padding-inline: var(--space-2);
    }
  }
</style>
