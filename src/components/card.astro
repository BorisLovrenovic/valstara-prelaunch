---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'article'> & {
  // An interactive card (one that is, or wraps, a single link) lifts on hover.
  interactive?: boolean;
};

const { class: className, interactive = false, ...attributes } = Astro.props;
---

<article
  {...attributes}
  class:list={['card', interactive && 'card--interactive', className]}
>
  <slot />
</article>

<style>
  .card {
    padding: var(--space-3);
    color: var(--ink);
    font-family: var(--font-sans);
    background-color: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1);
  }

  .card--interactive {
    transition-property: box-shadow;
    transition-duration: var(--duration-base);
    transition-timing-function: var(--ease-out);
  }

  .card--interactive:hover,
  .card--interactive:focus-within {
    box-shadow: var(--shadow-2);
  }

  @media (prefers-reduced-motion: reduce) {
    .card--interactive {
      transition-property: none;
    }
  }
</style>
