---
import type { HTMLAttributes } from 'astro/types';

type Shared = {
  // An interactive card (one that is, or wraps, a single link) lifts on hover.
  interactive?: boolean;
};

// With an href the whole card is the link: one native anchor, so it works
// without JavaScript and is announced as a single link.
type Props =
  | (HTMLAttributes<'article'> & Shared & { href?: undefined })
  | (HTMLAttributes<'a'> & Shared & { href: string });

const { class: className, interactive = false, ...attributes } = Astro.props;
const classes = [
  'card',
  interactive && 'card--interactive',
  attributes.href !== undefined && 'card--link',
  className,
];
---

{
  attributes.href === undefined ? (
    <article
      {...(attributes as HTMLAttributes<'article'>)}
      class:list={classes}
    >
      <slot />
    </article>
  ) : (
    <a {...(attributes as HTMLAttributes<'a'>)} class:list={classes}>
      <slot />
    </a>
  )
}

<style>
  /* --edge is transparent in light and a 1px light edge in dark, so every
     elevated surface keeps its outline on the dark ground. */
  .card {
    padding: var(--space-3);
    color: var(--ink);
    font-family: var(--font-sans);
    background-color: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1), var(--edge);
  }

  .card--link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .card--link:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  .card--interactive {
    transition-property: box-shadow, transform;
    transition-duration: var(--duration-base);
    transition-timing-function: var(--ease-out);
  }

  .card--interactive:hover {
    box-shadow: var(--shadow-2), var(--edge);
  }

  .card--interactive:active {
    box-shadow: var(--shadow-1), var(--edge);
  }

  /* The trailing arrow of a whole-card link. */
  .card--interactive :global(.card__arrow) {
    color: var(--ink-600);
    transition-property: color, transform;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .card--interactive:hover :global(.card__arrow) {
    color: var(--ink);
  }

  /* The card rises, and its arrow moves, only where motion is allowed. A
     pressed card sets back down. */
  @media (prefers-reduced-motion: no-preference) {
    .card--interactive:hover:not(:active) {
      transform: translateY(var(--lift));
    }

    .card--interactive:hover :global(.card__arrow) {
      transform: translateX(var(--arrow-shift-card));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card--interactive,
    .card--interactive :global(.card__arrow) {
      transition-property: none;
    }
  }
</style>
