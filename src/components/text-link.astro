---
import type { HTMLAttributes } from 'astro/types';
import Icon from './icon.astro';

type Props = HTMLAttributes<'a'> & {
  href: string;
  // A standalone link ends in the decorative arrow, which moves on hover.
  arrow?: boolean;
  // On a midnight band the text is on-midnight with a coral-lift underline.
  variant?: 'default' | 'on-midnight';
};

const {
  arrow = false,
  class: className,
  variant = 'default',
  ...attributes
} = Astro.props;
---

<a
  {...attributes}
  class:list={[
    'text-link',
    variant === 'on-midnight' && 'text-link--on-midnight',
    arrow && 'text-link--arrow',
    className,
  ]}
  ><slot />{
    arrow && <Icon name="arrow-right" size="sm" class="text-link__arrow" />
  }</a
>

<style>
  /* Ink text with a 2px coral underline: coral text on paper is 3.1:1, so
     coral stays the accent and never carries the words. */
  .text-link {
    padding-block: var(--space-1-5);
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration-line: underline;
    text-decoration-color: var(--coral);
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
    border-radius: var(--radius-link);
    transition-property: text-decoration-color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .text-link:hover {
    text-decoration-color: var(--ink);
  }

  .text-link--on-midnight {
    color: var(--on-midnight);
    text-decoration-color: var(--coral-lift);
  }

  .text-link--on-midnight:hover {
    text-decoration-color: var(--on-midnight);
  }

  .text-link--arrow {
    display: inline-flex;
    gap: var(--space-0-75);
    align-items: center;
  }

  .text-link--arrow :global(.text-link__arrow) {
    transition-property: transform;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .text-link:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  .text-link--on-midnight:focus-visible {
    outline-color: var(--coral-lift);
  }

  /* The 12px vertical padding gives a 44px hit area at small widths only. */
  @media (min-width: 48rem) {
    .text-link {
      padding-block: var(--space-0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .text-link--arrow:hover :global(.text-link__arrow) {
      transform: translateX(var(--arrow-shift));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .text-link,
    .text-link--arrow :global(.text-link__arrow) {
      transition-property: none;
    }
  }
</style>
