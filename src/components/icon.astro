---
// The closed icon registry. Every icon is hand-transcribed from the founder's
// wireframes (E11.5-11a): 24-unit stroke drawings at a 1.75 stroke with round
// caps and joins. The star is the §4.2 four-point accent in its own 16 × 24
// box, and `alert` is the E11.5-03 triangle the task pages still use.
type Shape =
  | { tag: 'path'; d: string }
  | { tag: 'circle'; cx: number; cy: number; r: number }
  | {
      tag: 'rect';
      x: number;
      y: number;
      width: number;
      height: number;
      rx: number;
    };

const strokeIcons = {
  check: [{ tag: 'path', d: 'M5 12.5l4.5 4.5L19 7.5' }],
  link: [
    { tag: 'path', d: 'M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1' },
    { tag: 'path', d: 'M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1' },
  ],
  shield: [
    { tag: 'path', d: 'M12 3l7 3v5.5c0 4.5-3 7.8-7 9.5-4-1.7-7-5-7-9.5V6z' },
  ],
  'shield-check': [
    { tag: 'path', d: 'M12 3l7 3v5.5c0 4.5-3 7.8-7 9.5-4-1.7-7-5-7-9.5V6z' },
    { tag: 'path', d: 'M9 12l2 2 4-4' },
  ],
  mail: [
    { tag: 'rect', x: 3, y: 5, width: 18, height: 14, rx: 2 },
    { tag: 'path', d: 'M3.5 7l8.5 6 8.5-6' },
  ],
  'check-circle': [
    { tag: 'circle', cx: 12, cy: 12, r: 9 },
    { tag: 'path', d: 'M8 12.5l3 3 5-6' },
  ],
  'upload-share': [
    { tag: 'path', d: 'M4 13v6a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-6' },
    { tag: 'path', d: 'M12 15V4M7.5 8.5L12 4l4.5 4.5' },
  ],
  building: [
    { tag: 'path', d: 'M3 21h18' },
    {
      tag: 'path',
      d: 'M6 21V4.5A1.5 1.5 0 0 1 7.5 3h9A1.5 1.5 0 0 1 18 4.5V21',
    },
    { tag: 'path', d: 'M14 12.5v.01' },
  ],
  office: [
    { tag: 'path', d: 'M3 21h18' },
    { tag: 'path', d: 'M5 21V5l8-2v18' },
    { tag: 'path', d: 'M13 8l6 2v11' },
    { tag: 'path', d: 'M8.5 8v.01M8.5 12v.01M8.5 16v.01M16 13v.01M16 17v.01' },
  ],
  people: [
    { tag: 'circle', cx: 9, cy: 8, r: 3.5 },
    { tag: 'path', d: 'M2.5 20a6.5 6.5 0 0 1 13 0' },
    { tag: 'path', d: 'M16 4.6a3.5 3.5 0 0 1 0 6.8' },
    { tag: 'path', d: 'M18 14.2a6.5 6.5 0 0 1 3.5 5.8' },
  ],
  person: [
    { tag: 'circle', cx: 12, cy: 8, r: 4 },
    { tag: 'path', d: 'M4 21a8 8 0 0 1 16 0' },
  ],
  gift: [
    { tag: 'rect', x: 3, y: 8, width: 18, height: 5, rx: 1 },
    { tag: 'path', d: 'M5 13v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7' },
    { tag: 'path', d: 'M12 8v13' },
    {
      tag: 'path',
      d: 'M12 8H8.5a2.5 2.5 0 1 1 0-5C11 3 12 8 12 8zM12 8h3.5a2.5 2.5 0 1 0 0-5C13 3 12 8 12 8z',
    },
  ],
  clock: [
    { tag: 'circle', cx: 12, cy: 12, r: 9 },
    { tag: 'path', d: 'M12 7v5l3 2' },
  ],
  'arrow-right': [{ tag: 'path', d: 'M5 12h14M13 6l6 6-6 6' }],
  'arrow-up': [{ tag: 'path', d: 'M12 19V5M6 11l6-6 6 6' }],
  'chevron-down': [{ tag: 'path', d: 'M6 9l6 6 6-6' }],
  'search-check': [
    { tag: 'circle', cx: 11, cy: 11, r: 7 },
    { tag: 'path', d: 'M20 20l-4-4' },
    { tag: 'path', d: 'M8 11l2 2 4-4' },
  ],
  moon: [
    { tag: 'path', d: 'M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z' },
  ],
  sun: [
    { tag: 'circle', cx: 12, cy: 12, r: 4 },
    {
      tag: 'path',
      d: 'M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4',
    },
  ],
  info: [
    { tag: 'circle', cx: 12, cy: 12, r: 9 },
    { tag: 'path', d: 'M12 11v5.5' },
    { tag: 'path', d: 'M12 7.5v.5' },
  ],
  'alert-circle': [
    { tag: 'circle', cx: 12, cy: 12, r: 9 },
    { tag: 'path', d: 'M12 7.5v5' },
    { tag: 'path', d: 'M12 16v.5' },
  ],
  refresh: [
    { tag: 'path', d: 'M20 12a8 8 0 1 1-2.34-5.66' },
    { tag: 'path', d: 'M20 4v5h-5' },
  ],
  pause: [
    { tag: 'rect', x: 6.5, y: 5, width: 3.5, height: 14, rx: 1 },
    { tag: 'rect', x: 14, y: 5, width: 3.5, height: 14, rx: 1 },
  ],
} as const satisfies Record<string, readonly Shape[]>;

export type IconName = keyof typeof strokeIcons | 'star' | 'alert';
export type IconSize = 'sm' | 'base' | 'md' | 'lg';

interface Props {
  name: IconName;
  size?: IconSize;
  label?: string;
  class?: string;
}

const { name, size = 'md', label, class: className } = Astro.props;
const isStar = name === 'star';
// The star is drawn only at its two wireframe sizes: 12 × 18 and 16 × 24.
if (isStar && size !== 'sm' && size !== 'md') {
  throw new Error('The star renders only at the sm or md size.');
}
const shapes: readonly Shape[] =
  name === 'star' || name === 'alert' ? [] : strokeIcons[name];
const stroke = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.75',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
} as const;
---

<svg
  class:list={[
    'icon',
    `icon--${size}`,
    isStar && 'icon--star',
    `icon--${name}`,
    className,
  ]}
  viewBox={isStar ? '0 0 16 24' : '0 0 24 24'}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden={label ? undefined : 'true'}
  aria-label={label}
  role={label ? 'img' : undefined}
  focusable="false"
>
  {
    isStar && (
      <path
        d="M8 0Q9 11 16 12Q9 13 8 24Q7 13 0 12Q7 11 8 0Z"
        fill="currentColor"
      />
    )
  }
  {
    name === 'alert' && (
      <path
        d="M12 3 22 20H2L12 3Zm0 6.5v5m0 2.5v.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
  {
    shapes.map((shape) => {
      if (shape.tag === 'path') return <path d={shape.d} {...stroke} />;
      if (shape.tag === 'circle')
        return <circle cx={shape.cx} cy={shape.cy} r={shape.r} {...stroke} />;
      return (
        <rect
          x={shape.x}
          y={shape.y}
          width={shape.width}
          height={shape.height}
          rx={shape.rx}
          {...stroke}
        />
      );
    })
  }
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    inline-size: var(--icon-md);
    block-size: var(--icon-md);
    color: inherit;
  }

  .icon--sm {
    inline-size: var(--icon-sm);
    block-size: var(--icon-sm);
  }
  .icon--base {
    inline-size: var(--icon-base);
    block-size: var(--icon-base);
  }
  .icon--lg {
    inline-size: var(--icon-lg);
    block-size: var(--icon-lg);
  }

  /* The star keeps its 2:3 box: 12 × 18 at sm and 16 × 24 at md. */
  .icon--star.icon--sm {
    inline-size: var(--star-sm);
    block-size: auto;
    aspect-ratio: 2 / 3;
  }
  .icon--star.icon--md {
    inline-size: var(--star-md);
    block-size: auto;
    aspect-ratio: 2 / 3;
  }
</style>
