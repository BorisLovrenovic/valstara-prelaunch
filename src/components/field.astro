---
import type { HTMLAttributes } from 'astro/types';
import Icon from './icon.astro';

type Props = HTMLAttributes<'div'> & {
  controlId: string;
  description?: string;
  descriptionId?: string;
  error?: string;
  errorId?: string;
  label: string;
};

const {
  class: className,
  controlId,
  description,
  descriptionId,
  error,
  errorId,
  label,
  ...attributes
} = Astro.props;

if (description !== undefined && descriptionId === undefined) {
  throw new Error('Field requires descriptionId when description is set.');
}

if (error !== undefined && errorId === undefined) {
  throw new Error('Field requires errorId when error is set.');
}
---

<div {...attributes} class:list={['field', className]}>
  <div class="field__head">
    <label class="field__label" for={controlId}>{label}</label>
    {
      description !== undefined && (
        <span class="field__description" id={descriptionId}>
          {description}
        </span>
      )
    }
  </div>
  <slot />
  {
    error !== undefined && (
      <div class="field__error-row">
        <Icon name="alert-circle" size="base" class="field__error-icon" />
        <span class="field__error" id={errorId} role="alert" aria-atomic="true">
          {error}
        </span>
      </div>
    )
  }
</div>

<style>
  /* Label, then the hint 4px below it (the hint sits between label and field,
     so an error sits directly under the field), then the field and its error
     8px apart. */
  .field {
    display: grid;
    gap: var(--space-1);
    color: var(--ink);
    font-family: var(--font-sans);
  }

  .field__head {
    display: grid;
    gap: var(--space-0-5);
  }

  .field__label {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-1);
  }

  .field__description,
  .field__error {
    font-size: var(--step-1);
    line-height: var(--leading-1);
  }

  .field__description {
    color: var(--ink-600);
  }

  .field__error-row {
    display: flex;
    gap: var(--space-1);
    align-items: flex-start;
  }

  .field__error-row :global(.field__error-icon) {
    color: var(--error);
  }

  /* Dark error text is ink: --error on midnight surface is 3.2:1. */
  .field__error {
    color: var(--error-text);
    font-weight: var(--weight-semibold);
  }
</style>
