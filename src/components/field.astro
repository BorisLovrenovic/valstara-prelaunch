---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & {
  controlId: string;
  description?: string;
  descriptionId?: string;
  error?: string;
  errorId?: string;
  label: string;
};

const {
  class: className,
  controlId,
  description,
  descriptionId,
  error,
  errorId,
  label,
  ...attributes
} = Astro.props;

if (description !== undefined && descriptionId === undefined) {
  throw new Error('Field requires descriptionId when description is set.');
}

if (error !== undefined && errorId === undefined) {
  throw new Error('Field requires errorId when error is set.');
}
---

<div {...attributes} class:list={['field', className]}>
  <label class="field__label" for={controlId}>{label}</label>
  {
    description !== undefined && (
      <span class="field__description" id={descriptionId}>
        {description}
      </span>
    )
  }
  <slot />
  {
    error !== undefined && (
      <span class="field__error" id={errorId} role="alert" aria-atomic="true">
        {error}
      </span>
    )
  }
</div>

<style>
  .field {
    display: grid;
    gap: var(--space-1);
    color: var(--ink);
    font-family: var(--font-sans);
  }

  .field__label {
    font-size: var(--step-0);
    line-height: var(--leading-0);
  }

  .field__description,
  .field__error {
    font-size: var(--step-1);
    line-height: var(--leading-1);
  }

  .field__description {
    color: var(--ink-600);
  }

  .field__error {
    padding-inline-start: var(--space-1);
    color: var(--ink);
    border-inline-start: medium solid var(--error);
  }
</style>
