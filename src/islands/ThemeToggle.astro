---
import Icon from '../components/icon.astro';
import { themeToggleCopy } from '../copy/theme-toggle.ts';
---

<valstara-theme-toggle>
  <button type="button" aria-pressed="false" disabled>
    <Icon
      name="moon"
      size="base"
      class="theme-toggle__icon theme-toggle__icon--moon"
    />
    <Icon
      name="sun"
      size="base"
      class="theme-toggle__icon theme-toggle__icon--sun"
    />
    <span class="theme-toggle__label" data-theme-toggle-label
      >{themeToggleCopy.useDark}</span
    >
  </button>
  <span aria-atomic="true" aria-live="polite" data-theme-toggle-status></span>
</valstara-theme-toggle>

<script>
  import { themeToggleCopy } from '../copy/theme-toggle.ts';
  import {
    readThemePreference,
    resolveTheme,
    writeThemePreference,
    type Theme,
  } from './theme-toggle.ts';

  class ValstaraThemeToggle extends HTMLElement {
    readonly #mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
    readonly #systemThemeChanged = (): void => {
      if (readThemePreference() === null) {
        this.#render(resolveTheme(null, this.#mediaQuery.matches));
      }
    };

    connectedCallback(): void {
      const button = this.querySelector('button');
      if (!(button instanceof HTMLButtonElement)) {
        return;
      }

      this.#render(
        resolveTheme(readThemePreference(), this.#mediaQuery.matches),
      );
      button.disabled = false;
      button.addEventListener('click', this.#toggle);
      this.#mediaQuery.addEventListener('change', this.#systemThemeChanged);
    }

    disconnectedCallback(): void {
      const button = this.querySelector('button');
      button?.removeEventListener('click', this.#toggle);
      this.#mediaQuery.removeEventListener('change', this.#systemThemeChanged);
    }

    readonly #toggle = (): void => {
      const currentTheme = resolveTheme(
        readThemePreference(),
        this.#mediaQuery.matches,
      );
      const nextTheme: Theme = currentTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = nextTheme;
      writeThemePreference(nextTheme);
      this.#render(nextTheme, true);
    };

    #render(theme: Theme, announce = false): void {
      const isDark = theme === 'dark';
      const button = this.querySelector('button');
      const label = this.querySelector('[data-theme-toggle-label]');
      const status = this.querySelector('[data-theme-toggle-status]');

      button?.setAttribute('aria-pressed', String(isDark));
      if (label !== null) {
        label.textContent = isDark
          ? themeToggleCopy.useLight
          : themeToggleCopy.useDark;
      }
      if (announce && status !== null) {
        status.textContent = isDark
          ? themeToggleCopy.darkSelected
          : themeToggleCopy.lightSelected;
      }
    }
  }

  if (!customElements.get('valstara-theme-toggle')) {
    customElements.define('valstara-theme-toggle', ValstaraThemeToggle);
  }
</script>

<style>
  :global(html),
  :global(body) {
    background-color: var(--paper);
    color: var(--ink);
  }

  :global(html) {
    color-scheme: light;
  }

  :global(html[data-theme='dark']) {
    color-scheme: dark;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) {
      color-scheme: dark;
    }
  }

  valstara-theme-toggle {
    position: relative;
    display: flex;
    align-items: center;
    font-family: var(--font-sans);
  }

  /* An icon button: the moon offers dark, the sun offers light. The label
     stays in the accessible name and the status is still announced. */
  button {
    position: relative;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--tap-min);
    block-size: var(--tap-min);
    padding: 0;
    color: var(--ink);
    font: inherit;
    background-color: var(--surface);
    border: var(--border-thin) solid var(--line);
    border-radius: var(--radius-control);
    cursor: pointer;
    transition-property: border-color, box-shadow;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  button:hover {
    border-color: var(--coral);
    box-shadow: var(--shadow-1);
  }

  button:active {
    box-shadow: none;
  }

  button:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  button:disabled {
    color: var(--ink-600);
    cursor: not-allowed;
    box-shadow: none;
  }

  button :global(.theme-toggle__icon--sun),
  button[aria-pressed='true'] :global(.theme-toggle__icon--moon) {
    display: none;
  }

  button[aria-pressed='true'] :global(.theme-toggle__icon--sun) {
    display: inline-block;
  }

  /* Visually hidden, anchored to the right edge so the hidden text never
     extends the page's scrollable area. */
  .theme-toggle__label,
  [data-theme-toggle-status] {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    overflow: hidden;
    white-space: nowrap;
    clip-path: inset(50%);
  }

  [data-theme-toggle-status] {
    font-size: var(--step-1);
    line-height: var(--leading-1);
  }

  @media (prefers-reduced-motion: reduce) {
    button {
      transition-property: none;
    }
  }
</style>
