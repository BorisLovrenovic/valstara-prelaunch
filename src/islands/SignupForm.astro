  html[data-signup-dock='visible'] body {
    padding-block-end: var(--signup-dock-height);
  }

  valstara-signup-form {
    display: block;
  }

  /*
    `:not([hidden])` so an author `display` never wins over the `hidden`
    attribute: author rules beat the UA `[hidden] { display: none }` by origin,
    so a bare `form { display: grid }` would keep a `form.hidden = true` form
    visible. The island hides the form this way once a signup succeeds.
  */
  /*
    The hero form from the wireframes (E11.5-11c). Small: the field, then a
    full-width button 12px below it. From 48rem the field and the button share
    one row, 8px apart. The Field's wrapper steps aside (display: contents) so
    its label and hint span the row above. Under the row: the microline 12px
    below, the Turnstile slot 12px below that only while it holds the widget,
    the trust facts 20px below (16px small) and the marketing box 24px below
    (20px small). Rows that hold only hidden elements collapse to nothing.
  */
  valstara-signup-form form:not([hidden]) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'notice'
      'head'
      'field'
      'error'
      'submit'
      'micro'
      'check'
      'alert'
      'status'
      'facts'
      'consent';
