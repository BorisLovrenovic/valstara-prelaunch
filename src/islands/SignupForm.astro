---
import Button from '../components/button.astro';
import Checkbox from '../components/checkbox.astro';
import Field from '../components/field.astro';
import Icon from '../components/icon.astro';
import Input from '../components/input.astro';
import TextLink from '../components/text-link.astro';
import { landingCopy } from '../copy/landing.ts';
import { signupFormCopy } from '../copy/signup.ts';
import { getConfig } from '../server/config.ts';

interface Props {
  signedReferralCapture: string | null;
  giveawayEnabled: boolean;
}

const { signedReferralCapture, giveawayEnabled } = Astro.props;

// The public Turnstile site key is rendered into the page so the widget can
// mount client-side (ADR-006). It is public, not a secret — a temporary
// placeholder today, swapped for the provisioned key in E12-05.
const turnstileSiteKey = getConfig().turnstileSiteKey;
---

<valstara-signup-form data-sitekey={turnstileSiteKey}>
  {
    /*
    The form states from StatesDesktop.dc.html and StatesPhone.dc.html
    (E11.5-11g). Without JavaScript, the neutral notice sits above the form
    card, which stays visible 16px below it (Hero.dc.html, moved here by
    E11.5-11l). A form-level message is the error notice above the label,
    16px above it, focused when it appears. Each message sits in its own
    [data-message] span beside a decorative icon, so the element's text is
    exactly the message.

    The form is the hero's card (E11.5-11l). The card enters at index 3 and
    only rises, so its field and button are usable from first paint; the
    microline, trust facts and checkbox row inside it only fade, so they
    travel exactly the card's distance. The entrance sits on a wrapper that
    holds exactly the card, so the form element keeps the bare
    `<form action="/api/signup" method="post">` the E1-11 contract asserts.
  */
  }
  <noscript>
    <p class="signup-notice signup-notice--info">
      <Icon name="info" size="base" /><span
        >{signupFormCopy.javaScriptRequired}</span
      >
    </p>
  </noscript>
  <div class="signup-entry" data-enter="shift" style="--enter-index: 3">
    <form action="/api/signup" method="post">
      <p
        class="signup-notice signup-notice--error"
        data-form-error
        role="alert"
        aria-atomic="true"
        tabindex="-1"
        hidden
      >
        <Icon name="alert-circle" size="base" /><span data-message></span>
      </p>
      <Field
        controlId="signup-email"
        description={landingCopy.form.hint}
        descriptionId="signup-email-hint"
        label={landingCopy.form.label}
      >
        <Input
          id="signup-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder={landingCopy.form.placeholder}
          aria-describedby="signup-email-hint signup-email-error"
        />
      </Field>
      <p
        class="signup-field-error"
        id="signup-email-error"
        data-error-for="email"
        role="alert"
        aria-atomic="true"
        hidden
      >
        <Icon name="alert-circle" size="base" /><span data-message></span>
      </p>

      {
        /*
      The wireframe order (E11.5-11c): the field and the button in one row,
      the 18+ microline beside the button, the Turnstile slot under the
      microline, then the trust facts and the optional marketing box.
    */
      }
      <Button type="submit" data-submit
        ><span class="button__spinner" data-spinner aria-hidden="true" hidden
        ></span><span data-submit-label>{landingCopy.form.submit}</span></Button
      >
      <p class="signup-age" data-enter="fade" style="--enter-index: 3">
        {signupFormCopy.ageStatement}{
          giveawayEnabled && (
            <>
              {' '}
              {signupFormCopy.freeEntryDisclosure}{' '}
              <TextLink href="/giveaway/rules">
                {signupFormCopy.giveawayRulesLink}
              </TextLink>
              {signupFormCopy.giveawayRulesLinkEnd}
            </>
          )
        }
      </p>
      <div class="signup-turnstile" data-turnstile-container></div>

      {
        /*
      The in-flight announcement. The button's spinner and label show the
      wait on screen, so this line is read by assistive technology only.
    */
      }
      <p
        class="signup-status"
        data-form-status
        role="status"
        aria-live="polite"
        hidden
      >
      </p>

      {
        /*
      The facts wrapper renders only with its slot filled, so its divider
      never draws over an empty slot and no :has() support is needed.
    */
      }
      {
        Astro.slots.has('facts') && (
          <div class="signup-facts" data-enter="fade" style="--enter-index: 3">
            <slot name="facts" />
          </div>
        )
      }
      <div class="signup-consent" data-enter="fade" style="--enter-index: 3">
        <Checkbox
          id="signup-marketing"
          class="signup-marketing"
          name="marketing_opt_in"
          value={signupFormCopy.marketing.version}
          optional
        >
          {signupFormCopy.marketing.wording}
        </Checkbox>
      </div>

      {
        /*
      The signed ref (E4-02) rides through as a hidden field the server renders;
      the island never reads or writes it — it simply posts the whole form, so
      whatever hidden fields exist are carried through unchanged.
    */
      }
      {
        signedReferralCapture !== null && (
          <input
            name="referral_capture"
            type="hidden"
            value={signedReferralCapture}
          />
        )
      }
      <input name="turnstile_token" type="hidden" />
    </form>
  </div>

  {
    /*
    The success panel replaces the form (Hero.dc.html, E11.5-11m). It is
    identical for every address: the echoed address is the visitor's own
    input, and it never says an email was sent or shows a position or count.
    The tile and the heading share a row; the echo carries its own mail icon;
    the re-sent line sits above the actions, and its check-circle marks only
    the resend route's acknowledgement.
  */
  }
  <section
    class="signup-success"
    data-success
    role="status"
    aria-live="polite"
    tabindex="-1"
    hidden
  >
    <div class="signup-success__head">
      <span class="signup-success__tile"><Icon name="mail" size="md" /></span>
      <h2>{signupFormCopy.successHeading}</h2>
    </div>
    <p class="signup-success__address" data-success-address>
      <Icon name="mail" size="sm" /><span data-address></span>
    </p>
    <p class="signup-success__step">{signupFormCopy.successStep}</p>
    <p
      class="signup-success__resent"
      data-resend-status
      role="status"
      aria-live="polite"
      hidden
    >
      <Icon name="check-circle" size="sm" /><span data-message></span>
    </p>
    <div class="signup-success__actions">
      <Button type="button" data-different-address variant="secondary">
        {signupFormCopy.differentAddress}
      </Button>
      <Button type="button" data-resend variant="secondary" hidden>
        <Icon name="refresh" size="sm" />{signupFormCopy.resendLink}
      </Button>
    </div>
  </section>

  {
    /*
    The mobile sticky bar from Sticky.dc.html (E11.5-11h, E11.5-11m): the
    label, the field and Join in one row (each on its own row while a
    submission is in flight), the field error under the row, and the 18+
    microline. A bar submission is the hero form's submission; only the hero
    input is named `email`. Success collapses the bar to one status row.
  */
  }
  <section
    class="signup-dock"
    data-dock
    role="region"
    aria-label={signupFormCopy.barLabel}
    hidden
  >
    <div class="signup-dock__entry" data-dock-entry>
      <label class="signup-dock__label" for="signup-dock-email"
        >{signupFormCopy.barEmailLabel}</label
      >
      <div class="signup-dock__row" data-dock-row>
        <Input
          id="signup-dock-email"
          type="email"
          autocomplete="email"
          placeholder={landingCopy.form.placeholder}
          aria-describedby="signup-dock-error"
        />
        <Button type="button" data-dock-submit
          ><span
            class="button__spinner"
            data-dock-spinner
            aria-hidden="true"
            hidden></span><span data-dock-submit-label
            >{landingCopy.form.submit}</span
          ></Button
        >
      </div>
      <p
        id="signup-dock-error"
        class="signup-field-error signup-dock__error"
        data-dock-error
        role="alert"
        aria-atomic="true"
        hidden
      >
        <Icon name="alert-circle" size="base" /><span data-message></span>
      </p>
      <p class="signup-age">
        {signupFormCopy.ageStatement}{
          giveawayEnabled && (
            <>
              {' '}
              {signupFormCopy.freeEntryDisclosure}{' '}
              <TextLink href="/giveaway/rules">
                {signupFormCopy.giveawayRulesLink}
              </TextLink>
              {signupFormCopy.giveawayRulesLinkEnd}
            </>
          )
        }
      </p>
    </div>
    <div
      class="signup-dock__done"
      data-dock-confirmation
      role="status"
      aria-live="polite"
      hidden
    >
      <p>
        <Icon name="check-circle" size="base" />{signupFormCopy.barConfirmation}
      </p>
      <Button type="button" data-dock-close variant="secondary"
        >{signupFormCopy.barClose}</Button
      >
    </div>
  </section>
</valstara-signup-form>

{
  /*
  Cloudflare Turnstile's client widget. This is the sole sanctioned off-origin
  rendered-page request: the
  stated Article 5(3) basis for Cloudflare's cf.turnstile.u access is the
  strictly necessary form-security exemption; legal review was waived by the
  founder in ADR-030.
  Cloudflare's IP/TLS/UA security processing is disclosed separately. It is
  allowlisted in the third-party gate for
  this exact file (Option A, founder-authorised 2026-09-08; ADR-006, ADR-007,
  compliance §3). Loaded with explicit rendering so it does nothing until the
  island renders it lazily on first interaction, keeping the initial page inert.
*/
}
<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
  async
  defer></script>

<script>
  import {
    collectClientErrors,
    resendDelayMs,
    serverErrorField,
    type SignupClientError,
    type SignupFieldName,
  } from './signup-form.ts';
  import { signupFormCopy } from '../copy/signup.ts';

  interface TurnstileApi {
    render(
      element: HTMLElement,
      options: Record<string, unknown>,
    ): string | undefined;
    reset(widgetId?: string): void;
  }

  declare global {
    interface Window {
      turnstile?: TurnstileApi;
    }
  }

  class ValstaraSignupForm extends HTMLElement {
    #form: HTMLFormElement | null = null;
    #submit: HTMLButtonElement | null = null;
    #submitLabel: HTMLElement | null = null;
    #spinner: HTMLElement | null = null;
    #tokenInput: HTMLInputElement | null = null;
    #turnstileContainer: HTMLElement | null = null;
    #widgetId: string | undefined;
    #challengePromise: Promise<string> | null = null;
    #resolveChallenge: ((token: string) => void) | null = null;
    #rejectChallenge: ((error: Error) => void) | null = null;
    #inFlight = false;
    #dock: HTMLElement | null = null;
    #dockInput: HTMLInputElement | null = null;
    #dockResize: ResizeObserver | null = null;
    #entryPoint: 'hero' | 'dock' = 'hero';
    #signedUpEmail = '';
    #succeeded = false;
    // A bar submission's confirmation stays in the bar until it is closed.
    #dockConfirming = false;
    #resendTimer: number | undefined;
    #idleLabel = '';
    // True while the form and the success panel swap places (E11.5-11m).
    #swapping = false;

    connectedCallback(): void {
      const form = this.querySelector('form');
      if (!(form instanceof HTMLFormElement)) {
        return;
      }
      this.#form = form;
      this.#submit = form.querySelector('[data-submit]');
      this.#submitLabel = form.querySelector('[data-submit-label]');
      this.#spinner = form.querySelector('[data-spinner]');
      this.#idleLabel = this.#submitLabel?.textContent?.trim() ?? '';
      this.#tokenInput = form.querySelector('input[name="turnstile_token"]');
      this.#turnstileContainer = form.querySelector(
        '[data-turnstile-container]',
      );
      this.#dock = this.querySelector('[data-dock]');
      this.#dockInput = this.querySelector('#signup-dock-email');
      document.querySelectorAll('[data-focus-signup]').forEach((link) => {
        link.addEventListener('click', () => {
          // With smooth anchor scrolling (motion.css), focus moves once the
          // scroll ends, so it lands on a field already in view. Without a
          // scroll, or without scrollend support, it moves as before.
          const focusEmail = (): void => {
            this.querySelector<HTMLInputElement>('#signup-email')?.focus({
              preventScroll: true,
            });
          };
          if (
            !('onscrollend' in window) ||
            getComputedStyle(document.documentElement).scrollBehavior !==
              'smooth'
          ) {
            requestAnimationFrame(focusEmail);
            return;
          }
          // Scroll events still queued from an earlier scroll are dispatched
          // before the next frame's callbacks, so listening starts there.
          requestAnimationFrame(() => {
            let scrolled = false;
            const markScrolled = (): void => {
              scrolled = true;
            };
            const finish = (): void => {
              removeEventListener('scroll', markScrolled);
              removeEventListener('scrollend', finish);
              focusEmail();
            };
            addEventListener('scroll', markScrolled, { passive: true });
            addEventListener('scrollend', finish);
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                if (!scrolled) finish();
              });
            });
          });
        });
      });

      // With the island active, custom validation governs; native constraint
      // validation would otherwise pop its own UI before the submit handler
      // runs. With JavaScript disabled the server-rendered form remains visible
      // with the explicit enable-JavaScript notice.
      form.noValidate = true;

      form.addEventListener('submit', this.#onSubmit);
      this.#submit?.addEventListener('click', () => {
        if (!this.#inFlight) this.#entryPoint = 'hero';
      });
      this.querySelector('#signup-email')?.addEventListener(
        'input',
        this.#mirrorHero,
      );
      this.#dockInput?.addEventListener('input', this.#mirrorDock);
      this.#dockInput?.addEventListener('input', this.#startTurnstile, {
        once: true,
      });
      const dockSubmit = this.querySelector('[data-dock-submit]');
      dockSubmit?.addEventListener('mousedown', (event) =>
        event.preventDefault(),
      );
      dockSubmit?.addEventListener('click', this.#submitDock);
      this.querySelector('[data-different-address]')?.addEventListener(
        'click',
        this.#differentAddress,
      );
      this.querySelector('[data-resend]')?.addEventListener(
        'click',
        this.#resend,
      );
      this.querySelector('[data-dock-close]')?.addEventListener(
        'click',
        this.#closeDock,
      );
      window.addEventListener('scroll', this.#updateDock, { passive: true });
      window.addEventListener('resize', this.#updateDock);
      document.addEventListener('focusin', this.#protectFocus);
      this.addEventListener('focusin', this.#endEntrance);
      this.#endEntrance();
      // The bar grows upward with an error and collapses on success, so the
      // reserved space follows its measured height while it shows.
      if (this.#dock !== null && 'ResizeObserver' in window) {
        this.#dockResize = new ResizeObserver(() => {
          if (this.#dock?.hidden === false) this.#reserveDock(true);
        });
        this.#dockResize.observe(this.#dock);
      }
      this.#updateDock();
      // A real visitor types their address first, so the invisible challenge is
      // already resolving by the time they submit. Rendering lazily (never on
      // page load) keeps the initial page free of any widget frame or shift.
      this.querySelector('#signup-email')?.addEventListener(
        'input',
        this.#startTurnstile,
        { once: true },
      );
    }

    disconnectedCallback(): void {
      this.#form?.removeEventListener('submit', this.#onSubmit);
      window.removeEventListener('scroll', this.#updateDock);
      window.removeEventListener('resize', this.#updateDock);
      document.removeEventListener('focusin', this.#protectFocus);
      this.removeEventListener('focusin', this.#endEntrance);
      this.#dockResize?.disconnect();
      window.clearTimeout(this.#resendTimer);
      this.#reserveDock(false);
    }

    // Focus ends the entrance of each element it enters (motion.css), but
    // only while it stays: if focus leaves before the entrance would have
    // ended, the browser resumes it, and the card drops back to rise again.
    // Removing data-enter from each element focus enters makes the end stick.
    // Run once on connect too, for focus that arrived before the island did.
    readonly #endEntrance = (event?: Event): void => {
      const focused = event?.target ?? document.activeElement;
      let entering =
        focused instanceof Element && this.contains(focused)
          ? focused.closest('[data-enter]')
          : null;
      while (entering !== null && this.contains(entering)) {
        entering.removeAttribute('data-enter');
        entering = entering.parentElement?.closest('[data-enter]') ?? null;
      }
    };

    readonly #mirrorHero = (): void => {
      const hero = this.querySelector<HTMLInputElement>('#signup-email');
      if (hero !== null && this.#dockInput !== null)
        this.#dockInput.value = hero.value;
    };

    readonly #mirrorDock = (): void => {
      const hero = this.querySelector<HTMLInputElement>('#signup-email');
      if (hero !== null && this.#dockInput !== null)
        hero.value = this.#dockInput.value;
    };

    readonly #submitDock = (): void => {
      if (this.#inFlight || this.#form === null) return;
      this.#entryPoint = 'dock';
      this.#mirrorDock();
      this.#form.dispatchEvent(
        new SubmitEvent('submit', { bubbles: true, cancelable: true }),
      );
    };

    // The bar shows at small widths only (below 48rem), once the hero form
    // has left the viewport and while the footer has not entered it. After a
    // signup only a bar submission's confirmation shows, by the same rules;
    // after a hero submission the bar stays hidden.
    readonly #updateDock = (): void => {
      if (this.#dock === null || this.#form === null) return;
      const small = !window.matchMedia('(min-width: 48rem)').matches;
      const hero = this.#form.hidden
        ? this.querySelector<HTMLElement>('[data-success]')
        : this.#form;
      const footer = document.querySelector('body > footer');
      const heroOut = (hero?.getBoundingClientRect().bottom ?? 0) <= 0;
      const footerIn =
        footer !== null &&
        footer.getBoundingClientRect().top < window.innerHeight;
      const visible =
        small &&
        heroOut &&
        !footerIn &&
        (!this.#succeeded || this.#dockConfirming);
      if (visible && this.#dock.hidden && !this.#succeeded) this.#mirrorHero();
      if (!visible) this.#releaseDockFocus();
      this.#dock.hidden = !visible;
      this.#reserveDock(visible);
    };

    #reserveDock(visible: boolean): void {
      if (visible && this.#dock !== null) {
        document.documentElement.style.setProperty(
          '--signup-dock-height',
          `${this.#dock.getBoundingClientRect().height}px`,
        );
        document.documentElement.dataset.signupDock = 'visible';
      } else {
        document.documentElement.style.removeProperty('--signup-dock-height');
        delete document.documentElement.dataset.signupDock;
      }
    }

    readonly #closeDock = (): void => {
      this.#dockConfirming = false;
      this.#releaseDockFocus();
      if (this.#dock !== null) this.#dock.hidden = true;
      this.#reserveDock(false);
    };

    // Focus inside the bar's confirmation would drop to the page when the bar
    // closes or hides, so it moves to the hero's confirmation, without
    // scrolling there.
    #releaseDockFocus(): void {
      if (
        !this.#succeeded ||
        this.#dock === null ||
        this.#dock.hidden ||
        !this.#dock.contains(document.activeElement)
      )
        return;
      this.querySelector<HTMLElement>('[data-success]')?.focus({
        preventScroll: true,
      });
    }

    // The page's scroll padding is the bar's height plus the clearance, so a
    // focused element lands clear of the bar. Where the browser has not
    // scrolled it there, this lifts it by the shortfall. Reading the padding
    // rather than the bar's box keeps the slide-in from skewing it.
    readonly #protectFocus = (): void => {
      window.requestAnimationFrame(() => {
        const focused = document.activeElement;
        if (
          !(focused instanceof HTMLElement) ||
          this.#dock?.hidden !== false ||
          this.#dock.contains(focused)
        )
          return;
        const padding = Number.parseFloat(
          getComputedStyle(document.documentElement).scrollPaddingBottom,
        );
        if (!Number.isFinite(padding)) return;
        const target = focused.getBoundingClientRect();
        const limit = window.innerHeight - padding;
        if (target.bottom > limit && target.top < window.innerHeight) {
          window.scrollBy(0, Math.ceil(target.bottom - limit));
        }
      });
    };

    readonly #startTurnstile = (): Promise<string> => {
      const existingToken = this.#tokenInput?.value ?? '';
      if (existingToken !== '') {
        return Promise.resolve(existingToken);
      }
      if (this.#challengePromise !== null) {
        return this.#challengePromise;
      }

      this.#challengePromise = new Promise<string>((resolve, reject) => {
        this.#resolveChallenge = resolve;
        this.#rejectChallenge = reject;
      });
      const challengePromise = this.#challengePromise;
      if (this.#widgetId !== undefined) {
        if (window.turnstile === undefined) this.#failChallenge();
        else window.turnstile.reset(this.#widgetId);
        return challengePromise;
      }
      const container = this.#turnstileContainer;
      const sitekey = this.dataset.sitekey;
      if (container === null || sitekey === undefined) {
        this.#failChallenge();
        return challengePromise;
      }

      let attempts = 0;
      const tryRender = (): void => {
        const turnstile = window.turnstile;
        if (turnstile !== undefined) {
          this.#widgetId = turnstile.render(container, {
            sitekey,
            appearance: 'interaction-only',
            // The hidden widget still mounts a child, so the slot is marked
            // open only while Cloudflare shows it; the 12px gap under the
            // microline follows the mark (E11.5-11c).
            'before-interactive-callback': () => {
              container.toggleAttribute('data-open', true);
            },
            'after-interactive-callback': () => {
              container.toggleAttribute('data-open', false);
            },
            callback: (token: string) => {
              if (token !== '' && this.#tokenInput !== null) {
                this.#tokenInput.value = token;
                this.#resolveChallenge?.(token);
                this.#resolveChallenge = null;
                this.#rejectChallenge = null;
              }
            },
            'expired-callback': () => {
              this.#failChallenge();
            },
            'error-callback': () => {
              this.#failChallenge();
              return true;
            },
          });
          return;
        }
        attempts += 1;
        if (attempts <= 100) {
          window.setTimeout(tryRender, 50);
        } else {
          this.#failChallenge();
        }
      };
      tryRender();
      return challengePromise;
    };

    readonly #onSubmit = async (event: SubmitEvent): Promise<void> => {
      event.preventDefault();
      if (this.#inFlight || this.#form === null) {
        return;
      }

      const values = {
        email: this.#fieldValue('#signup-email'),
      };
      const errors = collectClientErrors(values);
      this.#renderFieldErrors(errors);
      if (errors.length > 0) {
        if (this.#entryPoint === 'dock')
          this.#showDockError(errors[0]!.message);
        this.#focusField(errors[0]!.field);
        return;
      }
      this.#clearDockError();
      this.#signedUpEmail = values.email;

      // Make sure the challenge is running even if the visitor never fired an
      // input event (e.g. autofill straight to submit).
      this.#setInFlight(true, signupFormCopy.challengePending);
      try {
        const token = await this.#startTurnstile();
        if (token === '' || this.#tokenInput?.value === '') {
          throw new Error('The security challenge returned no token.');
        }
        await this.#send();
      } catch {
        this.#showFormError(signupFormCopy.challengeUnavailable);
        this.#setInFlight(false);
        this.#signedUpEmail = '';
      }
    };

    async #send(): Promise<void> {
      if (this.#form === null) {
        return;
      }
      this.#setInFlight(true, signupFormCopy.submitting);
      try {
        const response = await fetch('/api/signup', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(this.#form),
        });
        const body: unknown = await response.json().catch(() => null);
        this.#handleResponse(body);
      } catch {
        this.#showFormError(signupFormCopy.connection);
        this.#setInFlight(false);
        this.#signedUpEmail = '';
      }
    }

    #handleResponse(body: unknown): void {
      if (typeof body !== 'object' || body === null) {
        this.#showFormError(signupFormCopy.connection);
        this.#setInFlight(false);
        return;
      }
      const record = body as Record<string, unknown>;

      const status = record.status;
      if (status === 'pending') {
        this.#showSuccess();
        return;
      }
      if (status === 'paused') {
        this.#showFormError(this.#messageOf(record.message));
        this.#setInFlight(false);
        this.#signedUpEmail = '';
        return;
      }

      const error = record.error;
      if (typeof error === 'object' && error !== null) {
        const details = error as Record<string, unknown>;
        const code = typeof details.code === 'string' ? details.code : '';
        const message = this.#messageOf(details.message);
        if (serverErrorField(code) === 'email') {
          this.#showFieldError('email', message);
          this.#focusField('email');
        } else {
          this.#showFormError(message);
        }
        if (code === 'challenge_failed' && this.#widgetId !== undefined) {
          window.turnstile?.reset(this.#widgetId);
          this.#resetChallenge();
        }
        this.#setInFlight(false);
        this.#signedUpEmail = '';
        return;
      }

      this.#showFormError(signupFormCopy.connection);
      this.#setInFlight(false);
      this.#signedUpEmail = '';
    }

    #messageOf(value: unknown): string {
      return typeof value === 'string' && value !== ''
        ? value
        : signupFormCopy.connection;
    }

    #fieldValue(selector: string): string {
      const control = this.querySelector(selector);
      return control instanceof HTMLInputElement ||
        control instanceof HTMLSelectElement
        ? control.value
        : '';
    }

    #setInFlight(
      inFlight: boolean,
      message: string = signupFormCopy.submitting,
    ): void {
      this.#inFlight = inFlight;
      if (this.#submit !== null) this.#submit.disabled = inFlight;
      const label = inFlight ? message : this.#idleLabel;
      this.#submitLabel = this.#setLabel(this.#submitLabel, label);
      // The spinner shows the wait; CSS hides it while the Turnstile widget
      // is open, because then the visitor is the one who must act.
      if (this.#spinner !== null) this.#spinner.hidden = !inFlight;
      const dockSubmit =
        this.querySelector<HTMLButtonElement>('[data-dock-submit]');
      if (dockSubmit !== null) dockSubmit.disabled = inFlight;
      this.#setLabel(
        this.querySelector<HTMLElement>('[data-dock-submit-label]'),
        label,
      );
      // While in flight the bar's field and button each take a full row, so
      // the long in-flight label fits (ChangeLog "Sticky bar · submitting").
      this.querySelector('[data-dock-row]')?.toggleAttribute(
        'data-busy',
        inFlight,
      );
      const dockSpinner = this.querySelector<HTMLElement>(
        '[data-dock-spinner]',
      );
      if (dockSpinner !== null) dockSpinner.hidden = !inFlight;
      const status = this.querySelector<HTMLElement>('[data-form-status]');
      if (status !== null) {
        status.textContent = inFlight ? message : '';
        status.hidden = !inFlight;
      }
    }

    // Runs `then` once the CSS transitions now running on the element (and,
    // with `subtree`, inside it) have ended. With reduced motion none run, so
    // it runs at once, in the same task, exactly as before the motion.
    #whenSettled(element: Element, then: () => void, subtree = false): void {
      const running = element
        .getAnimations({ subtree })
        .filter((animation) => animation instanceof CSSTransition);
      if (running.length === 0) {
        then();
        return;
      }
      void Promise.allSettled(
        running.map((animation) => animation.finished),
      ).then(then);
    }

    // The in-flight label cross-fades as it changes (E11.5-11m): a fresh label
    // element fades in (CSS @starting-style), while the old text fades out as
    // the button's ::after, whose generated text is hidden from assistive
    // technology. So the button's text and accessible name are only ever the
    // current label. Returns the element now holding the label.
    #setLabel(label: HTMLElement | null, text: string): HTMLElement | null {
      if (label === null || label.textContent === text) return label;
      const button = label.closest('button');
      const fresh = label.cloneNode(false) as HTMLElement;
      fresh.textContent = text;
      fresh.toggleAttribute('data-label-entering', true);
      if (button !== null) {
        // Dropping the attribute and reading layout ends any earlier fade, so
        // the ::after starts again from the old label.
        button.removeAttribute('data-previous-label');
        void button.offsetWidth;
        button.setAttribute('data-previous-label', label.textContent ?? '');
      }
      label.replaceWith(fresh);
      this.#whenSettled(fresh, () => {
        fresh.removeAttribute('data-label-entering');
        if (button?.querySelector('[data-label-entering]') === null)
          button.removeAttribute('data-previous-label');
      });
      return fresh;
    }

    #failChallenge(): void {
      if (this.#tokenInput !== null) {
        this.#tokenInput.value = '';
      }
      this.#rejectChallenge?.(new Error('The security challenge failed.'));
      this.#resetChallenge();
    }

    #resetChallenge(): void {
      if (this.#tokenInput !== null) {
        this.#tokenInput.value = '';
      }
      this.#challengePromise = null;
      this.#resolveChallenge = null;
      this.#rejectChallenge = null;
    }

    #renderFieldErrors(errors: readonly SignupClientError[]): void {
      const errored = new Set(errors.map((entry) => entry.field));
      for (const field of ['email'] as const) {
        if (!errored.has(field)) {
          this.#clearFieldError(field);
        }
      }
      for (const error of errors) {
        this.#showFieldError(error.field, error.message);
      }
    }

    #showFieldError(field: SignupFieldName, message: string): void {
      const element = this.querySelector<HTMLElement>(
        `[data-error-for="${field}"]`,
      );
      if (element !== null) {
        this.#setMessage(element, message);
        element.hidden = false;
      }
      this.querySelector(`#signup-${field}`)?.setAttribute(
        'aria-invalid',
        'true',
      );
      if (this.#entryPoint === 'dock') this.#showDockError(message, true);
    }

    #clearFieldError(field: SignupFieldName): void {
      const element = this.querySelector<HTMLElement>(
        `[data-error-for="${field}"]`,
      );
      if (element !== null) {
        this.#setMessage(element, '');
        element.hidden = true;
      }
      this.querySelector(`#signup-${field}`)?.removeAttribute('aria-invalid');
    }

    // A message element holds its text in a [data-message] span beside its
    // decorative icon; one without that span holds the text itself.
    #setMessage(element: HTMLElement, message: string): void {
      (element.querySelector('[data-message]') ?? element).textContent =
        message;
    }

    #showFormError(message: string): void {
      const element = this.querySelector<HTMLElement>('[data-form-error]');
      if (element !== null) {
        this.#setMessage(element, message);
        element.hidden = false;
        if (this.#entryPoint === 'hero') element.focus();
      }
      if (this.#entryPoint === 'dock') this.#showDockError(message);
    }

    #focusField(field: SignupFieldName): void {
      (this.#entryPoint === 'dock'
        ? this.#dockInput
        : this.querySelector<HTMLElement>(`#signup-${field}`)
      )?.focus();
    }

    #showDockError(message: string, emailInvalid = false): void {
      const error = this.querySelector<HTMLElement>('[data-dock-error]');
      if (error !== null) {
        this.#setMessage(error, message);
        error.hidden = false;
      }
      if (emailInvalid) this.#dockInput?.setAttribute('aria-invalid', 'true');
      this.#reserveDock(!this.#dock?.hidden);
    }

    #clearDockError(): void {
      const error = this.querySelector<HTMLElement>('[data-dock-error]');
      if (error !== null) {
        this.#setMessage(error, '');
        error.hidden = true;
      }
      this.#dockInput?.removeAttribute('aria-invalid');
    }

    // Form to success (E11.5-11m): the form fades out over --duration-fast,
    // then the panel enters over --duration-base. The bar's confirmation and
    // focus are as before: focus moves to the panel the moment it appears, or
    // to the bar's Close. The submission stays in flight until the swap ends,
    // so nothing can be submitted again from the fading form.
    #showSuccess(): void {
      const success = this.querySelector<HTMLElement>('[data-success]');
      const address = this.querySelector<HTMLElement>('[data-address]');
      if (address !== null) {
        // A line break is preferred after the @, as the canvas draws it.
        const at = this.#signedUpEmail.lastIndexOf('@');
        address.replaceChildren(
          ...(at > 0
            ? [
                this.#signedUpEmail.slice(0, at + 1),
                document.createElement('wbr'),
                this.#signedUpEmail.slice(at + 1),
              ]
            : [this.#signedUpEmail]),
        );
      }
      const showConfirmation =
        this.#entryPoint === 'dock' && this.#dock?.hidden === false;
      this.#succeeded = true;
      this.#dockConfirming = showConfirmation;
      if (this.#dock !== null) {
        this.#dock.hidden = !showConfirmation;
        const entry = this.querySelector<HTMLElement>('[data-dock-entry]');
        const confirmation = this.querySelector<HTMLElement>(
          '[data-dock-confirmation]',
        );
        if (entry !== null) entry.hidden = true;
        if (confirmation !== null) confirmation.hidden = !showConfirmation;
        this.#reserveDock(showConfirmation);
      }
      if (showConfirmation)
        this.querySelector<HTMLElement>('[data-dock-close]')?.focus();

      const form = this.#form;
      if (form === null || success === null) return;
      this.#swapping = true;
      form.toggleAttribute('data-leaving', true);
      this.#whenSettled(form, () => {
        form.removeAttribute('data-leaving');
        form.hidden = true;
        // The hero entrance runs once per page load: a form shown again by
        // "Use a different address" must not replay it.
        for (const element of this.querySelectorAll('[data-enter]')) {
          element.removeAttribute('data-enter');
        }
        // The 60 seconds count from the moment the panel appears.
        window.clearTimeout(this.#resendTimer);
        this.#resendTimer = window.setTimeout(() => {
          const resend = this.querySelector<HTMLButtonElement>('[data-resend]');
          if (resend !== null) resend.hidden = false;
        }, resendDelayMs);
        success.hidden = false;
        this.#setInFlight(false);
        this.#swapping = false;
        if (!showConfirmation) success.focus();
        this.#updateDock();
      });
    }

    // "Use a different address" reverses the sequence: the panel leaves over
    // --duration-base, then the form fades back in over --duration-fast with
    // focus in its email field, as before.
    readonly #differentAddress = (): void => {
      const success = this.querySelector<HTMLElement>('[data-success]');
      if (this.#swapping || success === null) return;
      this.#swapping = true;
      window.clearTimeout(this.#resendTimer);
      success.toggleAttribute('data-leaving', true);
      this.#whenSettled(
        success,
        () => {
          success.removeAttribute('data-leaving');
          this.#signedUpEmail = '';
          this.#succeeded = false;
          this.#dockConfirming = false;
          this.#resetChallenge();
          success.hidden = true;
          const resend = this.querySelector<HTMLElement>('[data-resend]');
          if (resend !== null) resend.hidden = true;
          const status = this.querySelector<HTMLElement>(
            '[data-resend-status]',
          );
          if (status !== null) {
            status.hidden = true;
            this.#setMessage(status, '');
          }
          const form = this.#form;
          if (form !== null) {
            form.toggleAttribute('data-returning', true);
            form.hidden = false;
            this.#whenSettled(form, () =>
              form.removeAttribute('data-returning'),
            );
          }
          const email = this.querySelector<HTMLInputElement>('#signup-email');
          if (email !== null) {
            email.value = '';
            email.focus();
          }
          if (this.#dockInput !== null) this.#dockInput.value = '';
          const entry = this.querySelector<HTMLElement>('[data-dock-entry]');
          const confirmation = this.querySelector<HTMLElement>(
            '[data-dock-confirmation]',
          );
          if (entry !== null) entry.hidden = false;
          if (confirmation !== null) confirmation.hidden = true;
          this.#setInFlight(false);
          this.#swapping = false;
          this.#updateDock();
        },
        true,
      );
    };

    readonly #resend = async (): Promise<void> => {
      if (this.#inFlight || this.#form === null) return;
      const status = this.querySelector<HTMLElement>('[data-resend-status]');
      const resend = this.querySelector<HTMLButtonElement>('[data-resend]');
      if (resend !== null) resend.disabled = true;
      this.#resetChallenge();
      try {
        const token = await this.#startTurnstile();
        const body = new FormData();
        body.set('email', this.#signedUpEmail);
        body.set('turnstile_token', token);
        const response = await fetch('/api/resend-verification', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body,
        });
        const result: unknown = await response.json().catch(() => null);
        if (status !== null) {
          const record =
            typeof result === 'object' && result !== null
              ? (result as Record<string, unknown>)
              : {};
          const error =
            typeof record.error === 'object' && record.error !== null
              ? (record.error as Record<string, unknown>)
              : {};
          this.#setMessage(
            status,
            this.#messageOf(record.message ?? error.message),
          );
          // Only the route's acknowledgement carries the check icon.
          status.toggleAttribute(
            'data-acknowledged',
            typeof record.message === 'string',
          );
          status.hidden = false;
        }
      } catch {
        if (status !== null) {
          this.#setMessage(status, signupFormCopy.connection);
          status.toggleAttribute('data-acknowledged', false);
          status.hidden = false;
        }
      } finally {
        if (resend !== null) resend.disabled = false;
        this.#resetChallenge();
      }
    };
  }

  if (!customElements.get('valstara-signup-form')) {
    customElements.define('valstara-signup-form', ValstaraSignupForm);
  }
</script>

{
  /*
    All styles are global and hand-scoped under the custom element. Values are
