---
import Button from '../components/button.astro';
import Field from '../components/field.astro';
import Input from '../components/input.astro';
import TaskCard from '../layouts/task-card.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dsrCopy } from '../copy/dsr.ts';
import { getConfig } from '../server/config.ts';
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const operation =
  Astro.url.searchParams.get('operation') === 'delete' ? 'delete' : 'export';
const token = Astro.url.searchParams.get('t');
const copy = dsrCopy[operation];
---

<BaseLayout title={dsrCopy.title} description={dsrCopy.description}>
  <TaskCard
    heading={copy.heading}
    icon="shield"
    state={`${operation}-${token !== null ? 'confirm' : 'request'}`}
  >
    <p>{copy.body}</p>
    <form method="post" action={`/api/dsr/${operation}`}>
      {
        token !== null ? (
          <input type="hidden" name="token" value={token} />
        ) : (
          <>
            <Field controlId="dsr-email" label={dsrCopy.email}>
              <Input
                id="dsr-email"
                name="email"
                type="email"
                required
                autocomplete="email"
              />
            </Field>
            <div
              class="cf-turnstile"
              data-sitekey={getConfig().turnstileSiteKey}
              data-size="compact"
              data-response-field-name="turnstile_token"
            />
            <noscript>
              <p>{dsrCopy.noJavaScript}</p>
            </noscript>
          </>
        )
      }
      <div class="task-card__actions">
        <Button type="submit"
          >{token !== null ? copy.button : dsrCopy.request}</Button
        >
      </div>
    </form>
    <a class="task-card__link" href="/privacy">{dsrCopy.privacy}</a>
    {
      token === null && (
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      )
    }
  </TaskCard>
</BaseLayout>
