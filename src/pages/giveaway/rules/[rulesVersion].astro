---
import RulesPage from '../../../layouts/giveaway-rules-page.astro';
import { allRulesRevisions } from '../../../server/giveaway/rules-catalog.ts';
import type { RulesRevision } from '../../../server/giveaway/rules.ts';

export const prerender = true;

export function getStaticPaths() {
  return allRulesRevisions().map((revision) => ({
    params: { rulesVersion: revision.rulesVersion },
    props: { revision },
  }));
}

interface Props {
  revision: RulesRevision;
}

const { revision } = Astro.props;
---

<RulesPage revision={revision} />
