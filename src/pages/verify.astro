---
import { thinSliceCopy } from '../copy/e1-11.ts';
import { createPool } from '../server/db/pool.ts';
import { consumeThinVerificationToken } from '../server/e1-11/verify.ts';

const token = Astro.url.searchParams.get('token') ?? '';
const databaseUrl = process.env.DATABASE_URL;
let outcome: 'verified' | 'already' | 'invalid' = 'invalid';
if (databaseUrl) {
  const database = createPool(databaseUrl);
  try {
    outcome = await consumeThinVerificationToken(database, token);
  } finally {
    await database.close();
  }
}
const message =
  outcome === 'verified' || outcome === 'already'
    ? thinSliceCopy.verificationComplete
    : thinSliceCopy.verificationInvalid;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body>
    <p>{message}</p>
  </body>
</html>
