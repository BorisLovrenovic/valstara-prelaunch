---
import { thinSliceCopy } from '../copy/e1-11.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConfig } from '../server/config.ts';
import { createPool } from '../server/db/pool.ts';
import { consumeThinVerificationToken } from '../server/e1-11/verify.ts';

const token = Astro.url.searchParams.get('token') ?? '';
const database = createPool(getConfig().databaseUrl);
let outcome: 'verified' | 'already' | 'invalid';
try {
  outcome = await consumeThinVerificationToken(database, token);
} finally {
  await database.close();
}
const message =
  outcome === 'verified' || outcome === 'already'
    ? thinSliceCopy.verificationComplete
    : thinSliceCopy.verificationInvalid;
---

<BaseLayout
  title={thinSliceCopy.verifyTitle}
  description={thinSliceCopy.verifyDescription}
>
  <p>{message}</p>
</BaseLayout>
