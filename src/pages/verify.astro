---
import { verificationCopy } from '../copy/verification.ts';
import { surveyCopy } from '../copy/survey.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConfig } from '../server/config.ts';
import { createPool } from '../server/db/pool.ts';
import { getFlagService } from '../server/flags/app-service.ts';
import { currentRules } from '../server/giveaway/rules-catalog.ts';
import {
  createVerificationCompletionService,
  type VerificationCompletion,
} from '../server/verification/complete.ts';
import { currentSurveyVersion } from '../server/survey/questions.ts';

const token = Astro.url.searchParams.get('token') ?? '';
Astro.response.headers.set('Cache-Control', 'private, no-store');

let completion: VerificationCompletion = {
  accessWindow: null,
  outcome: 'invalid',
  referralCode: null,
  statusToken: null,
  surveyCompleted: false,
};
let submitted = false;
let referralEnabled = false;

if (Astro.request.method === 'POST') {
  submitted = true;
  const formData = await Astro.request.formData().catch(() => new FormData());
  const submittedToken = formData.get('token');
  const authenticatedToken =
    typeof submittedToken === 'string' ? submittedToken : '';
  const database = createPool(getConfig().databaseUrl);
  referralEnabled =
    authenticatedToken === ''
      ? false
      : await getFlagService().isEnabled('referral.enabled');
  try {
    completion = await createVerificationCompletionService(database, {
      referralEnabled,
      giveaway: { flags: getFlagService(), currentRules },
    })(authenticatedToken);
  } finally {
    await database.close();
  }
}
const completed =
  completion.outcome === 'verified' || completion.outcome === 'already';
const surveyEnabled =
  completed && !completion.surveyCompleted
    ? await getFlagService().isEnabled('survey.enabled')
    : false;
const referralUrl =
  referralEnabled && completion.referralCode !== null
    ? new URL(`/?ref=${encodeURIComponent(completion.referralCode)}`, Astro.url)
    : null;
const statusUrl =
  completion.statusToken === null
    ? null
    : new URL(`/me?t=${encodeURIComponent(completion.statusToken)}`, Astro.url);
const showConfirmation = !submitted && token !== '';
const turnstileSiteKey = getConfig().turnstileSiteKey;
---

<BaseLayout
  title={verificationCopy.meta.title}
  description={verificationCopy.meta.description}
>
  {
    showConfirmation ? (
      <form action="/verify" class="verification-confirm" method="post">
        <p>{verificationCopy.confirm.body}</p>
        <input name="token" type="hidden" value={token} />
        <button type="submit">{verificationCopy.confirm.submit}</button>
      </form>
    ) : completed ? (
      <div class="verification-success">
        <p class="verification-success__message">{verificationCopy.complete}</p>

        {referralUrl !== null ? (
          <section class="verification-success__section">
            <h2>{verificationCopy.referral.label}</h2>
            <a href={referralUrl.toString()}>
              {verificationCopy.referral.link}
            </a>
          </section>
        ) : null}

        {surveyEnabled && statusUrl !== null ? (
          <form
            action="/api/survey"
            class="verification-success__section"
            data-survey-form
            data-unavailable-message={surveyCopy.unavailable}
            method="post"
          >
            <h2>{verificationCopy.survey.heading}</h2>
            <input name="token" type="hidden" value={completion.statusToken} />
            <input name="version" type="hidden" value={currentSurveyVersion} />
            <fieldset>
              <legend>{verificationCopy.survey.categoryLabel}</legend>
              {verificationCopy.survey.categoryOptions.map((option) => (
                <label>
                  <input
                    name="category_preference"
                    type="checkbox"
                    value={option.value}
                  />
                  {option.label}
                </label>
              ))}
            </fieldset>
            <fieldset>
              <legend>{verificationCopy.survey.frequencyLabel}</legend>
              {verificationCopy.survey.frequencyOptions.map((option) => (
                <label>
                  <input
                    name="shopping_frequency"
                    type="radio"
                    value={option.value}
                  />
                  {option.label}
                </label>
              ))}
            </fieldset>
            <button type="submit">{verificationCopy.survey.submit}</button>
            <p aria-live="polite" data-survey-status />
          </form>
        ) : null}

        {statusUrl !== null ? (
          <section class="verification-success__section">
            <h2>{verificationCopy.status.label}</h2>
            <a href={statusUrl.toString()}>{verificationCopy.status.link}</a>
          </section>
        ) : null}
      </div>
    ) : (
      <div class="verification-invalid">
        <p>{verificationCopy.invalid}</p>
        <form action="/api/resend-verification" method="post">
          <label for="resend-email">{verificationCopy.resend.emailLabel}</label>
          <input
            id="resend-email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-response-field-name="turnstile_token"
          />
          <noscript>
            <p>{verificationCopy.resend.javaScriptRequired}</p>
          </noscript>
          <button type="submit">{verificationCopy.resend.submit}</button>
        </form>
        <script
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      </div>
    )
  }
</BaseLayout>

<script is:inline>
  const surveyForm = document.querySelector('[data-survey-form]');
  if (surveyForm instanceof HTMLFormElement) {
    surveyForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = surveyForm.querySelector('[type="submit"]');
      const status = surveyForm.querySelector('[data-survey-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      )
        return;

      submit.disabled = true;
      try {
        const response = await fetch(surveyForm.action, {
          body: new FormData(surveyForm),
          method: 'POST',
        });
        const payload = await response.json();
        status.textContent = response.ok
          ? payload.message
          : (payload.error?.message ?? surveyForm.dataset.unavailableMessage);
      } catch {
        status.textContent = surveyForm.dataset.unavailableMessage ?? '';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .verification-success,
  .verification-confirm,
  .verification-invalid,
  .verification-invalid form,
  .verification-success__section,
  fieldset {
    display: grid;
    gap: var(--space-2);
  }

  .verification-success__message,
  h2,
  legend,
  label,
  input,
  a,
  button {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }

  .verification-success__message,
  h2 {
    margin: 0;
  }

  h2 {
    font-size: var(--step-3);
    line-height: var(--leading-3);
  }

  fieldset {
    margin: 0;
    padding: var(--space-2);
    border: thin solid var(--line);
    border-radius: var(--radius-card);
  }

  label {
    display: flex;
    gap: var(--space-1);
    align-items: center;
  }

  button {
    width: fit-content;
    padding: var(--space-1) var(--space-2);
    color: var(--midnight);
    background: var(--coral);
    border: thin solid var(--coral);
    border-radius: var(--radius-control);
  }
</style>
