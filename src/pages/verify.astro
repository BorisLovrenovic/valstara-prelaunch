---
import { verificationCopy } from '../copy/verification.ts';
import { surveyCopy } from '../copy/survey.ts';
import { resendVerificationCopy } from '../copy/resend-verification.ts';
import Button from '../components/button.astro';
import Card from '../components/card.astro';
import Container from '../components/container.astro';
import Field from '../components/field.astro';
import Icon from '../components/icon.astro';
import Input from '../components/input.astro';
import Pill from '../components/pill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConfig } from '../server/config.ts';
import { createPool } from '../server/db/pool.ts';
import { getFlagService } from '../server/flags/app-service.ts';
import { currentRules } from '../server/giveaway/rules-catalog.ts';
import {
  createVerificationCompletionService,
  type VerificationCompletion,
} from '../server/verification/complete.ts';
import { currentSurveyVersion } from '../server/survey/questions.ts';
import { accessWindows } from '../server/referral/config.ts';
import { verificationReferralFigures } from '../server/referral/verification-presentation.ts';
import { createAnalyticsService } from '../server/analytics/service.ts';
import {
  hoursToVerifyBucket,
  referrerTierBucket,
  sourceBucket,
} from '../server/analytics/funnel.ts';

const token = Astro.url.searchParams.get('token') ?? '';
Astro.response.headers.set('Cache-Control', 'private, no-store');

let completion: VerificationCompletion = {
  accessWindow: null,
  outcome: 'invalid',
  referralCode: null,
  referralStatus: null,
  statusToken: null,
  surveyCompleted: false,
};
let submitted = false;
let referralEnabled = false;

if (Astro.request.method === 'POST') {
  submitted = true;
  const formData = await Astro.request.formData().catch(() => new FormData());
  const submittedToken = formData.get('token');
  const authenticatedToken =
    typeof submittedToken === 'string' ? submittedToken : '';
  const database = createPool(getConfig().databaseUrl);
  referralEnabled =
    authenticatedToken === ''
      ? false
      : await getFlagService().isEnabled('referral.enabled');
  try {
    const analytics = createAnalyticsService();
    completion = await createVerificationCompletionService(database, {
      referralEnabled,
      giveaway: { flags: getFlagService(), currentRules },
      onCommitted: ({ verified, referrerTier, giveawayMethods }) => {
        if (verified !== null)
          void analytics
            .track('verified', {
              hours_to_verify_bucket: hoursToVerifyBucket(
                verified.createdAt,
                verified.verifiedAt,
              ),
              source_bucket: sourceBucket(verified.utm, verified.hasRef),
            })
            .catch(() => {});
        if (referrerTier !== null)
          void analytics
            .track('referral_confirmed', {
              referrer_tier_bucket: referrerTierBucket(referrerTier),
            })
            .catch(() => {});
        for (const method of giveawayMethods)
          void analytics.track('giveaway_entered', { method }).catch(() => {});
      },
    })(authenticatedToken);
  } finally {
    await database.close();
  }
}
const completed =
  completion.outcome === 'verified' || completion.outcome === 'already';
const referralFigures =
  completion.referralStatus === null
    ? null
    : verificationReferralFigures(completion.referralStatus);
const ladderFigures = referralFigures?.ladder ?? null;
const accessWindow = referralFigures?.accessWindow ?? null;
// The badge's bars: one per access wave, filled up to the visitor's own,
// so the four-wave set and the wave come from their sources.
const waveBars =
  accessWindow === null
    ? []
    : accessWindows.map(
        (wave) =>
          accessWindows.indexOf(wave) <=
          accessWindows.indexOf(accessWindow as (typeof accessWindows)[number]),
      );
const surveyEnabled =
  completed && !completion.surveyCompleted
    ? await getFlagService().isEnabled('survey.enabled')
    : false;
const referralUrl =
  referralEnabled && completion.referralStatus !== null
    ? new URL(completion.referralStatus.referralLink)
    : null;
const showReferral = referralUrl !== null && ladderFigures !== null;
// The link wraps after the origin and keeps its code in one unit, so it
// never truncates (the canvas's .linkbox). The parts are the URL's own.
const referralCode = referralUrl?.searchParams.get('ref') ?? '';
const referralParts =
  referralUrl === null
    ? null
    : referralUrl.search.endsWith(referralCode) && referralCode !== ''
      ? {
          base: `${referralUrl.origin}${referralUrl.pathname}`,
          query: referralUrl.search.slice(
            0,
            referralUrl.search.length - referralCode.length,
          ),
          code: referralCode,
        }
      : { base: referralUrl.toString(), query: '', code: '' };
const meterSegments =
  ladderFigures === null
    ? []
    : Array.from(
        { length: ladderFigures.threshold },
        (_, index) => index < ladderFigures.progress,
      );
const statusUrl =
  completion.statusToken === null
    ? null
    : new URL(`/me?t=${encodeURIComponent(completion.statusToken)}`, Astro.url);
const showSurvey = surveyEnabled && statusUrl !== null;
const showConfirmation = !submitted && token !== '';
const turnstileSiteKey = getConfig().turnstileSiteKey;
---

<BaseLayout
  title={verificationCopy.meta.title}
  description={verificationCopy.meta.description}
>
  <div class="verification-page">
    <Container class="verification-container">
      {
        showConfirmation ? (
          <div class="verification-task">
            <form action="/verify" class="verification-confirm" method="post">
              <Card
                class="verification-task__card"
                aria-labelledby="verification-title"
              >
                <div class="verification-task__head">
                  <span class="verification-tile verification-tile--task">
                    <Icon name="mail" />
                  </span>
                  <h1 id="verification-title">
                    {verificationCopy.confirm.body}
                  </h1>
                </div>
                <p class="verification-task__line">
                  {verificationCopy.confirm.next}
                </p>
                <input name="token" type="hidden" value={token} />
                <div class="verification-task__actions">
                  <Button type="submit">
                    {verificationCopy.confirm.submit}
                  </Button>
                </div>
              </Card>
            </form>
          </div>
        ) : completed ? (
          <div
            class:list={[
              'verification-success',
              showReferral && 'verification-success--referral',
              showSurvey && 'verification-success--survey',
            ]}
          >
            <Card
              class="verification-hero verification-main"
              aria-labelledby="verification-title"
            >
              <div class="verification-hero__head">
                <span
                  class="verification-tile verification-tile--success"
                  data-enter
                  style="--enter-index: 0"
                >
                  <Icon name="check-circle" draw class="verification-check" />
                </span>
                <h1
                  class="verification-success__message"
                  id="verification-title"
                  data-enter="shift"
                  style="--enter-index: 1"
                >
                  {verificationCopy.complete}
                </h1>
                <p data-enter="shift" style="--enter-index: 1">
                  {referralEnabled
                    ? verificationCopy.completeNext
                    : verificationCopy.completeNextNoReferral}
                </p>
              </div>
              {accessWindow !== null ? (
                <div class="verification-hero__meta">
                  <span
                    class="verification-wave"
                    data-access-wave
                    data-enter="shift"
                    style="--enter-index: 2"
                  >
                    <span class="verification-wave__bars" aria-hidden="true">
                      {waveBars.map((on) => (
                        <i class:list={[on && 'is-on']} />
                      ))}
                    </span>
                    {verificationCopy.referral.wave(accessWindow)}
                  </span>
                </div>
              ) : null}
            </Card>

            {showReferral &&
            referralParts !== null &&
            ladderFigures !== null ? (
              <Card
                class="verification-referral verification-main"
                aria-labelledby="verification-referral-title"
                data-referral-card
                data-enter="shift"
                style="--enter-index: 3"
              >
                <div class="verification-card-head">
                  <span class="verification-tile">
                    <Icon name="people" size="base" />
                  </span>
                  <h2
                    class="verification-card-title"
                    id="verification-referral-title"
                  >
                    {verificationCopy.referral.label}
                  </h2>
                </div>
                {/* The link, Copy link and Share link, named for assistive
                    technology by the E11.5-07 line the canvas no longer
                    draws. */}
                <div
                  class="verification-share-group"
                  role="group"
                  aria-label={verificationCopy.referral.link}
                >
                  <div class="verification-ref-row">
                    <p
                      class="verification-linkbox"
                      data-referral-link
                      data-referral-url={referralUrl?.toString()}
                    >
                      {/* One expression, so no whitespace enters the link. */}
                      {[
                        referralParts.base,
                        <wbr />,
                        referralParts.query,
                        <span class="verification-linkbox__code">
                          {referralParts.code}
                        </span>,
                      ]}
                    </p>
                    <Button
                      class="verification-copy"
                      data-copy-referral
                      data-copied={verificationCopy.referral.copied}
                      data-copy-failed={verificationCopy.referral.copyFailed}
                    >
                      <span class="verification-copy__faces">
                        <span class="verification-copy__face">
                          <Icon name="copy" size="base" />
                          <span>{verificationCopy.referral.copy}</span>
                        </span>
                        <span
                          class="verification-copy__face verification-copy__face--done"
                          aria-hidden="true"
                        >
                          <Icon name="check" size="base" />
                          <span>{verificationCopy.referral.copied}</span>
                        </span>
                      </span>
                    </Button>
                  </div>
                  <div class="verification-copy-result" data-copy-result>
                    <Icon name="info" size="base" />
                    <p aria-live="polite" data-copy-status />
                  </div>
                  <div
                    class="verification-share"
                    data-share-host
                    data-share-title={verificationCopy.referral.label}
                  >
                    <template data-share-template>
                      <Button
                        class="verification-native-share verification-keep"
                        variant="secondary"
                        full
                      >
                        <Icon name="upload-share" size="base" />
                        {verificationCopy.referral.share}
                      </Button>
                    </template>
                  </div>
                </div>
                <div class="verification-well">
                  <div class="verification-meter">
                    <div class="verification-meter__top">
                      <label
                        class="verification-meter__value"
                        for="referral-progress"
                        data-meter-text
                      >
                        {verificationCopy.referral.progress(
                          ladderFigures.progress,
                          ladderFigures.threshold,
                          ladderFigures.tier,
                        )}
                      </label>
                    </div>
                    <progress
                      class="verification-meter__native"
                      id="referral-progress"
                      data-referral-progress
                      value={ladderFigures.progress}
                      max={ladderFigures.threshold}
                    />
                    <span
                      class="verification-meter__track"
                      aria-hidden="true"
                      data-meter-track
                    >
                      {meterSegments.map((filled) => (
                        <i
                          class:list={[
                            'verification-meter__segment',
                            filled && 'is-filled',
                          ]}
                        >
                          {filled ? (
                            <b class="verification-meter__fill" />
                          ) : null}
                        </i>
                      ))}
                    </span>
                  </div>
                  <div class="verification-unlocks">
                    <p class="verification-label">
                      {verificationCopy.referral.unlocks(ladderFigures.tier)}
                    </p>
                    <ul class="verification-unlocks__list">
                      <li>
                        <Pill>
                          <Icon name="arrow-up" size="sm" />
                          {verificationCopy.referral.waveReward}
                        </Pill>
                      </li>
                      <li>
                        <Pill variant="coral">
                          {verificationCopy.referral.reward(
                            ladderFigures.discountPercent,
                          )}
                        </Pill>
                      </li>
                    </ul>
                    {ladderFigures.rewardStates.length > 0 ? (
                      <ul class="verification-unlocks__list">
                        {ladderFigures.rewardStates.map((reward) => (
                          <li>
                            <Pill>
                              {reward.kind === 'discount'
                                ? verificationCopy.referral.reward(
                                    ladderFigures.discountPercent,
                                  )
                                : verificationCopy.referral.waveReward}
                              : {verificationCopy.referral[reward.state]}
                            </Pill>
                          </li>
                        ))}
                      </ul>
                    ) : null}
                  </div>
                </div>
                <p class="verification-held">
                  <Icon name="clock" size="sm" />
                  <span>{verificationCopy.referral.heldCondition}</span>
                </p>
              </Card>
            ) : null}

            {showSurvey ? (
              <Card
                class:list={[
                  'verification-survey-card',
                  showReferral ? 'verification-side' : 'verification-main',
                ]}
                aria-labelledby="verification-survey-title"
                data-reveal
              >
                <h2
                  class="verification-card-title"
                  id="verification-survey-title"
                >
                  {verificationCopy.survey.heading}
                </h2>
                <form
                  action="/api/survey"
                  class="verification-survey"
                  data-survey-form
                  data-unavailable-message={surveyCopy.unavailable}
                  method="post"
                >
                  <input
                    name="token"
                    type="hidden"
                    value={completion.statusToken}
                  />
                  <input
                    name="version"
                    type="hidden"
                    value={currentSurveyVersion}
                  />
                  <div class="verification-survey__fields" data-survey-fields>
                    <fieldset class="verification-question">
                      <legend>{verificationCopy.survey.categoryLabel}</legend>
                      <div class="verification-chips">
                        {verificationCopy.survey.categoryOptions.map(
                          (option) => (
                            <label class="verification-choice">
                              <input
                                name="category_preference"
                                type="checkbox"
                                value={option.value}
                              />
                              <span class="verification-chip">
                                <Icon
                                  name="check"
                                  size="sm"
                                  class="verification-option__check"
                                />
                                <span>{option.label}</span>
                              </span>
                            </label>
                          ),
                        )}
                      </div>
                    </fieldset>
                    <fieldset class="verification-question">
                      <legend>{verificationCopy.survey.frequencyLabel}</legend>
                      <div class="verification-segments">
                        {verificationCopy.survey.frequencyOptions.map(
                          (option) => (
                            <label class="verification-choice">
                              <input
                                name="shopping_frequency"
                                type="radio"
                                value={option.value}
                              />
                              <span class="verification-segment">
                                <Icon
                                  name="check"
                                  size="sm"
                                  class="verification-option__check"
                                />
                                <span>{option.label}</span>
                              </span>
                            </label>
                          ),
                        )}
                      </div>
                    </fieldset>
                  </div>
                  <div
                    class="verification-survey-result"
                    data-survey-result
                    tabindex="-1"
                  >
                    <Icon
                      name="check-circle"
                      size="base"
                      class="verification-survey-result__icon verification-survey-result__icon--saved"
                    />
                    <Icon
                      name="check"
                      size="base"
                      class="verification-survey-result__icon verification-survey-result__icon--skipped"
                    />
                    <Icon
                      name="alert-circle"
                      size="base"
                      class="verification-survey-result__icon verification-survey-result__icon--error"
                    />
                    <p aria-live="polite" data-survey-status />
                  </div>
                  <div class="verification-survey-actions" data-survey-fields>
                    <Button
                      class="verification-keep"
                      type="submit"
                      variant="secondary"
                    >
                      {verificationCopy.survey.submit}
                    </Button>
                    <Button
                      class="verification-keep"
                      variant="secondary"
                      data-survey-skip
                    >
                      {verificationCopy.survey.skip}
                    </Button>
                  </div>
                </form>
              </Card>
            ) : null}

            {statusUrl !== null ? (
              <Card
                class="verification-status"
                aria-labelledby="verification-status-title"
                data-reveal
              >
                <div class="verification-card-head">
                  <span class="verification-tile verification-tile--neutral">
                    <Icon name="person" size="base" />
                  </span>
                  <h2
                    class="verification-card-title"
                    id="verification-status-title"
                  >
                    {verificationCopy.status.label}
                  </h2>
                </div>
                <Button
                  class="verification-status__link verification-keep"
                  href={statusUrl.toString()}
                  variant="secondary"
                >
                  {verificationCopy.status.link}
                  <Icon name="arrow-right" size="sm" />
                </Button>
              </Card>
            ) : null}
          </div>
        ) : (
          <div class="verification-task">
            <Card
              class="verification-task__card verification-invalid"
              aria-labelledby="verification-title"
            >
              <div class="verification-notice verification-notice--info verification-invalid__notice">
                <Icon name="info" size="base" />
                <p>{verificationCopy.invalid}</p>
              </div>
              <div class="verification-task__head">
                <span class="verification-tile verification-tile--task verification-tile--neutral">
                  <Icon name="refresh" />
                </span>
                <h1 id="verification-title">
                  {verificationCopy.invalidHeading}
                </h1>
              </div>
              <noscript>
                <div class="verification-notice verification-notice--info verification-task__notice">
                  <Icon name="info" size="base" />
                  <p>{verificationCopy.resend.javaScriptRequired}</p>
                </div>
              </noscript>
              <div
                class="verification-notice verification-task__notice verification-resend-result"
                data-resend-result
              >
                <Icon
                  name="check-circle"
                  size="base"
                  class="verification-resend-result__icon verification-resend-result__icon--success"
                />
                <Icon
                  name="alert-circle"
                  size="base"
                  class="verification-resend-result__icon verification-resend-result__icon--error"
                />
                <p aria-live="polite" data-resend-status />
              </div>
              <form
                action="/api/resend-verification"
                class="verification-task__form"
                data-resend-form
                data-unavailable-message={resendVerificationCopy.unavailable}
                method="post"
              >
                <Field
                  controlId="resend-email"
                  label={verificationCopy.resend.emailLabel}
                >
                  <Input
                    id="resend-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    required
                  />
                </Field>
                <div class="verification-task__actions verification-task__actions--form">
                  <Button type="submit" disabled data-resend-submit>
                    {verificationCopy.resend.submit}
                  </Button>
                </div>
                <div
                  class="cf-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-size="compact"
                  data-appearance="interaction-only"
                  data-response-field-name="turnstile_token"
                />
              </form>
              <script
                is:inline
                src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                async
                defer
              />
            </Card>
          </div>
        )
      }
    </Container>
  </div>
</BaseLayout>

<script is:inline>
  // A duration token, read from the root so the hold stays in tokens.css.
  const durationToken = (name) => {
    if (typeof getComputedStyle !== 'function') return 0;
    const value = getComputedStyle(document.documentElement)
      .getPropertyValue(name)
      .trim();
    const amount =
      Number.parseFloat(value) * (/(?<!m)s$/u.test(value) ? 1000 : 1);
    return Number.isFinite(amount) ? amount : 0;
  };

  const referralLink = document.querySelector('[data-referral-link]');
  const copyButton = document.querySelector('[data-copy-referral]');
  const copyResult = document.querySelector('[data-copy-result]');
  const copyStatus = document.querySelector('[data-copy-status]');
  if (
    referralLink instanceof HTMLElement &&
    copyButton instanceof HTMLButtonElement &&
    copyResult instanceof HTMLElement &&
    copyStatus instanceof HTMLElement
  ) {
    const referralUrl = referralLink.dataset.referralUrl ?? '';
    let copiedTimer;
    copyButton.addEventListener('click', async () => {
      globalThis.clearTimeout(copiedTimer);
      copyStatus.textContent = '';
      copyResult.dataset.copyResult = '';
      referralLink.dataset.selected = '';
      try {
        await navigator.clipboard.writeText(referralUrl);
        // The label cross-fades to "Link copied." and back after the hold;
        // the live region announces it, shown only for a failure.
        copyButton.dataset.copyState = 'copied';
        copyResult.dataset.copyResult = 'copied';
        copyStatus.textContent = copyButton.dataset.copied ?? '';
        copiedTimer = globalThis.setTimeout(() => {
          copyButton.dataset.copyState = '';
          copyResult.dataset.copyResult = '';
          copyStatus.textContent = '';
        }, durationToken('--copy-confirm-hold'));
      } catch {
        copyButton.dataset.copyState = '';
        const selection = globalThis.getSelection?.();
        selection?.selectAllChildren(referralLink);
        referralLink.dataset.selected = 'true';
        copyResult.dataset.copyResult = 'failed';
        copyStatus.textContent = copyButton.dataset.copyFailed ?? '';
      }
    });
    const shareHost = document.querySelector('[data-share-host]');
    const shareTemplate = shareHost?.querySelector('[data-share-template]');
    if (
      shareHost instanceof HTMLElement &&
      shareTemplate instanceof HTMLTemplateElement &&
      typeof navigator.share === 'function'
    ) {
      const share = shareTemplate.content.cloneNode(true);
      const shareButton = share.querySelector('button');
      shareButton?.addEventListener('click', () => {
        void navigator
          .share({ title: shareHost.dataset.shareTitle, url: referralUrl })
          .catch(() => {});
      });
      shareHost.append(share);
    }
  }

  const resendForm = document.querySelector('[data-resend-form]');
  const resendResult = document.querySelector('[data-resend-result]');
  const resendStatus = document.querySelector('[data-resend-status]');
  if (
    resendForm instanceof HTMLFormElement &&
    resendResult instanceof HTMLElement &&
    resendStatus instanceof HTMLElement
  ) {
    const resendSubmit = resendForm.querySelector('[data-resend-submit]');
    if (resendSubmit instanceof HTMLButtonElement) {
      // Server-rendered disabled: without JavaScript the security check
      // cannot run, and the notice above says so (founder decision
      // 2026-11-10).
      resendSubmit.disabled = false;
      resendForm.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (resendSubmit.disabled) return;
        resendSubmit.disabled = true;
        resendResult.dataset.resendResult = '';
        resendStatus.textContent = '';
        let tone = 'error';
        let message = resendForm.dataset.unavailableMessage ?? '';
        try {
          const response = await fetch(resendForm.action, {
            body: new FormData(resendForm),
            method: 'POST',
          });
          const payload = await response.json();
          if (response.ok && typeof payload.message === 'string') {
            tone = 'success';
            message = payload.message;
          } else if (typeof payload.error?.message === 'string') {
            message = payload.error.message;
          }
        } catch {
          // The unavailable message stands.
        }
        resendResult.dataset.resendResult = tone;
        resendStatus.textContent = message;
        // A Turnstile token is single-use, so the next request needs a new one.
        globalThis.turnstile?.reset?.();
        resendSubmit.disabled = false;
      });
    }
  }

  const surveyForm = document.querySelector('[data-survey-form]');
  if (surveyForm instanceof HTMLFormElement) {
    // Saving or skipping fades the questions out over their transition, then
    // the result takes their place (founder decision 2026-11-10).
    const leaveQuestions = () => {
      if (typeof getComputedStyle !== 'function') return Promise.resolve();
      const fields = [...surveyForm.querySelectorAll('[data-survey-fields]')];
      const longest = Math.max(
        0,
        ...fields.flatMap((field) =>
          getComputedStyle(field).transitionProperty === 'none'
            ? []
            : getComputedStyle(field)
                .transitionDuration.split(',')
                .map(
                  (value) =>
                    Number.parseFloat(value) *
                    (/(?<!m)s$/u.test(value.trim()) ? 1000 : 1),
                ),
        ),
      );
      if (!(longest > 0)) return Promise.resolve();
      surveyForm.dataset.surveyState = 'leaving';
      return new Promise((resolve) => {
        fields[0]?.addEventListener('transitionend', () => resolve(), {
          once: true,
        });
        globalThis.setTimeout(resolve, longest * 2);
      });
    };
    const skip = surveyForm.querySelector('[data-survey-skip]');
    if (skip instanceof HTMLButtonElement) {
      skip.addEventListener('click', () => {
        for (const input of surveyForm.querySelectorAll(
          'input[type="checkbox"], input[type="radio"]',
        )) {
          if (input instanceof HTMLInputElement) input.checked = false;
        }
        surveyForm.requestSubmit();
      });
    }
    surveyForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = surveyForm.querySelector('[type="submit"]');
      const status = surveyForm.querySelector('[data-survey-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      )
        return;

      submit.disabled = true;
      if (skip instanceof HTMLButtonElement) skip.disabled = true;
      surveyForm.dataset.surveyState = '';
      status.textContent = '';
      let state = 'error';
      let message = surveyForm.dataset.unavailableMessage ?? '';
      try {
        const response = await fetch(surveyForm.action, {
          body: new FormData(surveyForm),
          method: 'POST',
        });
        const payload = await response.json();
        if (response.ok) {
          state = payload.status === 'skipped' ? 'skipped' : 'saved';
          message = payload.message;
        } else {
          state = payload.error?.code === 'invalid_input' ? 'invalid' : 'error';
          message = payload.error?.message ?? message;
        }
      } catch {
        // The unavailable message stands.
      }
      if (state === 'saved' || state === 'skipped') await leaveQuestions();
      surveyForm.dataset.surveyState = state;
      status.textContent = message;
      submit.disabled = false;
      if (skip instanceof HTMLButtonElement) skip.disabled = false;
      if (state === 'saved' || state === 'skipped') {
        const result = surveyForm.querySelector('[data-survey-result]');
        if (result instanceof HTMLElement)
          result.focus?.({ preventScroll: true });
      }
    });
  }
</script>

