---
import Button from '../components/button.astro';
import type { IconName } from '../components/icon.astro';
import TaskCard from '../layouts/task-card.astro';
import { unsubscribeCopy } from '../copy/unsubscribe.ts';
import { createAnalyticsService } from '../server/analytics/service.ts';
import type { EventProps } from '../server/analytics/registry.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConfig, getP1AlertConfiguration } from '../server/config.ts';
import { createPool } from '../server/db/pool.ts';
import {
  createUnsubscribeService,
  type UnsubscribeOutcome,
} from '../server/email/unsubscribe.ts';
import { hashedIpPrefix } from '../server/ratelimit/ip-prefix.ts';
import { createUnsubscribeOperatorTaskTransport } from '../server/verification-rate/p1-webhook.ts';

Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const token = Astro.url.searchParams.get('t') ?? '';
let outcome: UnsubscribeOutcome | 'unavailable' | null = null;
let submittedToken = token;
let submittedIntent: 'message' | 'leave_waitlist' = 'message';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => new FormData());
  const formToken = form.get('t');
  const intent = form.get('intent');
  if (
    form.has('template') ||
    Astro.url.searchParams.has('template') ||
    (intent !== 'message' && intent !== 'leave_waitlist') ||
    typeof formToken !== 'string' ||
    formToken === ''
  ) {
    outcome = 'invalid';
    Astro.response.status = 400;
  } else {
    submittedToken = formToken;
    submittedIntent = intent;
    const config = getConfig();
    const database = createPool(config.databaseUrl);
    try {
      const alerts = createUnsubscribeOperatorTaskTransport(
        getP1AlertConfiguration(),
      );
      const analytics = createAnalyticsService();
      outcome = await createUnsubscribeService(database, {
        onEffectiveChange: (sourceTemplate) => {
          void analytics
            .track('unsubscribed', {
              source_template:
                sourceTemplate as EventProps<'unsubscribed'>['source_template'],
            })
            .catch(() => {});
        },
        tokenSecret: config.emailTokenSecret,
        onFailure: ({
          unsubscribeTokenId,
          emailSendId,
          tokenSha256,
          requestedAction,
          occurredAt,
        }) =>
          alerts.send({
            kind: 'operator_task',
            task: 'unsubscribe_apply_failed',
            unsubscribe_token_id: unsubscribeTokenId,
            email_send_id: emailSendId,
            token_sha256: tokenSha256,
            requested_action: requestedAction,
            occurred_at: occurredAt.toISOString(),
          }),
      }).apply({
        token: formToken,
        action: intent === 'message' ? 'message_unsubscribe' : 'leave_waitlist',
        ipPrefixHash:
          hashedIpPrefix(Astro.clientAddress, config.ipPrefixPepper) ?? '',
        requestId: Astro.request.headers.get('x-request-id') ?? undefined,
      });
      if (outcome === 'rate_limited') Astro.response.status = 429;
      if (outcome === 'invalid') Astro.response.status = 400;
    } catch {
      outcome = 'unavailable';
      Astro.response.status = 503;
    } finally {
      await database.close();
    }
  }
}
// Each outcome renders as one task-card state with its icon (E11.5-10).
const view: {
  state: string;
  icon: IconName;
  heading: string;
  body: string;
} =
  outcome === 'accepted' || outcome === 'already'
    ? { state: 'complete', icon: 'check', ...unsubscribeCopy.complete }
    : outcome === 'unavailable'
      ? { state: 'unavailable', icon: 'alert', ...unsubscribeCopy.unavailable }
      : outcome === 'rate_limited'
        ? {
            state: 'rate-limited',
            icon: 'clock',
            heading: unsubscribeCopy.rateLimitedHeading,
            body: unsubscribeCopy.rateLimited,
          }
        : outcome === 'invalid' || token === ''
          ? { state: 'invalid', icon: 'alert', ...unsubscribeCopy.invalid }
          : { state: 'confirm', icon: 'shield', ...unsubscribeCopy.confirm };
---

<BaseLayout
  title={unsubscribeCopy.meta.title}
  description={unsubscribeCopy.meta.description}
>
  <TaskCard heading={view.heading} icon={view.icon} state={view.state}>
    <p>{view.body}</p>
    {
      view.state === 'unavailable' ? (
        <form method="post">
          <input type="hidden" name="t" value={submittedToken} />
          <div class="task-card__actions">
            <Button type="submit" name="intent" value={submittedIntent}>
              {unsubscribeCopy.unavailable.retry}
            </Button>
          </div>
        </form>
      ) : view.state === 'confirm' ? (
        <form method="post">
          <input type="hidden" name="t" value={token} />
          <div class="task-card__actions">
            <Button type="submit" name="intent" value="message">
              {unsubscribeCopy.confirm.message}
            </Button>
            <Button
              type="submit"
              name="intent"
              value="leave_waitlist"
              variant="secondary"
            >
              {unsubscribeCopy.confirm.leave}
            </Button>
          </div>
        </form>
      ) : null
    }
  </TaskCard>
</BaseLayout>
