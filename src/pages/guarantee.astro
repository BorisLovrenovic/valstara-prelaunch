---
import { getEntry, render } from 'astro:content';
import TrustPage from '../layouts/trust-page.astro';

export const prerender = true;

const entry = await getEntry('trust', 'guarantee');
if (!entry || entry.data.portTarget !== '/guarantee') {
  throw new Error('Missing or misrouted /guarantee content.');
}
const { Content } = await render(entry);
---

<TrustPage
  title={entry.data.title}
  description={entry.data.description}
  kind="trust"
  summary={entry.data.description}
  renderedHtml={entry.rendered?.html ?? ''}
>
  <Content />
</TrustPage>
