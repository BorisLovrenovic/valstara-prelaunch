---
import { memberStatusCopy } from '../copy/member-status.ts';
import { surveyCopy } from '../copy/survey.ts';
import { verificationCopy } from '../copy/verification.ts';
import Accordion from '../components/accordion.astro';
import Button from '../components/button.astro';
import Card from '../components/card.astro';
import Container from '../components/container.astro';
import Icon from '../components/icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConfig } from '../server/config.ts';
import { createPool } from '../server/db/pool.ts';
import { createUnsubscribeRepository } from '../server/db/unsubscribe.ts';
import { getFlagService } from '../server/flags/app-service.ts';
import { accessWindows } from '../server/referral/config.ts';
import { createReferralService } from '../server/referral/service.ts';
import { presentReferralStatus } from '../server/referral/status-presentation.ts';
import { verificationReferralFigures } from '../server/referral/verification-presentation.ts';
import { dsrCopy } from '../copy/dsr.ts';
import { createMarketingService } from '../server/subscriber/marketing.ts';
import type { ReferralStatus } from '../server/referral/status.ts';
import { hashedIpPrefix } from '../server/ratelimit/ip-prefix.ts';
import { currentSurveyVersion } from '../server/survey/questions.ts';
import { verifyTurnstileToken } from '../server/turnstile/verify.ts';
import {
  createStatusLinkRecoveryBoundary,
  createStatusLinkService,
  type StatusLinkAuthentication,
} from '../server/verification/status-link.ts';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const config = getConfig();
const flags = getFlagService();
let authentication: StatusLinkAuthentication = { kind: 'rejected' };
let dashboardStatus: ReferralStatus | null = null;
let replacementRequested = false;
let challengeFailed = false;
let surveyEnabled = false;
let marketingEnabled = false;
let leftWaitlist = false;
const token = Astro.url.searchParams.get('t') ?? '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData().catch(() => new FormData());
  const submittedChallenge = formData.get('turnstile_token');
  const recovery = await createStatusLinkRecoveryBoundary({
    verifyTurnstile: verifyTurnstileToken,
    async recover(challengeTimedOut) {
      // Construct every stateful dependency only after Turnstile has returned
      // a verified or provider-unavailable outcome.
      const database = createPool(config.databaseUrl);
      try {
        const prefixHash = hashedIpPrefix(
          Astro.clientAddress,
          config.ipPrefixPepper,
        );
        return await createStatusLinkService(database, {
          flags,
        }).requestReplacement({
          challengeTimedOut,
          ipPrefixHash: prefixHash ?? '',
          token,
        });
      } finally {
        await database.close();
      }
    },
  })(typeof submittedChallenge === 'string' ? submittedChallenge : '');

  if (recovery === 'challenge_failed') {
    Astro.response.status = 400;
    challengeFailed = true;
  } else if (recovery === 'disabled') {
    authentication = { kind: 'disabled' };
  } else {
    replacementRequested = true;
  }
} else {
  const database = createPool(config.databaseUrl);
  try {
    const statusLinks = createStatusLinkService(database, {
      flags,
    });
    authentication = await statusLinks.authenticate(token);
    if (authentication.kind === 'authenticated') {
      const subject = await createUnsubscribeRepository(database).statusSubject(
        authentication.subscriberId,
      );
      if (subject?.status === 'unsubscribed') {
        leftWaitlist = true;
      } else if (subject?.status !== 'verified') {
        authentication = { kind: 'rejected' };
      } else {
        [dashboardStatus, surveyEnabled, marketingEnabled] = await Promise.all([
          createReferralService(database).status(authentication.subscriberId),
          flags.isEnabled('survey.enabled'),
          createMarketingService(database, { flags }).preference(
            authentication.subscriberId,
          ),
        ]);
      }
    }
  } finally {
    await database.close();
  }
}
const dashboardView =
  dashboardStatus === null ? null : presentReferralStatus(dashboardStatus);
// Every fact reads its figure from the one shared status presentation; the
// keys only decide the order. Giveaway entries show only when there is at
// least one (E11.5-11r decision 1).
const dashboardFields =
  dashboardView === null
    ? null
    : new Map(dashboardView.fields.map((field) => [field.key, field]));
type DashboardField = NonNullable<typeof dashboardView>['fields'][number];
const factKeys: readonly DashboardField['key'][] = [
  'subscriberStatus',
  'accessWindow',
  'ownRank',
  'confirmedReferrals',
  'tier',
  ...(dashboardStatus !== null && dashboardStatus.giveawayEntries > 0
    ? (['giveawayEntries'] as const)
    : []),
];
const facts = factKeys.flatMap((key) => dashboardFields?.get(key) ?? []);
const ladderFigures =
  dashboardStatus === null
    ? null
    : verificationReferralFigures(dashboardStatus).ladder;
const accessWindow = dashboardStatus?.accessWindow ?? null;
// The wave badge's four bars, filled up to the member's wave.
const waveBars = accessWindows.map(
  (wave) =>
    accessWindow !== null &&
    accessWindows.indexOf(wave) <=
      accessWindows.indexOf(accessWindow as (typeof accessWindows)[number]),
);
// A figure is mono; a word in its place ("Not currently ranked") is muted.
const mutedValue = (field: DashboardField) =>
  (field.key === 'ownRank' && dashboardStatus?.ownRank === null) ||
  (field.key === 'accessWindow' && accessWindow === null);
// The link wraps after the origin and keeps its code in one unit, so it
// never truncates, as on /verify (E11.5-11r decision 2).
const referralUrl =
  dashboardView === null ? null : new URL(dashboardView.referralLink);
const referralCode = referralUrl?.searchParams.get('ref') ?? '';
const referralParts =
  referralUrl === null
    ? null
    : referralUrl.search.endsWith(referralCode) && referralCode !== ''
      ? {
          base: `${referralUrl.origin}${referralUrl.pathname}`,
          query: referralUrl.search.slice(
            0,
            referralUrl.search.length - referralCode.length,
          ),
          code: referralCode,
        }
      : { base: referralUrl.toString(), query: '', code: '' };
const meterSegments =
  ladderFigures === null
    ? []
    : Array.from(
        { length: ladderFigures.threshold },
        (_, index) => index < ladderFigures.progress,
      );
// Held and settled differ by icon, word, fill and outline, never by colour
// alone.
const rewardIcon = { held: 'clock', settled: 'check' } as const;
---

<BaseLayout
  title={memberStatusCopy.meta.title}
  description={memberStatusCopy.meta.description}
>
  <div class="member-page">
    <Container class="member-container">
      {
        authentication.kind === 'authenticated' && leftWaitlist ? (
          <div class="member-task">
            <Card
              class="member-boundary member-task__card"
              data-member-state="left"
              aria-labelledby="member-title"
            >
              <div class="member-task__head">
                <span class="member-tile member-tile--task member-tile--neutral">
                  <Icon name="x" />
                </span>
                <h1 id="member-title">{memberStatusCopy.left.heading}</h1>
              </div>
              <p class="member-task__line">{memberStatusCopy.left.body}</p>
            </Card>
          </div>
        ) : authentication.kind === 'authenticated' &&
          dashboardView !== null &&
          referralParts !== null ? (
          <div class="member-grid" data-member-dashboard>
            <Card
              class="member-card member-status"
              data-member-card="status"
              aria-labelledby="member-title"
            >
              <div class="member-head" data-enter="shift">
                <h1 id="member-title">
                  {memberStatusCopy.authenticated.heading}
                </h1>
                <p>{memberStatusCopy.authenticated.body}</p>
              </div>
              <dl
                class:list={[
                  'member-facts',
                  facts.length === 6 && 'member-facts--6',
                ]}
                data-enter="shift"
                style="--enter-index: 1"
              >
                {facts.map((field) => (
                  <div class="member-fact" data-member-field={field.key}>
                    <dt>{field.label}</dt>
                    {field.key === 'subscriberStatus' ? (
                      <dd>
                        <Icon name="check-circle" size="base" />
                        {field.value}
                      </dd>
                    ) : field.key === 'accessWindow' &&
                      accessWindow !== null ? (
                      <dd>
                        <span
                          class="member-wave"
                          data-access-wave
                          data-enter="shift"
                          style="--enter-index: 2"
                        >
                          <span class="member-wave__bars" aria-hidden="true">
                            {waveBars.map((on) => (
                              <i class:list={[on && 'is-on']} />
                            ))}
                          </span>
                          <data value={field.value}>
                            {memberStatusCopy.authenticated.waveBadge(
                              accessWindow,
                            )}
                          </data>
                        </span>
                      </dd>
                    ) : (
                      <dd
                        class:list={[
                          mutedValue(field)
                            ? 'member-fact__muted'
                            : field.tabular && 'tabular-figure',
                        ]}
                      >
                        {field.value}
                      </dd>
                    )}
                  </div>
                ))}
              </dl>
            </Card>

            <Card
              class="member-card member-main member-referral"
              data-member-card="referral"
              aria-labelledby="member-referral-title"
              data-reveal
            >
              <div class="member-card-head">
                <span class="member-tile">
                  <Icon name="people" size="base" />
                </span>
                <h2 class="member-card-title" id="member-referral-title">
                  {memberStatusCopy.referral.heading}
                </h2>
              </div>
              <div class="member-ref-row">
                <p
                  class="member-linkbox"
                  data-referral-link
                  data-referral-url={dashboardView.referralLink}
                >
                  {/* One expression, so no whitespace enters the link. */}
                  {[
                    referralParts.base,
                    <wbr />,
                    referralParts.query,
                    <span class="member-linkbox__code">
                      {referralParts.code}
                    </span>,
                  ]}
                </p>
                <Button
                  class="member-copy"
                  data-copy-referral
                  data-copied={memberStatusCopy.referral.copied}
                  data-copy-failed={memberStatusCopy.referral.copyFailed}
                >
                  <span class="member-copy__faces">
                    <span class="member-copy__face">
                      <Icon name="copy" size="base" />
                      <span>{memberStatusCopy.referral.copy}</span>
                    </span>
                    <span
                      class="member-copy__face member-copy__face--done"
                      aria-hidden="true"
                    >
                      <Icon name="check" size="base" />
                      <span>{memberStatusCopy.referral.copied}</span>
                    </span>
                  </span>
                </Button>
              </div>
              <div class="member-copy-result" data-copy-result>
                <Icon name="info" size="base" />
                <p aria-live="polite" data-copy-status />
              </div>
              <div
                class="member-share"
                data-share-host
                data-share-title={memberStatusCopy.referral.heading}
              >
                <template data-share-template>
                  <Button
                    class="member-native-share member-keep"
                    variant="secondary"
                    full
                  >
                    <Icon name="upload-share" size="base" />
                    {memberStatusCopy.referral.share}
                  </Button>
                </template>
              </div>
              {ladderFigures !== null ? (
                <div class="member-well member-meter">
                  <div class="member-meter__top">
                    <label
                      class="member-meter__value"
                      for="member-referral-progress"
                      data-meter-text
                    >
                      {memberStatusCopy.referral.progress(
                        ladderFigures.progress,
                        ladderFigures.threshold,
                        ladderFigures.tier,
                      )}
                    </label>
                  </div>
                  <progress
                    class="member-meter__native"
                    id="member-referral-progress"
                    data-referral-progress
                    value={ladderFigures.progress}
                    max={ladderFigures.threshold}
                  />
                  <span
                    class="member-meter__track"
                    aria-hidden="true"
                    data-meter-track
                  >
                    {meterSegments.map((filled) => (
                      <i
                        class:list={[
                          'member-meter__segment',
                          filled && 'is-filled',
                        ]}
                      >
                        {filled ? <b class="member-meter__fill" /> : null}
                      </i>
                    ))}
                  </span>
                </div>
              ) : null}
            </Card>

            <Card
              class="member-card member-side"
              data-member-card="rewards"
              aria-labelledby="member-rewards-title"
              data-reveal
              style="--reveal-index: 1"
            >
              <div class="member-card-head">
                <span class="member-tile">
                  <Icon name="gift" size="base" />
                </span>
                <h2 class="member-card-title" id="member-rewards-title">
                  {memberStatusCopy.rewards.heading}
                </h2>
              </div>
              {dashboardView.rewards.length === 0 ? (
                <div class="member-well member-rewards-empty">
                  <p>{memberStatusCopy.rewards.empty}</p>
                </div>
              ) : (
                <ul class="member-rewards">
                  {/* Each row carries its state's whole key: the icon, the
                      word and the plain explanation. */}
                  {dashboardView.rewards.map((reward) => (
                    <li
                      class="member-reward"
                      data-reward-state={reward.stateKey}
                      data-reward-key={reward.stateKey}
                    >
                      <span class="member-reward__kind">{reward.label}</span>
                      <span
                        class:list={[
                          'member-reward__state',
                          `member-reward__state--${reward.stateKey}`,
                        ]}
                      >
                        <Icon name={rewardIcon[reward.stateKey]} size="sm" />
                        {reward.state}
                      </span>
                      <span class="member-reward__tier">{reward.tier}</span>
                      <p class="member-reward__why">
                        {memberStatusCopy.rewards.explanations[reward.stateKey]}
                      </p>
                    </li>
                  ))}
                </ul>
              )}
            </Card>

            <Card
              class="member-card member-main"
              data-member-card="preferences"
              aria-labelledby="member-preferences-title"
              data-reveal
            >
              <h2 class="member-card-title" id="member-preferences-title">
                {memberStatusCopy.preferences.heading}
              </h2>
              <form
                action="/api/me/marketing"
                class="member-pref member-marketing"
                data-marketing-form
                data-saved-message={memberStatusCopy.marketing.saved}
                data-unavailable-message={
                  memberStatusCopy.marketing.unavailable
                }
                method="post"
              >
                <h3>{memberStatusCopy.marketing.heading}</h3>
                <div class="member-pref-switch">
                  <p>{memberStatusCopy.marketing.wording}</p>
                  <div class="member-switch-row">
                    {/* Still the submit button posting the existing route;
                        drawn as the component library's switch. Its name is
                        the action, and only the current one is ever in the
                        page (E11.5-11r decision 4). */}
                    <button
                      class="member-switch"
                      data-marketing-switch
                      data-switch-state={marketingEnabled ? 'on' : 'off'}
                      name="marketing"
                      role="switch"
                      aria-checked={marketingEnabled ? 'true' : 'false'}
                      type="submit"
                      value={marketingEnabled ? 'off' : 'on'}
                    >
                      <span class="member-switch__track">
                        <span class="member-switch__knob">
                          <Icon name="check" size="sm" />
                        </span>
                      </span>
                      <span class="member-switch__label">
                        {marketingEnabled
                          ? memberStatusCopy.marketing.turnOff
                          : memberStatusCopy.marketing.turnOn}
                      </span>
                    </button>
                    <span
                      class="member-switch__words"
                      aria-hidden="true"
                      data-marketing-words
                      data-next-word={
                        marketingEnabled
                          ? memberStatusCopy.marketing.disabled
                          : memberStatusCopy.marketing.enabled
                      }
                    >
                      <span class="member-switch__word" data-marketing-state>
                        {marketingEnabled
                          ? memberStatusCopy.marketing.enabled
                          : memberStatusCopy.marketing.disabled}
                      </span>
                    </span>
                  </div>
                </div>
                <input name="t" type="hidden" value={token} />
                <noscript>
                  <div class="member-notice member-notice--info member-pref__notice">
                    <Icon name="info" size="base" />
                    <p>{memberStatusCopy.marketing.javaScriptRequired}</p>
                  </div>
                </noscript>
                <div
                  class="member-notice member-pref__notice member-result"
                  data-marketing-result
                  tabindex="-1"
                >
                  <Icon
                    name="check-circle"
                    size="base"
                    class="member-result__icon member-result__icon--success"
                  />
                  <Icon
                    name="alert-circle"
                    size="base"
                    class="member-result__icon member-result__icon--error"
                  />
                  <p aria-live="polite" data-marketing-status />
                </div>
                <div
                  class="cf-turnstile"
                  data-sitekey={config.turnstileSiteKey}
                  data-size="compact"
                  data-appearance="interaction-only"
                  data-response-field-name="turnstile_token"
                />
              </form>

              {surveyEnabled ? (
                <div class="member-pref member-pref--survey">
                  <Accordion
                    class="member-survey"
                    summary={memberStatusCopy.survey.heading}
                  >
                    <form
                      action="/api/survey"
                      class="member-survey-form"
                      data-survey-form
                      data-unavailable-message={surveyCopy.unavailable}
                      method="post"
                    >
                      <input name="token" type="hidden" value={token} />
                      <input
                        name="version"
                        type="hidden"
                        value={currentSurveyVersion}
                      />
                      <fieldset class="member-question">
                        <legend>{verificationCopy.survey.categoryLabel}</legend>
                        <div class="member-chips">
                          {verificationCopy.survey.categoryOptions.map(
                            (option) => (
                              <label class="member-choice">
                                <input
                                  name="category_preference"
                                  type="checkbox"
                                  value={option.value}
                                />
                                <span class="member-chip">
                                  <Icon
                                    name="check"
                                    size="sm"
                                    class="member-option__check"
                                  />
                                  <span>{option.label}</span>
                                </span>
                              </label>
                            ),
                          )}
                        </div>
                      </fieldset>
                      <fieldset class="member-question">
                        <legend>
                          {verificationCopy.survey.frequencyLabel}
                        </legend>
                        <div class="member-segments">
                          {verificationCopy.survey.frequencyOptions.map(
                            (option) => (
                              <label class="member-choice">
                                <input
                                  name="shopping_frequency"
                                  type="radio"
                                  value={option.value}
                                />
                                <span class="member-segment">
                                  <Icon
                                    name="check"
                                    size="sm"
                                    class="member-option__check"
                                  />
                                  <span>{option.label}</span>
                                </span>
                              </label>
                            ),
                          )}
                        </div>
                      </fieldset>
                      <div
                        class="member-notice member-result member-survey__result"
                        data-survey-result
                      >
                        <Icon
                          name="check-circle"
                          size="base"
                          class="member-result__icon member-result__icon--success"
                        />
                        <Icon
                          name="alert-circle"
                          size="base"
                          class="member-result__icon member-result__icon--error"
                        />
                        <p aria-live="polite" data-survey-status />
                      </div>
                      <div class="member-survey__actions">
                        <Button
                          class="member-keep"
                          type="submit"
                          variant="secondary"
                        >
                          {memberStatusCopy.survey.submit}
                        </Button>
                      </div>
                    </form>
                  </Accordion>
                </div>
              ) : null}
              <script
                is:inline
                src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                async
                defer
              />
            </Card>

            <Card
              class="member-card member-side"
              data-member-card="data-rights"
              aria-labelledby="member-data-title"
              data-reveal
              style="--reveal-index: 1"
            >
              <h2 class="member-card-title" id="member-data-title">
                {memberStatusCopy.dataRights.heading}
              </h2>
              <ul class="member-data-links">
                <li>
                  <a href="/dsr?operation=export">
                    <span class="member-tile member-tile--small member-tile--neutral">
                      <Icon name="download" size="base" />
                    </span>
                    <span class="member-data-links__label">
                      {dsrCopy.export.heading}
                    </span>
                    <Icon name="arrow-right" size="sm" class="member-arrow" />
                  </a>
                </li>
                <li>
                  <a href="/dsr?operation=delete">
                    <span class="member-tile member-tile--small member-tile--neutral">
                      <Icon name="erase" size="base" />
                    </span>
                    <span class="member-data-links__label">
                      {dsrCopy.delete.heading}
                    </span>
                    <Icon name="arrow-right" size="sm" class="member-arrow" />
                  </a>
                </li>
              </ul>
            </Card>

            <section
              class="member-leave"
              data-member-card="leave"
              aria-labelledby="member-leave-title"
            >
              <div class="member-leave__text">
                <h2 id="member-leave-title">
                  {memberStatusCopy.leave.heading}
                </h2>
                <p>{memberStatusCopy.leave.body}</p>
              </div>
              <form
                action="/api/me/leave"
                class="member-leave__form"
                data-leave-form
                data-unavailable-message={memberStatusCopy.leave.unavailable}
                method="post"
              >
                <input name="t" type="hidden" value={token} />
                <Button class="member-keep" type="submit" variant="secondary">
                  {memberStatusCopy.leave.submit}
                </Button>
                <div
                  class="cf-turnstile"
                  data-sitekey={config.turnstileSiteKey}
                  data-size="compact"
                  data-appearance="interaction-only"
                  data-response-field-name="turnstile_token"
                />
                <noscript>
                  <div class="member-notice member-notice--info">
                    <Icon name="info" size="base" />
                    <p>{memberStatusCopy.leave.javaScriptRequired}</p>
                  </div>
                </noscript>
                <div class="member-notice member-result" data-leave-result>
                  <Icon
                    name="check-circle"
                    size="base"
                    class="member-result__icon member-result__icon--success"
                  />
                  <Icon
                    name="alert-circle"
                    size="base"
                    class="member-result__icon member-result__icon--error"
                  />
                  <p aria-live="polite" data-leave-status />
                </div>
              </form>
            </section>
          </div>
        ) : authentication.kind === 'disabled' ? (
          <div class="member-task">
            <Card
              class="member-boundary member-task__card"
              data-member-state="disabled"
              aria-labelledby="member-title"
            >
              <div class="member-task__head">
                <span class="member-tile member-tile--task member-tile--neutral">
                  <Icon name="alert" />
                </span>
                <h1 id="member-title">{memberStatusCopy.disabled.heading}</h1>
              </div>
              <p class="member-task__line">{memberStatusCopy.disabled.body}</p>
            </Card>
          </div>
        ) : (
          <div class="member-task">
            <Card
              class="member-boundary member-task__card"
              data-member-state="recovery"
              aria-labelledby="member-title"
            >
              <div class="member-task__head">
                <span class="member-tile member-tile--task member-tile--neutral">
                  <Icon name="refresh" />
                </span>
                <h1 id="member-title">{memberStatusCopy.recovery.heading}</h1>
              </div>
              <p class="member-task__line">{memberStatusCopy.recovery.body}</p>
              {replacementRequested ? (
                <div
                  class="member-notice member-notice--success member-task__notice"
                  role="status"
                >
                  <Icon name="check-circle" size="base" />
                  <p>{memberStatusCopy.recovery.sent}</p>
                </div>
              ) : null}
              {challengeFailed ? (
                <div
                  class="member-notice member-notice--error member-task__notice"
                  role="alert"
                >
                  <Icon name="alert-circle" size="base" />
                  <p>{memberStatusCopy.recovery.challengeFailed}</p>
                </div>
              ) : null}
              {!replacementRequested ? (
                <form method="post" class="member-recovery">
                  <noscript>
                    <div class="member-notice member-notice--info member-task__notice">
                      <Icon name="info" size="base" />
                      <p>{memberStatusCopy.recovery.javaScriptRequired}</p>
                    </div>
                  </noscript>
                  <div class="member-task__actions">
                    <Button type="submit">
                      {memberStatusCopy.recovery.submit}
                    </Button>
                  </div>
                  <div
                    class="cf-turnstile"
                    data-sitekey={config.turnstileSiteKey}
                    data-size="compact"
                    data-appearance="interaction-only"
                    data-response-field-name="turnstile_token"
                  />
                </form>
              ) : null}
              {!replacementRequested ? (
                <script
                  is:inline
                  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                  async
                  defer
                />
              ) : null}
            </Card>
          </div>
        )
      }
    </Container>
  </div>
</BaseLayout>

<script is:inline>
  // A duration token, read from the root so the hold stays in tokens.css.
  const durationToken = (name) => {
    if (typeof getComputedStyle !== 'function') return 0;
    const value = getComputedStyle(document.documentElement)
      .getPropertyValue(name)
      .trim();
    const amount =
      Number.parseFloat(value) * (/(?<!m)s$/u.test(value) ? 1000 : 1);
    return Number.isFinite(amount) ? amount : 0;
  };

  // Copy link behaves as on /verify (E11.5-11q decision 3): the label
  // cross-fades to the copied line and back after --copy-confirm-hold; the
  // live region announces it, shown only when the copy fails.
  const referralLink = document.querySelector('[data-referral-link]');
  const copyButton = document.querySelector('[data-copy-referral]');
  const copyResult = document.querySelector('[data-copy-result]');
  const copyStatus = document.querySelector('[data-copy-status]');
  if (
    referralLink instanceof HTMLElement &&
    copyButton instanceof HTMLButtonElement &&
    copyResult instanceof HTMLElement &&
    copyStatus instanceof HTMLElement
  ) {
    const referralUrl = referralLink.dataset.referralUrl ?? '';
    let copiedTimer;
    copyButton.addEventListener('click', async () => {
      globalThis.clearTimeout(copiedTimer);
      copyStatus.textContent = '';
      copyResult.dataset.copyResult = '';
      referralLink.dataset.selected = '';
      try {
        await navigator.clipboard.writeText(referralUrl);
        copyButton.dataset.copyState = 'copied';
        copyResult.dataset.copyResult = 'copied';
        copyStatus.textContent = copyButton.dataset.copied ?? '';
        copiedTimer = globalThis.setTimeout(() => {
          copyButton.dataset.copyState = '';
          copyResult.dataset.copyResult = '';
          copyStatus.textContent = '';
        }, durationToken('--copy-confirm-hold'));
      } catch {
        copyButton.dataset.copyState = '';
        const selection = globalThis.getSelection?.();
        selection?.selectAllChildren(referralLink);
        referralLink.dataset.selected = 'true';
        copyResult.dataset.copyResult = 'failed';
        copyStatus.textContent = copyButton.dataset.copyFailed ?? '';
      }
    });
    const shareHost = document.querySelector('[data-share-host]');
    const shareTemplate = shareHost?.querySelector('[data-share-template]');
    if (
      shareHost instanceof HTMLElement &&
      shareTemplate instanceof HTMLTemplateElement &&
      typeof navigator.share === 'function'
    ) {
      const share = shareTemplate.content.cloneNode(true);
      const shareButton = share.querySelector('button');
      shareButton?.addEventListener('click', () => {
        void navigator
          .share({ title: shareHost.dataset.shareTitle, url: referralUrl })
          .catch(() => {});
      });
      shareHost.append(share);
    }
  }

  const surveyForm = document.querySelector('[data-survey-form]');
  if (surveyForm instanceof HTMLFormElement) {
    surveyForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = surveyForm.querySelector('[type="submit"]');
      const result = surveyForm.querySelector('[data-survey-result]');
      const status = surveyForm.querySelector('[data-survey-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(result instanceof HTMLElement) ||
        !(status instanceof HTMLElement)
      )
        return;

      submit.disabled = true;
      result.dataset.result = '';
      let tone = 'error';
      try {
        const response = await fetch(surveyForm.action, {
          body: new FormData(surveyForm),
          method: 'POST',
        });
        const payload = await response.json();
        if (response.ok) tone = 'success';
        status.textContent = response.ok
          ? payload.message
          : (payload.error?.message ?? surveyForm.dataset.unavailableMessage);
      } catch {
        status.textContent = surveyForm.dataset.unavailableMessage ?? '';
      } finally {
        result.dataset.result = tone;
        submit.disabled = false;
      }
    });
  }

  // The marketing switch posts the existing route with the same fields and
  // Turnstile token. Its knob slides and its word cross-fades as it submits;
  // a success reloads with #marketing-saved, and the reloaded page shows the
  // saved notice, focuses it and drops the fragment. An error puts the switch
  // back and shows the route's message (E11.5-11r decision 4).
  const marketingForm = document.querySelector('[data-marketing-form]');
  const marketingSwitch = marketingForm?.querySelector(
    '[data-marketing-switch]',
  );
  const marketingResult = marketingForm?.querySelector(
    '[data-marketing-result]',
  );
  const marketingStatus = marketingForm?.querySelector(
    '[data-marketing-status]',
  );
  const marketingWords = marketingForm?.querySelector('[data-marketing-words]');
  if (
    marketingForm instanceof HTMLFormElement &&
    marketingSwitch instanceof HTMLButtonElement &&
    marketingResult instanceof HTMLElement &&
    marketingStatus instanceof HTMLElement &&
    marketingWords instanceof HTMLElement
  ) {
    // The fragment is set and cleared without reading the query: a
    // fragment-only URL resolves against the current one, and clearing
    // copies the whole URL and blanks only its fragment.
    const savedFragment = '#marketing-saved';
    if (globalThis.location.hash === savedFragment) {
      const unsaved = new URL(document.URL);
      unsaved.hash = '';
      globalThis.history.replaceState(globalThis.history.state, '', unsaved);
      marketingResult.dataset.result = 'success';
      marketingStatus.textContent = marketingForm.dataset.savedMessage ?? '';
      marketingResult.focus();
    }

    const resting = marketingSwitch.dataset.switchState;
    const requested = resting === 'on' ? 'off' : 'on';
    let nextWord;
    // Shows the switch in a state: the knob, the track, the checked state
    // and the word, which cross-fades with the other one.
    const show = (state) => {
      if (nextWord === undefined) {
        nextWord = document.createElement('span');
        nextWord.className = 'member-switch__word member-switch__word--next';
        nextWord.textContent = marketingWords.dataset.nextWord ?? '';
        marketingWords.append(nextWord);
        // The next word starts transparent, so it fades in from there.
        void nextWord.offsetWidth;
      }
      marketingSwitch.dataset.switchState = state;
      marketingSwitch.setAttribute('aria-checked', String(state === 'on'));
      marketingWords.dataset.word = state === resting ? '' : 'next';
    };

    let pending = false;
    marketingForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (pending) return;
      pending = true;
      marketingResult.dataset.result = '';
      marketingStatus.textContent = '';
      show(requested);
      let message = marketingForm.dataset.unavailableMessage ?? '';
      try {
        const body = new FormData(marketingForm);
        body.set('marketing', marketingSwitch.value);
        const response = await fetch(marketingForm.action, {
          body,
          method: 'POST',
        });
        const payload = await response.json();
        if (response.ok) {
          globalThis.history.replaceState(
            globalThis.history.state,
            '',
            savedFragment,
          );
          globalThis.location.reload();
          return;
        }
        if (typeof payload.error?.message === 'string')
          message = payload.error.message;
      } catch {
        // The unavailable message stands.
      }
      show(resting);
      marketingResult.dataset.result = 'error';
      marketingStatus.textContent = message;
      // A Turnstile token is single-use, so the next attempt needs a new one.
      globalThis.turnstile?.reset?.();
      pending = false;
    });
  }

  const leaveForm = document.querySelector('[data-leave-form]');
  if (leaveForm instanceof HTMLFormElement) {
    leaveForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = leaveForm.querySelector('[type="submit"]');
      const result = leaveForm.querySelector('[data-leave-result]');
      const status = leaveForm.querySelector('[data-leave-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(result instanceof HTMLElement) ||
        !(status instanceof HTMLElement)
      )
        return;
      submit.disabled = true;
      result.dataset.result = '';
      try {
        const response = await fetch(leaveForm.action, {
          body: new FormData(leaveForm),
          method: 'POST',
        });
        const payload = await response.json();
        status.textContent = response.ok
          ? payload.message
          : (payload.error?.message ?? leaveForm.dataset.unavailableMessage);
        result.dataset.result = response.ok ? 'success' : 'error';
        if (!response.ok) submit.disabled = false;
      } catch {
        status.textContent = leaveForm.dataset.unavailableMessage ?? '';
        result.dataset.result = 'error';
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  /*
    /me on the final design (E11.5-11r, Me.dc.html as Me1440, Me768 and
    Me390 place it). The dashboard is the canvas's .vgrid: the status card
    across the grid, then the referral and preferences cards in columns 1–7
    beside the rewards and data cards in columns 8–12 from 64rem, then
    "Leave the waitlist" set apart below. The recovery, left and unavailable
    states are the task card: columns 1–7 from 64rem, at most 40rem from
    48rem. The page takes back the shell's main padding, as /verify does, so
    the content sits on the canvas's gutters 32, 48 or 64px below the header.
  */
  .member-page {
    margin-inline: calc(-1 * var(--space-3));
    margin-block-start: calc(-1 * var(--space-4));
  }

  :global(.member-container) {
    padding-block-start: var(--space-4);
  }

  h1,
  h2,
  h3,
  p,
  dl,
  dd,
  ul {
    margin: 0;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  h1 {
    font-size: var(--step-5);
    font-weight: var(--weight-bold);
    line-height: var(--leading-5);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .member-card-title,
  .member-leave h2 {
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-3);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  /* Tiles: 40 (card heads), 36 (data links), 48 (task cards). */
  .member-tile {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--tile-size);
    block-size: var(--tile-size);
    color: var(--ink);
    background-color: var(--coral-tint);
    border-radius: var(--radius-control);
  }

  .member-tile--neutral {
    background-color: var(--wash);
  }

  .member-tile--task {
    inline-size: var(--space-6);
    block-size: var(--space-6);
  }

  .member-tile--small {
    inline-size: calc(var(--space-4) + var(--space-0-5));
    block-size: calc(var(--space-4) + var(--space-0-5));
  }

  /* Notices (E11.5-11j): 16px padding, radius 8, a 12px gap between the
     20px icon and the 14/20 500 text. */
  .member-notice {
    display: flex;
    gap: var(--space-1-5);
    align-items: flex-start;
    padding: var(--space-2);
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
    background-color: var(--surface);
    border-radius: var(--radius-control);
    box-shadow: var(--inset-line), var(--edge);
  }

  .member-notice p {
    text-wrap: pretty;
  }

  .member-notice :global(.icon) {
    flex: none;
    color: var(--ink-600);
  }

  .member-notice--info {
    background-color: var(--wash);
    box-shadow: none;
  }

  .member-notice--success :global(.icon),
  .member-result[data-result='success'] :global(.member-result__icon--success) {
    color: var(--success-icon);
  }

  .member-notice--error,
  .member-result[data-result='error'] {
    box-shadow: var(--inset-error);
  }

  .member-notice--error :global(.icon),
  .member-result[data-result='error'] :global(.member-result__icon--error) {
    color: var(--error);
  }

  @media (forced-colors: active) {
    .member-notice {
      outline: var(--border-thin) solid currentColor;
      outline-offset: calc(var(--border-thin) * -1);
    }
  }

  /* A result notice speaks through its live region, and is clipped to
     nothing on screen until it has something to show. */
  .member-result :global(.member-result__icon) {
    display: none;
  }

  .member-result[data-result='success'] :global(.member-result__icon--success),
  .member-result[data-result='error'] :global(.member-result__icon--error) {
    display: block;
  }

  .member-result:not([data-result='success'], [data-result='error']),
  .member-copy-result:not([data-copy-result='failed']) {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .member-result:focus {
    outline: none;
  }

  .member-result:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  /* The clipped regions are boxed inside their card or form. */
  .member-grid :global(.card),
  .member-leave__form {
    position: relative;
  }

  /* The board's secondary buttons keep their 48px size and 16/24 label at
     every width (its .btn--keep), padded 24 like every .btn on the board. */
  .member-page :global(.member-keep) {
    min-block-size: var(--control-height);
    padding-inline: var(--space-3);
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }

  .cf-turnstile:empty {
    display: none;
  }

  /* ---- the task card: recovery, left and unavailable ---- */
  .member-task {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .member-task :global(.member-task__card) {
    box-sizing: border-box;
    padding: var(--space-3);
  }

  .member-task__head {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .member-task__head h1 {
    padding-block-start: var(--space-0-5);
    overflow-wrap: anywhere;
  }

  .member-task__line {
    margin-block-start: var(--space-2);
    color: var(--ink-600);
    font-size: var(--step-2);
    line-height: var(--leading-2);
    text-wrap: pretty;
  }

  .member-task__notice {
    margin-block-start: var(--space-3);
  }

  .member-recovery {
    display: flex;
    flex-direction: column;
  }

  .member-task__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
    margin-block-start: var(--space-4);
  }

  .member-task__actions :global(.button) {
    inline-size: 100%;
    white-space: normal;
  }

  .member-recovery > .cf-turnstile {
    margin-block-start: var(--space-3);
  }

  /* ---- the dashboard ---- */
  .member-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
  }

  .member-grid :global(.member-card) {
    padding: var(--space-3);
  }

  .member-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-inline-size: calc(var(--space-10) * 8);
  }

  .member-head p {
    color: var(--ink-600);
    font-size: var(--step-2);
    line-height: var(--leading-2);
    text-wrap: pretty;
  }

  /* The facts: two columns, three from 48rem, five (six when giveaway
     entries show) from 64rem, each on the well. */
  .member-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }

  /* Below 22.5rem a fact takes the row, so the wave badge fits. */
  @media (width < 22.5rem) {
    .member-facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .member-fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-inline-size: 0;
    padding: var(--space-2);
    background-color: var(--well);
    border-radius: var(--radius-control);
  }

  .member-fact dt {
    color: var(--ink-600);
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-0);
  }

  .member-fact dd {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    min-block-size: var(--space-4);
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-3);
  }

  .member-fact dd :global(.icon) {
    color: var(--success-icon);
  }

  .member-fact .member-fact__muted {
    color: var(--ink-600);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
  }

  /* The access-wave badge: four bars rising left to right, filled in coral
     up to the member's wave, then the wave in mono. */
  .member-wave {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
    block-size: var(--space-4);
    padding-inline: var(--space-1) var(--space-1-5);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-0);
    white-space: nowrap;
    background-color: var(--coral-tint);
    border-radius: var(--radius-pill);
  }

  .member-wave__bars {
    display: inline-flex;
    gap: var(--wave-bar-gap);
    align-items: flex-end;
    block-size: var(--space-1-75);
  }

  .member-wave__bars i {
    display: block;
    inline-size: var(--wave-bar-width);
    background-color: var(--ink-300);
    border-radius: var(--wave-bar-radius);
  }

  .member-wave__bars i:nth-child(1) {
    block-size: var(--space-0-75);
  }

  .member-wave__bars i:nth-child(2) {
    block-size: calc(var(--space-0-75) * 1.5);
  }

  .member-wave__bars i:nth-child(3) {
    block-size: var(--space-1-5);
  }

  .member-wave__bars i:nth-child(4) {
    block-size: var(--space-1-75);
  }

  .member-wave__bars i.is-on {
    background-color: var(--coral);
  }

  .member-card-head {
    display: flex;
    gap: var(--space-1-5);
    align-items: center;
  }

  .member-card-head h2 {
    min-inline-size: 0;
  }

  /* ---- the referral card ---- */
  .member-ref-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
    margin-block-start: var(--space-1);
  }

  .member-linkbox {
    box-sizing: border-box;
    min-inline-size: 0;
    min-block-size: var(--control-height);
    padding: var(--space-1-75) var(--space-2);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
    overflow-wrap: anywhere;
    background-color: var(--well);
    border-radius: var(--radius-control);
    box-shadow: var(--inset-line);
    user-select: all;
  }

  .member-linkbox[data-selected='true'] {
    background-color: var(--wash-strong);
    box-shadow: var(--inset-selected);
  }

  .member-linkbox__code {
    font-weight: var(--weight-semibold);
  }

  .member-ref-row :global(.button) {
    inline-size: 100%;
  }

  /* Copy referral link: the idle and copied faces share one cell, so the
     button keeps its size while the label cross-fades. */
  .member-copy__faces {
    display: grid;
  }

  .member-copy__face {
    display: inline-flex;
    grid-area: 1 / 1;
    gap: var(--space-1);
    align-items: center;
    justify-content: center;
    transition-property: opacity;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .member-copy__face--done,
  :global(.member-copy[data-copy-state='copied'])
    .member-copy__face:not(.member-copy__face--done) {
    opacity: 0;
  }

  :global(.member-copy[data-copy-state='copied']) .member-copy__face--done {
    opacity: 1;
  }

  .member-copy-result {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    min-block-size: var(--space-3);
    margin-block-start: var(--space-1);
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
  }

  .member-copy-result :global(.icon) {
    color: var(--ink-600);
  }

  .member-share:has(.button) {
    margin-block-start: var(--space-1);
  }

  .member-well {
    padding: var(--space-2);
    background-color: var(--well);
    border-radius: var(--radius-control);
  }

  .member-meter {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-block-start: var(--space-3);
  }

  .member-meter__top {
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
    justify-content: flex-end;
  }

  .member-meter__value {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-1);
  }

  /* The native meter stays for assistive technology; the drawn track is
     its picture, one segment per referral the tier needs. */
  .member-meter__native {
    position: absolute;
    overflow: hidden;
    inline-size: var(--border-thin);
    block-size: var(--border-thin);
    clip-path: inset(50%);
  }

  .member-meter__track {
    display: grid;
    grid-auto-columns: minmax(0, 1fr);
    grid-auto-flow: column;
    gap: var(--space-0-5);
  }

  .member-meter__segment {
    display: block;
    overflow: hidden;
    block-size: var(--space-1);
    background-color: var(--wash-strong);
    border-radius: var(--radius-pill);
  }

  .member-meter__fill {
    display: block;
    block-size: 100%;
    background-color: var(--ink);
    transform-origin: left;
  }

  /* ---- the rewards card ---- */
  .member-rewards {
    margin-block-start: var(--space-1);
  }

  .member-rewards-empty {
    margin-block-start: var(--space-2);
  }

  .member-rewards-empty p {
    color: var(--ink-600);
    font-size: var(--step-1);
    line-height: var(--leading-1);
    text-wrap: pretty;
  }

  .member-reward {
    display: grid;
    font-size: var(--step-2);
    line-height: var(--leading-2);
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-0-5) var(--space-2);
    align-items: center;
    padding-block: var(--space-2);
  }

  .member-reward + .member-reward {
    border-block-start: var(--border-thin) solid var(--line);
  }

  .member-reward__kind {
    font-weight: var(--weight-semibold);
  }

  .member-reward__tier {
    color: var(--ink-600);
    font-family: var(--font-mono);
    font-size: var(--step-0);
    line-height: var(--leading-0);
  }

  .member-reward__why {
    grid-column: 1 / -1;
    color: var(--ink-600);
