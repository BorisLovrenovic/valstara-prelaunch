---
import { memberStatusCopy } from '../copy/member-status.ts';
import { surveyCopy } from '../copy/survey.ts';
import { verificationCopy } from '../copy/verification.ts';
import Accordion from '../components/accordion.astro';
import Button from '../components/button.astro';
import Card from '../components/card.astro';
import Container from '../components/container.astro';
import Icon from '../components/icon.astro';
import Input from '../components/input.astro';
import Pill from '../components/pill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConfig } from '../server/config.ts';
import { createPool } from '../server/db/pool.ts';
import { createUnsubscribeRepository } from '../server/db/unsubscribe.ts';
import { getFlagService } from '../server/flags/app-service.ts';
import { createReferralService } from '../server/referral/service.ts';
import { presentReferralStatus } from '../server/referral/status-presentation.ts';
import { verificationReferralFigures } from '../server/referral/verification-presentation.ts';
import { dsrCopy } from '../copy/dsr.ts';
import { createMarketingService } from '../server/subscriber/marketing.ts';
import type { ReferralStatus } from '../server/referral/status.ts';
import { hashedIpPrefix } from '../server/ratelimit/ip-prefix.ts';
import { currentSurveyVersion } from '../server/survey/questions.ts';
import { verifyTurnstileToken } from '../server/turnstile/verify.ts';
import {
  createStatusLinkRecoveryBoundary,
  createStatusLinkService,
  type StatusLinkAuthentication,
} from '../server/verification/status-link.ts';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const config = getConfig();
const flags = getFlagService();
let authentication: StatusLinkAuthentication = { kind: 'rejected' };
let dashboardStatus: ReferralStatus | null = null;
let replacementRequested = false;
let challengeFailed = false;
let surveyEnabled = false;
let marketingEnabled = false;
let leftWaitlist = false;
const token = Astro.url.searchParams.get('t') ?? '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData().catch(() => new FormData());
  const submittedChallenge = formData.get('turnstile_token');
  const recovery = await createStatusLinkRecoveryBoundary({
    verifyTurnstile: verifyTurnstileToken,
    async recover(challengeTimedOut) {
      // Construct every stateful dependency only after Turnstile has returned
      // a verified or provider-unavailable outcome.
      const database = createPool(config.databaseUrl);
      try {
        const prefixHash = hashedIpPrefix(
          Astro.clientAddress,
          config.ipPrefixPepper,
        );
        return await createStatusLinkService(database, {
          flags,
        }).requestReplacement({
          challengeTimedOut,
          ipPrefixHash: prefixHash ?? '',
          token,
        });
      } finally {
        await database.close();
      }
    },
  })(typeof submittedChallenge === 'string' ? submittedChallenge : '');

  if (recovery === 'challenge_failed') {
    Astro.response.status = 400;
    challengeFailed = true;
  } else if (recovery === 'disabled') {
    authentication = { kind: 'disabled' };
  } else {
    replacementRequested = true;
  }
} else {
  const database = createPool(config.databaseUrl);
  try {
    const statusLinks = createStatusLinkService(database, {
      flags,
    });
    authentication = await statusLinks.authenticate(token);
    if (authentication.kind === 'authenticated') {
      const subject = await createUnsubscribeRepository(database).statusSubject(
        authentication.subscriberId,
      );
      if (subject?.status === 'unsubscribed') {
        leftWaitlist = true;
      } else if (subject?.status !== 'verified') {
        authentication = { kind: 'rejected' };
      } else {
        [dashboardStatus, surveyEnabled, marketingEnabled] = await Promise.all([
          createReferralService(database).status(authentication.subscriberId),
          flags.isEnabled('survey.enabled'),
          createMarketingService(database, { flags }).preference(
            authentication.subscriberId,
          ),
        ]);
      }
    }
  } finally {
    await database.close();
  }
}
const dashboardView =
  dashboardStatus === null ? null : presentReferralStatus(dashboardStatus);
// Every card reads its figures from the one shared status presentation; the
// keys only decide which card a field sits on.
const dashboardFields =
  dashboardView === null
    ? null
    : new Map(dashboardView.fields.map((field) => [field.key, field]));
type DashboardField = NonNullable<typeof dashboardView>['fields'][number];
const placedFields = (keys: readonly DashboardField['key'][]) =>
  keys.flatMap((key) => dashboardFields?.get(key) ?? []);
const statusFields = placedFields([
  'subscriberStatus',
  'accessWindow',
  'ownRank',
]);
const referralFields = placedFields(['confirmedReferrals', 'tier']);
const entriesField =
  dashboardStatus !== null && dashboardStatus.giveawayEntries > 0
    ? (dashboardFields?.get('giveawayEntries') ?? null)
    : null;
const ladderFigures =
  dashboardStatus === null
    ? null
    : verificationReferralFigures(dashboardStatus).ladder;
const accessWindow = dashboardStatus?.accessWindow ?? null;
// Held and settled differ by icon, label and outline, never by colour alone.
const rewardStates = ['settled', 'held'] as const;
const rewardIcon = { held: 'clock', settled: 'check' } as const;
---

<BaseLayout
  title={memberStatusCopy.meta.title}
  description={memberStatusCopy.meta.description}
>
  <Container class="member-container">
    {
      authentication.kind === 'authenticated' && leftWaitlist ? (
        <Card class="member-boundary" data-member-state="left">
          <Icon name="check" size="lg" />
          <h1>{memberStatusCopy.left.heading}</h1>
          <p>{memberStatusCopy.left.body}</p>
        </Card>
      ) : authentication.kind === 'authenticated' && dashboardView !== null ? (
        <div class="member-dashboard" data-member-dashboard>
          <div class="member-column">
            <Card class="member-card" data-member-card="status">
              <div class="member-heading">
                <Icon name="check" size="lg" />
                <div>
                  <h1>{memberStatusCopy.authenticated.heading}</h1>
                  <p>{memberStatusCopy.authenticated.body}</p>
                </div>
              </div>
              <dl class="member-stats">
                {statusFields.map((field) => (
                  <div class="member-stat" data-member-field={field.key}>
                    <dt>{field.label}</dt>
                    {field.key === 'accessWindow' && accessWindow !== null ? (
                      <dd>
                        <Pill variant="badge" data-access-wave>
                          <data value={field.value}>
                            {memberStatusCopy.authenticated.waveBadge(
                              accessWindow,
                            )}
                          </data>
                        </Pill>
                      </dd>
                    ) : (
                      <dd class:list={[field.tabular && 'tabular-figure']}>
                        {field.value}
                      </dd>
                    )}
                  </div>
                ))}
              </dl>
            </Card>

            <Card class="member-card" data-member-card="referral">
              <h2>{memberStatusCopy.referral.heading}</h2>
              <div class="member-link-control">
                <Input
                  aria-label={memberStatusCopy.referral.linkLabel}
                  data-referral-link
                  readonly
                  type="url"
                  value={dashboardView.referralLink}
                />
                <Button
                  data-copy-failed={memberStatusCopy.referral.copyFailed}
                  data-copy-referral
                  data-copied={memberStatusCopy.referral.copied}
                >
                  {memberStatusCopy.referral.copy}
                </Button>
                <span
                  data-share-host
                  data-share-label={memberStatusCopy.referral.share}
                  data-share-title={memberStatusCopy.referral.heading}
                />
              </div>
              <p aria-live="polite" data-copy-status />
              <dl class="member-stats">
                {referralFields.map((field) => (
                  <div class="member-stat" data-member-field={field.key}>
                    <dt>{field.label}</dt>
                    <dd class="member-figure tabular-figure">{field.value}</dd>
                  </div>
                ))}
              </dl>
              {ladderFigures !== null ? (
                <div class="member-progress">
                  <label class="tabular-figure" for="member-referral-progress">
                    {memberStatusCopy.referral.progress(
                      ladderFigures.progress,
                      ladderFigures.threshold,
                      ladderFigures.tier,
                    )}
                  </label>
                  <progress
                    id="member-referral-progress"
                    data-referral-progress
                    value={ladderFigures.progress}
                    max={ladderFigures.threshold}
                  />
                </div>
              ) : null}
            </Card>

            <Card class="member-card" data-member-card="rewards">
              <h2>{memberStatusCopy.rewards.heading}</h2>
              <ul class="member-reward-key">
                {rewardStates.map((state) => (
                  <li data-reward-key={state}>
                    <Icon name={rewardIcon[state]} />
                    <span>
                      <strong>{memberStatusCopy.rewards.states[state]}</strong>
                      <span>
                        {memberStatusCopy.rewards.explanations[state]}
                      </span>
                    </span>
                  </li>
                ))}
              </ul>
              {dashboardView.rewards.length === 0 ? (
                <p>{memberStatusCopy.rewards.empty}</p>
              ) : (
                <ul class="member-rewards">
                  {dashboardView.rewards.map((reward) => (
                    <li
                      class="member-reward"
                      data-reward-state={reward.stateKey}
                    >
                      <span class="member-reward__name">
                        <span>{reward.label}</span>
                        <span class="member-reward__tier">{reward.tier}</span>
                      </span>
                      <strong
                        class:list={[
                          'member-reward__state',
                          `member-reward__state--${reward.stateKey}`,
                        ]}
                      >
                        <Icon name={rewardIcon[reward.stateKey]} size="sm" />
                        {reward.state}
                      </strong>
                    </li>
                  ))}
                </ul>
              )}
            </Card>

            {entriesField !== null ? (
              <Card class="member-card" data-member-card="entries">
                <dl class="member-stats">
                  <div class="member-stat" data-member-field={entriesField.key}>
                    <dt>{entriesField.label}</dt>
                    <dd class="member-figure tabular-figure">
                      {entriesField.value}
                    </dd>
                  </div>
                </dl>
              </Card>
            ) : null}
          </div>

          <div class="member-column">
            <Card class="member-card" data-member-card="preferences">
              <h2>{memberStatusCopy.preferences.heading}</h2>
              <form
                action="/api/me/marketing"
                class="member-marketing"
                data-marketing-form
                data-unavailable-message={
                  memberStatusCopy.marketing.unavailable
                }
                method="post"
              >
                <div class="member-switch-row">
                  <h3>{memberStatusCopy.marketing.heading}</h3>
                  <Pill data-marketing-state>
                    {marketingEnabled
                      ? memberStatusCopy.marketing.enabled
                      : memberStatusCopy.marketing.disabled}
                  </Pill>
                </div>
                {!marketingEnabled ? (
                  <p>{memberStatusCopy.marketing.wording}</p>
                ) : null}
                <input name="t" type="hidden" value={token} />
                <div
                  class="cf-turnstile"
                  data-sitekey={config.turnstileSiteKey}
                  data-size="compact"
                  data-response-field-name="turnstile_token"
                />
                <noscript>
                  <p>{memberStatusCopy.marketing.javaScriptRequired}</p>
                </noscript>
                <button
                  class:list={[
                    'member-switch',
                    marketingEnabled && 'member-switch--on',
                  ]}
                  data-marketing-switch
                  name="marketing"
                  type="submit"
                  value={marketingEnabled ? 'off' : 'on'}
                >
                  <span class="member-switch__track">
                    <span class="member-switch__thumb" />
                  </span>
                  <span>
                    {marketingEnabled
                      ? memberStatusCopy.marketing.turnOff
                      : memberStatusCopy.marketing.turnOn}
                  </span>
                </button>
                <p aria-live="polite" data-marketing-status />
              </form>

              {surveyEnabled ? (
                <Accordion
                  class="member-survey"
                  summary={memberStatusCopy.survey.heading}
                >
                  <form
                    action="/api/survey"
                    class="member-survey-form"
                    data-survey-form
                    data-unavailable-message={surveyCopy.unavailable}
                    method="post"
                  >
                    <input name="token" type="hidden" value={token} />
                    <input
                      name="version"
                      type="hidden"
                      value={currentSurveyVersion}
                    />
                    <fieldset>
                      <legend>{verificationCopy.survey.categoryLabel}</legend>
                      <div class="member-options member-options--chips">
                        {verificationCopy.survey.categoryOptions.map(
                          (option) => (
                            <label>
                              <input
                                name="category_preference"
                                type="checkbox"
                                value={option.value}
                              />
                              <span>{option.label}</span>
                            </label>
                          ),
                        )}
                      </div>
                    </fieldset>
                    <fieldset>
                      <legend>{verificationCopy.survey.frequencyLabel}</legend>
                      <div class="member-options member-options--segments">
                        {verificationCopy.survey.frequencyOptions.map(
                          (option) => (
                            <label>
                              <input
                                name="shopping_frequency"
                                type="radio"
                                value={option.value}
                              />
                              <span>{option.label}</span>
                            </label>
                          ),
                        )}
                      </div>
                    </fieldset>
                    <Button type="submit" variant="secondary">
                      {memberStatusCopy.survey.submit}
                    </Button>
                    <p aria-live="polite" data-survey-status />
                  </form>
                </Accordion>
              ) : null}
              <script
                is:inline
                src="https://challenges.cloudflare.com/turnstile/v0/api.js"
                async
                defer
              />
            </Card>

            <Card class="member-card" data-member-card="data-rights">
              <h2>{memberStatusCopy.dataRights.heading}</h2>
              <ul class="member-links">
                <li>
                  <a href="/dsr?operation=export">
                    {dsrCopy.export.heading}
                    <Icon name="arrow-right" size="sm" />
                  </a>
                </li>
                <li>
                  <a href="/dsr?operation=delete">
                    {dsrCopy.delete.heading}
                    <Icon name="arrow-right" size="sm" />
                  </a>
                </li>
              </ul>
            </Card>

            <section class="member-leave" data-member-card="leave">
              <h2>{memberStatusCopy.leave.heading}</h2>
              <p>{memberStatusCopy.leave.body}</p>
              <form
                action="/api/me/leave"
                data-leave-form
                data-unavailable-message={memberStatusCopy.leave.unavailable}
                method="post"
              >
                <input name="t" type="hidden" value={token} />
                <div
                  class="cf-turnstile"
                  data-sitekey={config.turnstileSiteKey}
                  data-size="compact"
                  data-response-field-name="turnstile_token"
                />
                <noscript>
                  <p>{memberStatusCopy.leave.javaScriptRequired}</p>
                </noscript>
                <Button type="submit" variant="secondary">
                  {memberStatusCopy.leave.submit}
                </Button>
                <p aria-live="polite" data-leave-status />
              </form>
            </section>
          </div>
        </div>
      ) : authentication.kind === 'disabled' ? (
        <Card class="member-boundary" data-member-state="disabled">
          <Icon name="alert" size="lg" />
          <h1>{memberStatusCopy.disabled.heading}</h1>
          <p>{memberStatusCopy.disabled.body}</p>
        </Card>
      ) : (
        <Card class="member-boundary" data-member-state="recovery">
          <Icon name="link" size="lg" />
          <h1>{memberStatusCopy.recovery.heading}</h1>
          <p>
            {replacementRequested
              ? memberStatusCopy.recovery.sent
              : challengeFailed
                ? memberStatusCopy.recovery.challengeFailed
                : memberStatusCopy.recovery.body}
          </p>
          {!replacementRequested ? (
            <form method="post" class="member-recovery">
              <div
                class="cf-turnstile"
                data-sitekey={config.turnstileSiteKey}
                data-size="compact"
                data-response-field-name="turnstile_token"
              />
              <noscript>
                <p>{memberStatusCopy.recovery.javaScriptRequired}</p>
              </noscript>
              <Button type="submit">{memberStatusCopy.recovery.submit}</Button>
            </form>
          ) : null}
          {!replacementRequested ? (
            <script
              is:inline
              src="https://challenges.cloudflare.com/turnstile/v0/api.js"
              async
              defer
            />
          ) : null}
        </Card>
      )
    }
  </Container>
</BaseLayout>

<script is:inline>
  const copyButton = document.querySelector('[data-copy-referral]');
  const referralLink = document.querySelector('[data-referral-link]');
  const copyStatus = document.querySelector('[data-copy-status]');
  if (
    copyButton instanceof HTMLButtonElement &&
    referralLink instanceof HTMLInputElement &&
    copyStatus instanceof HTMLElement
  ) {
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(referralLink.value);
        copyStatus.textContent = copyButton.dataset.copied ?? '';
      } catch {
        referralLink.select();
        copyStatus.textContent = copyButton.dataset.copyFailed ?? '';
      }
    });
    const shareHost = document.querySelector('[data-share-host]');
    if (
      shareHost instanceof HTMLElement &&
      typeof navigator.share === 'function'
    ) {
      const shareButton = document.createElement('button');
      shareButton.type = 'button';
      shareButton.className = 'member-native-share';
      shareButton.textContent = shareHost.dataset.shareLabel ?? '';
      shareButton.addEventListener('click', () => {
        void navigator
          .share({
            title: shareHost.dataset.shareTitle,
            url: referralLink.value,
          })
          .catch(() => {});
      });
      shareHost.append(shareButton);
    }
  }

  const surveyForm = document.querySelector('[data-survey-form]');
  if (surveyForm instanceof HTMLFormElement) {
    surveyForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = surveyForm.querySelector('[type="submit"]');
      const status = surveyForm.querySelector('[data-survey-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      )
        return;

      submit.disabled = true;
      try {
        const response = await fetch(surveyForm.action, {
          body: new FormData(surveyForm),
          method: 'POST',
        });
        const payload = await response.json();
        status.textContent = response.ok
          ? payload.message
          : (payload.error?.message ?? surveyForm.dataset.unavailableMessage);
      } catch {
        status.textContent = surveyForm.dataset.unavailableMessage ?? '';
      } finally {
        submit.disabled = false;
      }
    });
  }

  const marketingForm = document.querySelector('[data-marketing-form]');
  if (marketingForm instanceof HTMLFormElement) {
    marketingForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = marketingForm.querySelector('[type="submit"]');
      const status = marketingForm.querySelector('[data-marketing-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      )
        return;
      submit.disabled = true;
      try {
        const body = new FormData(marketingForm);
        body.set('marketing', submit.value);
        const response = await fetch(marketingForm.action, {
          body,
          method: 'POST',
        });
        const payload = await response.json();
        if (response.ok) {
          window.location.reload();
          return;
        }
        status.textContent = payload.error?.message ?? '';
      } catch {
        status.textContent = marketingForm.dataset.unavailableMessage ?? '';
      } finally {
        submit.disabled = false;
      }
    });
  }

  const leaveForm = document.querySelector('[data-leave-form]');
  if (leaveForm instanceof HTMLFormElement) {
    leaveForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = leaveForm.querySelector('[type="submit"]');
      const status = leaveForm.querySelector('[data-leave-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      )
        return;
      submit.disabled = true;
      try {
        const response = await fetch(leaveForm.action, {
          body: new FormData(leaveForm),
          method: 'POST',
        });
        const payload = await response.json();
        status.textContent = response.ok
          ? payload.message
          : (payload.error?.message ?? leaveForm.dataset.unavailableMessage);
        if (!response.ok) submit.disabled = false;
      } catch {
        status.textContent = leaveForm.dataset.unavailableMessage ?? '';
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  :global(.member-container) {
    padding-block: var(--section-gap);
  }

  .member-dashboard,
  .member-column,
  :global(.member-card),
  :global(.member-boundary),
  .member-marketing,
  .member-survey-form,
  .member-progress,
  .member-leave,
  .member-leave form,
  .member-recovery {
    display: grid;
    gap: var(--space-3);
  }

  .member-dashboard,
  .member-column {
    align-content: start;
  }

  :global(.member-boundary) {
    max-inline-size: var(--measure);
  }

  :global(.member-boundary) :global(.icon),
  :global(.member-heading) :global(.icon) {
    color: var(--coral);
  }

  .member-heading,
  .member-link-control,
  .member-switch-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .member-heading {
    align-items: flex-start;
  }

  /* The heading drops below its icon before it would wrap word by word. */
  .member-heading > div {
    flex: 1 1 calc(var(--space-10) * 2);
    min-inline-size: 0;
  }

  h1,
  h2,
  h3,
  p,
  dl,
  dd,
  ul {
    margin: 0;
  }

  h1 {
    font-size: var(--step-5);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-5);
    letter-spacing: var(--tracking-tight);
  }

  h2 {
    font-size: var(--step-4);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-4);
  }

  h3 {
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-3);
  }

  p,
  legend,
  label,
  li {
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }

  p {
    max-inline-size: var(--measure);
    color: var(--ink-600);
  }

  .member-stats {
    display: grid;
    gap: var(--space-2);
  }

  .member-stat {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    padding: var(--space-2);
    background-color: var(--paper);
    border-radius: var(--radius-control);
  }

  dt {
    color: var(--ink-600);
    font-size: var(--step-1);
    line-height: var(--leading-1);
  }

  dd {
    color: var(--ink);
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-3);
  }

  dd :global(.pill) {
    font-size: var(--step-1);
    line-height: var(--leading-1);
  }

  .member-figure {
    font-size: var(--step-5);
    line-height: var(--leading-5);
  }

  /* The link takes its own line before it would shrink below a usable width. */
  .member-link-control :global(.input) {
    min-inline-size: 0;
    flex: 1 1 calc(var(--space-10) * 2);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .member-link-control :global(.button) {
    flex: none;
  }

  .member-progress label {
    color: var(--ink);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  progress {
    inline-size: 100%;
    block-size: var(--space-2);
    accent-color: var(--coral);
  }

  .member-reward-key,
  .member-rewards,
  .member-links {
    display: grid;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .member-reward-key li {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }

  .member-reward-key li > span {
    display: grid;
    min-inline-size: 0;
  }

  .member-reward-key :global(.icon) {
    color: var(--coral);
  }

  .member-reward-key li > span > span {
    color: var(--ink-600);
  }

  .member-reward {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2);
    border: thin solid var(--line);
    border-radius: var(--radius-control);
  }

