---
import { memberStatusCopy } from '../copy/member-status.ts';
import { surveyCopy } from '../copy/survey.ts';
import { verificationCopy } from '../copy/verification.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConfig } from '../server/config.ts';
import { createPool } from '../server/db/pool.ts';
import { createUnsubscribeRepository } from '../server/db/unsubscribe.ts';
import { getFlagService } from '../server/flags/app-service.ts';
import { createReferralService } from '../server/referral/service.ts';
import { presentReferralStatus } from '../server/referral/status-presentation.ts';
import { dsrCopy } from '../copy/dsr.ts';
import { createMarketingService } from '../server/subscriber/marketing.ts';
import type { ReferralStatus } from '../server/referral/status.ts';
import { hashedIpPrefix } from '../server/ratelimit/ip-prefix.ts';
import { currentSurveyVersion } from '../server/survey/questions.ts';
import { verifyTurnstileToken } from '../server/turnstile/verify.ts';
import {
  createStatusLinkRecoveryBoundary,
  createStatusLinkService,
  type StatusLinkAuthentication,
} from '../server/verification/status-link.ts';

Astro.response.headers.set('Cache-Control', 'private, no-store');

const config = getConfig();
const flags = getFlagService();
let authentication: StatusLinkAuthentication = { kind: 'rejected' };
let dashboardStatus: ReferralStatus | null = null;
let replacementRequested = false;
let challengeFailed = false;
let surveyEnabled = false;
let marketingEnabled = false;
let leftWaitlist = false;
const token = Astro.url.searchParams.get('t') ?? '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData().catch(() => new FormData());
  const submittedChallenge = formData.get('turnstile_token');
  const recovery = await createStatusLinkRecoveryBoundary({
    verifyTurnstile: verifyTurnstileToken,
    async recover(challengeTimedOut) {
      // Construct every stateful dependency only after Turnstile has returned
      // a verified or provider-unavailable outcome.
      const database = createPool(config.databaseUrl);
      try {
        const prefixHash = hashedIpPrefix(
          Astro.clientAddress,
          config.ipPrefixPepper,
        );
        return await createStatusLinkService(database, {
          flags,
        }).requestReplacement({
          challengeTimedOut,
          ipPrefixHash: prefixHash ?? '',
          token,
        });
      } finally {
        await database.close();
      }
    },
  })(typeof submittedChallenge === 'string' ? submittedChallenge : '');

  if (recovery === 'challenge_failed') {
    Astro.response.status = 400;
    challengeFailed = true;
  } else if (recovery === 'disabled') {
    authentication = { kind: 'disabled' };
  } else {
    replacementRequested = true;
  }
} else {
  const database = createPool(config.databaseUrl);
  try {
    const statusLinks = createStatusLinkService(database, {
      flags,
    });
    authentication = await statusLinks.authenticate(token);
    if (authentication.kind === 'authenticated') {
      const subject = await createUnsubscribeRepository(database).statusSubject(
        authentication.subscriberId,
      );
      if (subject?.status === 'unsubscribed') {
        leftWaitlist = true;
      } else if (subject?.status !== 'verified') {
        authentication = { kind: 'rejected' };
      } else {
        [dashboardStatus, surveyEnabled, marketingEnabled] = await Promise.all([
          createReferralService(database).status(authentication.subscriberId),
          flags.isEnabled('survey.enabled'),
          createMarketingService(database, { flags }).preference(
            authentication.subscriberId,
          ),
        ]);
      }
    }
  } finally {
    await database.close();
  }
}
const dashboardView =
  dashboardStatus === null ? null : presentReferralStatus(dashboardStatus);
---

<BaseLayout
  title={memberStatusCopy.meta.title}
  description={memberStatusCopy.meta.description}
>
  {
    authentication.kind === 'authenticated' && leftWaitlist ? (
      <section class="member-status-boundary">
        <h1>{memberStatusCopy.left.heading}</h1>
        <p>{memberStatusCopy.left.body}</p>
      </section>
    ) : authentication.kind === 'authenticated' && dashboardView !== null ? (
      <div class="member-status-boundary" data-member-dashboard>
        <h1>{memberStatusCopy.authenticated.heading}</h1>
        <p>{memberStatusCopy.authenticated.body}</p>

        <dl class="member-status-summary">
          {dashboardView.fields.map((field) => (
            <div>
              <dt>{field.label}</dt>
              <dd class:list={[field.tabular && 'tabular-figure']}>
                {field.value}
              </dd>
            </div>
          ))}
        </dl>

        <section class="member-status-section">
          <h2>{memberStatusCopy.marketing.heading}</h2>
          <p>
            {marketingEnabled
              ? memberStatusCopy.marketing.enabled
              : memberStatusCopy.marketing.disabled}
          </p>
          {!marketingEnabled ? (
            <p>{memberStatusCopy.marketing.wording}</p>
          ) : null}
          <form
            action="/api/me/marketing"
            data-marketing-form
            data-unavailable-message={memberStatusCopy.marketing.unavailable}
            method="post"
          >
            <input name="t" type="hidden" value={token} />
            <div
              class="cf-turnstile"
              data-sitekey={config.turnstileSiteKey}
              data-response-field-name="turnstile_token"
            />
            <noscript>
              <p>{memberStatusCopy.marketing.javaScriptRequired}</p>
            </noscript>
            <button
              name="marketing"
              type="submit"
              value={marketingEnabled ? 'off' : 'on'}
            >
              {marketingEnabled
                ? memberStatusCopy.marketing.turnOff
                : memberStatusCopy.marketing.turnOn}
            </button>
            <p aria-live="polite" data-marketing-status />
          </form>
          <script
            is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
          />
        </section>

        <section class="member-status-section">
          <h2>{memberStatusCopy.referral.heading}</h2>
          <div class="referral-control">
            <input
              aria-label={memberStatusCopy.referral.linkLabel}
              data-referral-link
              readonly
              type="url"
              value={dashboardView.referralLink}
            />
            <button
              data-copy-failed={memberStatusCopy.referral.copyFailed}
              data-copy-referral
              data-copied={memberStatusCopy.referral.copied}
              type="button"
            >
              {memberStatusCopy.referral.copy}
            </button>
          </div>
          <p aria-live="polite" data-copy-status />
        </section>

        <section class="member-status-section">
          <h2>{memberStatusCopy.rewards.heading}</h2>
          <p>{memberStatusCopy.rewards.intro}</p>
          {dashboardView.rewards.length === 0 ? (
            <p>{memberStatusCopy.rewards.empty}</p>
          ) : (
            <ul class="reward-list">
              {dashboardView.rewards.map((reward) => (
                <li>
                  <span>{reward.label}</span>
                  <span>{reward.tier}</span>
                  <strong>{reward.state}</strong>
                </li>
              ))}
            </ul>
          )}
        </section>

        {surveyEnabled ? (
          <form
            action="/api/survey"
            class="member-status-section"
            data-survey-form
            data-unavailable-message={surveyCopy.unavailable}
            method="post"
          >
            <h2>{memberStatusCopy.survey.heading}</h2>
            <input name="token" type="hidden" value={token} />
            <input name="version" type="hidden" value={currentSurveyVersion} />
            <fieldset>
              <legend>{verificationCopy.survey.categoryLabel}</legend>
              {verificationCopy.survey.categoryOptions.map((option) => (
                <label>
                  <input
                    name="category_preference"
                    type="checkbox"
                    value={option.value}
                  />
                  {option.label}
                </label>
              ))}
            </fieldset>
            <fieldset>
              <legend>{verificationCopy.survey.frequencyLabel}</legend>
              {verificationCopy.survey.frequencyOptions.map((option) => (
                <label>
                  <input
                    name="shopping_frequency"
                    type="radio"
                    value={option.value}
                  />
                  {option.label}
                </label>
              ))}
            </fieldset>
            <button type="submit">{memberStatusCopy.survey.submit}</button>
            <p aria-live="polite" data-survey-status />
          </form>
        ) : null}

        <section class="member-status-section">
          <p>
            <a href="/dsr?operation=export">{dsrCopy.export.heading}</a>
          </p>
          <p>
            <a href="/dsr?operation=delete">{dsrCopy.delete.heading}</a>
          </p>
          <h2>{memberStatusCopy.leave.heading}</h2>
          <p>{memberStatusCopy.leave.body}</p>
          <form
            action="/api/me/leave"
            data-leave-form
            data-unavailable-message={memberStatusCopy.leave.unavailable}
            method="post"
          >
            <input name="t" type="hidden" value={token} />
            <div
              class="cf-turnstile"
              data-sitekey={config.turnstileSiteKey}
              data-response-field-name="turnstile_token"
            />
            <noscript>
              <p>{memberStatusCopy.leave.javaScriptRequired}</p>
            </noscript>
            <button type="submit">{memberStatusCopy.leave.submit}</button>
            <p aria-live="polite" data-leave-status />
          </form>
        </section>
      </div>
    ) : authentication.kind === 'disabled' ? (
      <section class="member-status-boundary">
        <h1>{memberStatusCopy.disabled.heading}</h1>
        <p>{memberStatusCopy.disabled.body}</p>
      </section>
    ) : (
      <section class="member-status-boundary">
        <h1>{memberStatusCopy.recovery.heading}</h1>
        <p>
          {replacementRequested
            ? memberStatusCopy.recovery.sent
            : challengeFailed
              ? memberStatusCopy.recovery.challengeFailed
              : memberStatusCopy.recovery.body}
        </p>
        {!replacementRequested ? (
          <form method="post">
            <div
              class="cf-turnstile"
              data-sitekey={config.turnstileSiteKey}
              data-response-field-name="turnstile_token"
            />
            <noscript>
              <p>{memberStatusCopy.recovery.javaScriptRequired}</p>
            </noscript>
            <button type="submit">{memberStatusCopy.recovery.submit}</button>
          </form>
        ) : null}
        {!replacementRequested ? (
          <script
            is:inline
            src="https://challenges.cloudflare.com/turnstile/v0/api.js"
            async
            defer
          />
        ) : null}
      </section>
    )
  }
</BaseLayout>

<script is:inline>
  const copyButton = document.querySelector('[data-copy-referral]');
  const referralLink = document.querySelector('[data-referral-link]');
  const copyStatus = document.querySelector('[data-copy-status]');
  if (
    copyButton instanceof HTMLButtonElement &&
    referralLink instanceof HTMLInputElement &&
    copyStatus instanceof HTMLElement
  ) {
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(referralLink.value);
        copyStatus.textContent = copyButton.dataset.copied ?? '';
      } catch {
        referralLink.select();
        copyStatus.textContent = copyButton.dataset.copyFailed ?? '';
      }
    });
  }

  const surveyForm = document.querySelector('[data-survey-form]');
  if (surveyForm instanceof HTMLFormElement) {
    surveyForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = surveyForm.querySelector('[type="submit"]');
      const status = surveyForm.querySelector('[data-survey-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      )
        return;

      submit.disabled = true;
      try {
        const response = await fetch(surveyForm.action, {
          body: new FormData(surveyForm),
          method: 'POST',
        });
        const payload = await response.json();
        status.textContent = response.ok
          ? payload.message
          : (payload.error?.message ?? surveyForm.dataset.unavailableMessage);
      } catch {
        status.textContent = surveyForm.dataset.unavailableMessage ?? '';
      } finally {
        submit.disabled = false;
      }
    });
  }

  const marketingForm = document.querySelector('[data-marketing-form]');
  if (marketingForm instanceof HTMLFormElement) {
    marketingForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = marketingForm.querySelector('[type="submit"]');
      const status = marketingForm.querySelector('[data-marketing-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      )
        return;
      submit.disabled = true;
      try {
        const body = new FormData(marketingForm);
        body.set('marketing', submit.value);
        const response = await fetch(marketingForm.action, {
          body,
          method: 'POST',
        });
        const payload = await response.json();
        if (response.ok) {
          window.location.reload();
          return;
        }
        status.textContent = payload.error?.message ?? '';
      } catch {
        status.textContent = marketingForm.dataset.unavailableMessage ?? '';
      } finally {
        submit.disabled = false;
      }
    });
  }

  const leaveForm = document.querySelector('[data-leave-form]');
  if (leaveForm instanceof HTMLFormElement) {
    leaveForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = leaveForm.querySelector('[type="submit"]');
      const status = leaveForm.querySelector('[data-leave-status]');
      if (
        !(submit instanceof HTMLButtonElement) ||
        !(status instanceof HTMLElement)
      )
        return;
      submit.disabled = true;
      try {
        const response = await fetch(leaveForm.action, {
          body: new FormData(leaveForm),
          method: 'POST',
        });
        const payload = await response.json();
        status.textContent = response.ok
          ? payload.message
          : (payload.error?.message ?? leaveForm.dataset.unavailableMessage);
        if (!response.ok) submit.disabled = false;
      } catch {
        status.textContent = leaveForm.dataset.unavailableMessage ?? '';
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .member-status-boundary {
    display: grid;
    gap: var(--space-3);
    margin-inline: auto;
    padding: var(--space-3);
    color: var(--ink);
    font-family: var(--font-sans);
    background: var(--surface);
    border: thin solid var(--line);
    border-radius: var(--radius-card);
  }

  h1 {
    margin-block: 0 var(--space-2);
    font-size: var(--step-4);
    line-height: var(--leading-4);
  }

  h2,
  dt,
  dd,
  label,
  input,
  a,
  strong {
    color: var(--ink);
  }

  h2,
  dt,
  dd,
  ul {
    margin: 0;
  }

  h2 {
    font-size: var(--step-3);
    line-height: var(--leading-3);
  }

  p {
    margin: 0;
    color: var(--ink-600);
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }

  .member-status-summary,
  .member-status-section,
  fieldset,
  .reward-list {
    display: grid;
    gap: var(--space-2);
  }

  .member-status-summary > div,
  .reward-list li,
  .referral-control {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    justify-content: space-between;
  }

  dt {
    color: var(--ink-600);
  }

  dd {
    text-align: end;
  }

  .member-status-section {
    padding-block-start: var(--space-3);
    border-block-start: thin solid var(--line);
  }

  .referral-control input {
    min-width: 0;
    flex: auto;
  }

  .referral-control input,
  fieldset {
    padding: var(--space-1);
    font: inherit;
    background: var(--surface);
    border: thin solid var(--line);
    border-radius: var(--radius-control);
  }

  fieldset label {
    display: flex;
    gap: var(--space-1);
    align-items: center;
  }

  .reward-list {
    padding: 0;
    list-style: none;
  }

  button,
  a {
    padding: var(--space-1) var(--space-2);
    color: var(--midnight);
    font: inherit;
    background: var(--coral);
    border: thin solid var(--coral);
    border-radius: var(--radius-control);
    cursor: pointer;
  }

  a {
    justify-self: start;
  }

  button:focus-visible,
  input:focus-visible,
  a:focus-visible {
    outline: medium solid var(--ink);
    outline-offset: var(--space-1);
  }
</style>
