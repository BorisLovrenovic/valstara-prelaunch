---
import Accordion from '../components/accordion.astro';
import Button from '../components/button.astro';
import Card from '../components/card.astro';
import Container from '../components/container.astro';
import Icon from '../components/icon.astro';
import IconTile from '../components/icon-tile.astro';
import Pill from '../components/pill.astro';
import ProviderBanner from '../components/provider-banner.astro';
import ProviderRail from '../components/provider-rail.astro';
import Section from '../components/section.astro';
import TextLink from '../components/text-link.astro';
import landingHeroList from '../content/landing-hero.json';
import { svgIntrinsicSize } from '../components/provider-banner.ts';
import { resolveLandingFinal } from '../content/landing-final.ts';
import landingFinalList from '../content/landing-final.json';
import { resolveLandingHero } from '../content/landing-hero.ts';
import providerData from '../content/provider-showcase.json';
import type { Provider } from '../content/provider-showcase.ts';
import { landingCopy } from '../copy/landing.ts';
import SignupForm from '../islands/SignupForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  hasNonDefaultFlagState,
  landingCacheVary,
  landingFlagGeneration,
} from '../server/cache/landing.ts';
import { getConfig } from '../server/config.ts';
import { getFlagService } from '../server/flags/app-service.ts';
import { campaignFlagRegistry } from '../server/flags/registry.ts';
import { currentRules } from '../server/giveaway/rules-catalog.ts';
import { accessWindows, milestoneTiers } from '../server/referral/config.ts';
import { createReferralCaptureService } from '../server/referral/capture.ts';

const flags = await getFlagService().list();
const enabled = (key: keyof typeof campaignFlagRegistry) =>
  flags.find((flag) => flag.key === key)?.enabled ?? campaignFlagRegistry[key];
const signupEnabled = enabled('signup.enabled');
const referralEnabled = enabled('referral.enabled');
const giveawayEnabled = enabled('giveaway.open');
const leaderboardEnabled = enabled('leaderboard.public');
const rules = giveawayEnabled ? currentRules() : null;
const providers = providerData as Provider[];
// The logos' declared sizes, bundled at build time, so each hero image
// reserves its box before it loads (no layout shift).
const logoSources = import.meta.glob<string>('/public/images/providers/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const hero = resolveLandingHero(landingHeroList, providers, (logo) => {
  const source = logoSources[`/public${logo}`];
  return source === undefined ? null : svgIntrinsicSize(source);
});
// The final call to action's three logo-only banners (E11.5-11p).
const finalBanners = resolveLandingFinal(
  landingFinalList,
  providers,
  (logo) => {
    const source = logoSources[`/public${logo}`];
    return source === undefined ? null : svgIntrinsicSize(source);
  },
);
const enabledTiers = milestoneTiers.filter((tier) => tier.enabled);
// "What you get" (E11.5-11e): the cards reflow across three, two and one
// with no grid hole, and the footer row shows only with something to say.
const showReferralCard = referralEnabled && enabledTiers.length > 0;
const rewardCards = 1 + Number(showReferralCard) + Number(rules !== null);
const showRewardsFooter = referralEnabled || leaderboardEnabled;
// The "How it works" step icons, in step order (E11.5-11d).
const stepIcons = ['mail', 'check-circle', 'upload-share'] as const;

const referralCaptureService = createReferralCaptureService(
  getConfig().referralSigningSecret,
);
const referralCapture = referralCaptureService.capture(Astro.url);
const signedReferralCapture =
  referralEnabled &&
  (referralCapture.ref !== null || referralCapture.utm !== null)
    ? referralCaptureService.signRef(referralCapture)
    : null;
const hasReferralQuery = Astro.url.searchParams.has('ref');
const bypassLandingCache = hasReferralQuery || hasNonDefaultFlagState(flags);
Astro.response.headers.set(
  'Cache-Control',
  bypassLandingCache ? 'private, no-store' : 'public, max-age=0, s-maxage=300',
);
Astro.response.headers.set('Vary', landingCacheVary);
Astro.response.headers.set(
  'X-Valstara-Flag-Generation',
  landingFlagGeneration(flags),
);
---

<BaseLayout
  title={landingCopy.meta.title}
  description={landingCopy.meta.description}
>
  <div class="landing">
    <section id="join" class="landing-hero" aria-labelledby="landing-title">
      <Container>
        <div class="landing-hero__grid">
          <div class="landing-hero__copy">
            {
              /*
              The first-paint entrance (E11.5-11l): the star (0), the
              positioning line (1), the H1 and the supporting line (2), then
              the form card (3). The H1 and the form only rise, so they are
              visible and usable from first paint.
            */
            }
            <p class="landing-eyebrow">
              <span
                class="landing-eyebrow__star"
                data-enter
                style="--enter-index: 0"><Icon name="star" size="sm" /></span
              ><span data-enter style="--enter-index: 1"
                >{landingCopy.hero.eyebrow}</span
              >
            </p>
            <h1 id="landing-title" data-enter="shift" style="--enter-index: 2">
              {landingCopy.hero.heading}
            </h1>
            <p class="landing-hero__body" data-enter style="--enter-index: 2">
              {landingCopy.hero.body}
            </p>
            {
              signupEnabled ? (
                <SignupForm
                  signedReferralCapture={signedReferralCapture}
                  giveawayEnabled={giveawayEnabled}
                >
                  <ul class="landing-facts" slot="facts">
                    {landingCopy.hero.facts.map((fact) => (
                      <li>
                        <Icon name={fact.icon} size="base" />
                        <span>{fact.text}</span>
                      </li>
                    ))}
                  </ul>
                </SignupForm>
              ) : (
                <div class="landing-paused" role="status">
                  <div class="landing-paused__head">
                    <span class="landing-paused__tile">
                      <Icon name="pause" size="md" />
                    </span>
                    <h2>{landingCopy.paused.heading}</h2>
                  </div>
                  <p>{landingCopy.paused.body}</p>
                </div>
              )
            }
            <div class="landing-hero__strip" aria-hidden="true">
              {
                hero.strip.map((banner) => (
                  <ProviderBanner banner={banner} size="strip" />
                ))
              }
            </div>
          </div>
          <div class="landing-hero__stack" aria-hidden="true">
            {
              hero.stack.map((banner) => (
                <ProviderBanner banner={banner} size="stack" />
              ))
            }
          </div>
        </div>
      </Container>
    </section>

    <Section id="catalogue" aria-labelledby="catalogue-title">
      <h2 id="catalogue-title" slot="heading">
        {landingCopy.catalogue.heading}
      </h2>
      <p slot="heading">{landingCopy.catalogue.body}</p>
      <ProviderRail providers={providers} />
    </Section>

    <Section id="how" aria-labelledby="how-title">
      <h2 id="how-title" slot="heading">{landingCopy.how.heading}</h2>
      <div class="landing-steps-panel">
        <ol class="landing-steps">
          {
            landingCopy.how.steps.map((step, index) => {
              // The last step, sharing your link, is drawn as optional.
              const optional = index === landingCopy.how.steps.length - 1;
              // The connector into this step, from the one before it. It is
              // drawn here, to this step's left (or above it, below 48rem),
              // so it never overflows the step it starts from.
              const connected = index > 0;
              const dashed = optional;
              return (
                <li
                  class:list={[
                    'landing-step',
                    { 'landing-step--optional': optional },
                  ]}
                  data-reveal
                  style={`--reveal-index: ${index}`}
                >
                  <span class="landing-step__tile" aria-hidden="true">
                    <Pill variant="step" class="landing-step__badge">
                      {index + 1}
                    </Pill>
                    <Icon name={stepIcons[index]} size="md" />
                  </span>
                  {connected && (
                    <>
                      {/*
                        The connector from the step before: a 2px line, dashed
                        into the optional step, drawn through a mask whose
                        stroke draws from the start (E11.5-11n). Across, from
                        48rem, it ends in an arrowhead; down, below 48rem, it
                        has none.
                      */}
                      <svg
                        class:list={[
                          'landing-step__connector',
                          'landing-step__connector--across',
                          { 'landing-step__connector--dashed': dashed },
                        ]}
                        aria-hidden="true"
                        focusable="false"
                      >
                        <mask
                          id={`how-connector-across-${index}`}
                          maskUnits="userSpaceOnUse"
                          x="0"
                          y="0"
                          width="100%"
                          height="100%"
                        >
                          <line
                            class="landing-step__draw"
                            x1="0"
                            y1="50%"
                            x2="100%"
                            y2="50%"
                            pathLength="1"
                          />
                        </mask>
                        <g mask={`url(#how-connector-across-${index})`}>
                          <line
                            class="landing-step__line"
                            x1="0"
                            y1="50%"
                            x2="100%"
                            y2="50%"
                          />
                          <svg
                            class="landing-step__head"
                            x="100%"
                            overflow="visible"
                          >
                            <polygon points="-7,0 0,6 -7,12" />
                          </svg>
                        </g>
                      </svg>
                      <svg
                        class:list={[
                          'landing-step__connector',
                          'landing-step__connector--down',
                          { 'landing-step__connector--dashed': dashed },
                        ]}
                        aria-hidden="true"
                        focusable="false"
                      >
                        <mask
                          id={`how-connector-down-${index}`}
                          maskUnits="userSpaceOnUse"
                          x="0"
                          y="0"
                          width="100%"
                          height="100%"
                        >
                          <line
                            class="landing-step__draw"
                            x1="50%"
                            y1="0"
                            x2="50%"
                            y2="100%"
                            pathLength="1"
                          />
                        </mask>
                        <line
                          class="landing-step__line"
                          x1="50%"
                          y1="0"
                          x2="50%"
                          y2="100%"
                          mask={`url(#how-connector-down-${index})`}
                        />
                      </svg>
                    </>
                  )}
                  <p class="landing-step__title">{step}</p>
                </li>
              );
            })
          }
        </ol>
      </div>
    </Section>

    <Section id="rewards" aria-labelledby="rewards-title">
      <h2 id="rewards-title" slot="heading">{landingCopy.rewards.heading}</h2>
      {
        /*
          The cards reveal in reading order (E11.5-11o). Their figures are
          never animated: N, X, the prize count and the value render as their
          final values from the first frame, and only decorative parts move.
        */
      }
      <div class="landing-rewards" data-reward-cards={rewardCards}>
        <Card
          class="landing-reward landing-reward--access"
          data-access-card
          data-reveal
          style="--reveal-index: 0"
        >
          <div class="landing-reward__intro">
            <div class="landing-reward__head">
              <IconTile name="building" />
              <h3>{landingCopy.rewards.accessHeading}</h3>
            </div>
            <p class="landing-reward__body">
              {landingCopy.rewards.accessBody}
            </p>
          </div>
          <div class="landing-reward__visual">
            <div class="landing-reward__well">
              <div class="landing-waves-plot">
                <ol class="landing-waves">
                  {
                    accessWindows.map((_, index) => (
                      <li class="landing-wave">
                        <span class="landing-wave__label tabular-figure">
                          {landingCopy.rewards.waveLabel(index + 1)}
                        </span>
                        {/*
                          Each wave starts later along the same track, at its
                          share of it, marked by a dot; its fill grows from
                          there to the right end (E11.5-11o).
                        */}
                        <span
                          class="landing-wave__track"
                          aria-hidden="true"
                          style={`--wave-start: ${(index / accessWindows.length) * 100}%; --wave-index: ${index + 1}`}
                        >
                          <span class="landing-wave__fill" />
                        </span>
                      </li>
                    ))
                  }
                </ol>
                <span class="landing-wave-grid" aria-hidden="true">
                  {accessWindows.map(() => <span />)}
                </span>
              </div>
              <p class="landing-wave-axis" aria-hidden="true">
                <span>{landingCopy.rewards.waveAxis.earlier}</span>
                <span>{landingCopy.rewards.waveAxis.later}</span>
              </p>
            </div>
          </div>
        </Card>
        {
          showReferralCard && (
            <Card
              class="landing-reward"
              data-referral-card
              data-reveal
              style="--reveal-index: 1"
            >
              <div class="landing-reward__head">
                <IconTile name="people" />
                <h3>{landingCopy.rewards.referralHeading}</h3>
              </div>
              <div class="landing-reward__visual">
                <div class="landing-reward__well">
                  {enabledTiers.map((tier) => (
                    <div
                      class="landing-tier"
                      data-tier={tier.number}
                      style={`--sequence-steps: ${tier.threshold + 2}`}
                    >
                      <p class="landing-hidden">
                        {landingCopy.rewards.tier(tier)}
                      </p>
                      {/*
                        A vertical sum: the count, then an operator column
                        (the arrow, the "+") beside the two reward pills. On
                        the tier's own view timeline the person icons appear
                        one after another, then the arrow draws, then the
                        pills rise in (E11.5-11o).
                      */}
                      <div class="landing-tier__equation" aria-hidden="true">
                        <div class="landing-tier__referrals">
                          <span class="landing-figure tabular-figure">
                            {tier.threshold}
                          </span>
                          <span class="landing-tier__meta">
                            <span class="landing-tier__people">
                              {Array.from(
                                { length: tier.threshold },
                                (_, person) => (
                                  <span
                                    class="landing-tier__person"
                                    style={`--sequence-index: ${person}`}
                                  >
                                    <Icon name="person" size="sm" />
                                  </span>
                                ),
                              )}
                            </span>
                            <span class="landing-tier__label">
                              {landingCopy.rewards.tierReferrals}
                            </span>
                          </span>
                        </div>
                        <span
                          class="landing-tier__arrow"
                          style={`--sequence-index: ${tier.threshold}`}
                        >
                          <svg
                            class="landing-tier__arrow-draw"
                            focusable="false"
                          >
                            <mask
                              id={`rewards-tier-arrow-${tier.number}`}
                              maskUnits="userSpaceOnUse"
                              x="0"
                              y="0"
                              width="100%"
                              height="100%"
                            >
                              <line
                                class="landing-tier__draw"
                                x1="0"
                                y1="50%"
                                x2="100%"
                                y2="50%"
                                pathLength="1"
                              />
                            </mask>
                            <g mask={`url(#rewards-tier-arrow-${tier.number})`}>
                              <Icon name="arrow-right" size="base" />
                            </g>
                          </svg>
                        </span>
                        <span class="landing-tier__plus">
                          {landingCopy.rewards.tierPlus}
                        </span>
                        <div
                          class="landing-tier__reward"
                          style={`--sequence-index: ${tier.threshold + 1}`}
                        >
                          <Pill>
                            <Icon name="arrow-up" size="sm" />
                            {landingCopy.rewards.tierWave}
                          </Pill>
                          <Pill variant="coral">
                            <span class="tabular-figure">
                              {landingCopy.rewards.tierDiscount(tier)}
                            </span>{' '}
                            {landingCopy.rewards.tierDiscountLabel}
                          </Pill>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
                <p class="landing-held">
                  <Icon name="clock" size="sm" />
                  {landingCopy.rewards.held}
                </p>
              </div>
            </Card>
          )
        }
        {
          rules !== null && (
            <Card
              class="landing-reward"
              data-giveaway-card
              data-reveal
              style={`--reveal-index: ${rewardCards - 1}`}
            >
              <div class="landing-reward__head">
                <IconTile name="gift" />
                <h3>{landingCopy.rewards.giveawayHeading}</h3>
              </div>
              <div class="landing-reward__visual">
                {/* The prize line reveals as one unit; its figures are static. */}
                <div class="landing-reward__well landing-prize" data-reveal>
                  <p class="landing-hidden">
                    {landingCopy.rewards.prize(rules)}
                  </p>
                  <p class="landing-prize__line" aria-hidden="true">
                    <span class="landing-figure tabular-figure">
                      {rules.prizeCount}
                    </span>{' '}
                    <span class="landing-prize__words">
                      {landingCopy.rewards.prizeCountLabel}
                    </span>{' '}
                    <span class="landing-prize__value">
                      <span class="landing-figure tabular-figure">
                        {landingCopy.rewards.prizeValue(rules)}
                      </span>{' '}
                      <span class="landing-prize__words">
                        {landingCopy.rewards.prizeEach}
                      </span>
                    </span>
                  </p>
                  <span class="landing-prize__gifts" aria-hidden="true">
                    {Array.from({ length: rules.prizeCount }, () => (
                      <Icon name="gift" size="base" />
                    ))}
                  </span>
                </div>
                <p class="landing-reward__note">
                  {landingCopy.rewards.freeEntry} · {landingCopy.rewards.age}
                </p>
                <p class="landing-reward__more">
                  <TextLink
                    href="/giveaway/rules"
                    arrow
                    class="landing-reward__link"
                  >
                    {landingCopy.rewards.rulesLink}
                  </TextLink>
                </p>
              </div>
            </Card>
          )
        }
      </div>
      {
        showRewardsFooter && (
          <div class="landing-rewards__footer" data-reveal>
            <p class="landing-rewards__verified">
              <Icon name="shield-check" size="base" />
              {landingCopy.rewards.verifiedOnly}
            </p>
            {leaderboardEnabled && (
              <TextLink href="/leaderboard" arrow class="landing-reward__link">
                {landingCopy.rewards.leaderboardLink}
              </TextLink>
            )}
          </div>
        )
      }
    </Section>

    <Section
      id="guarantee"
      class="landing-band"
      variant="midnight"
      aria-labelledby="guarantee-title"
    >
      <h2 id="guarantee-title" slot="heading" data-reveal>
        {landingCopy.trust.heading}
      </h2>
      <p slot="heading" data-reveal>{landingCopy.trust.intro}</p>
      <ol class="landing-guarantee">
        {
          landingCopy.trust.promises.map((promise, index) => (
            <li class="landing-promise" style={`--promise-index: ${index}`}>
              <span class="landing-promise__numeral" aria-hidden="true">
                {/* Draws the ring while it enters; at rest it shows nothing
                    and the numeral's own --ring-numeral is the ring. */}
                <svg
                  class="landing-promise__draw"
                  viewBox="0 0 64 64"
                  aria-hidden="true"
                  focusable="false"
                >
                  <circle
                    cx="32"
                    cy="32"
                    r="31.25"
                    pathLength="1"
                    transform="rotate(-90 32 32)"
                  />
                </svg>
                <span class="landing-promise__digits">{promise.numeral}</span>
              </span>
              <h3 class="landing-promise__title">
                <span class="landing-promise__prefix landing-hidden">
                  {landingCopy.trust.prefix(promise.numeral)}
                </span>
                {promise.title}
              </h3>
              <p class="landing-promise__line">{promise.line}</p>
            </li>
          ))
        }
      </ol>
      <TextLink
        href="/guarantee"
        variant="on-midnight"
        class="landing-guarantee__link"
        arrow
        data-reveal
      >
        {landingCopy.trust.link}
      </TextLink>
      {/* Decorative, at large widths only. */}
      <Icon name="star" size="md" class="landing-band__star" />
    </Section>

    <Section aria-labelledby="trust-links-title">
      <h2 id="trust-links-title" slot="heading">
        {landingCopy.trustLinks.heading}
      </h2>
      <div class="landing-trust-links">
        {
          landingCopy.trustLinks.items.map((item, index) => (
            <Card
              href={item.href}
              interactive
              class="landing-trust-card"
              data-reveal
              style={`--reveal-index: ${index}`}
            >
              <IconTile name={item.icon} />
              <h3 class="landing-trust-card__title">
                {item.heading}
                <Icon
                  name="arrow-right"
                  size="sm"
                  class="card__arrow landing-trust-card__arrow"
                />
              </h3>
              <p class="landing-trust-card__line">{item.line}</p>
            </Card>
          ))
        }
      </div>
    </Section>

    <Section id="faq" class="landing-faq" aria-labelledby="faq-title">
      <h2 id="faq-title" slot="heading" data-reveal>
        {landingCopy.faq.heading}
      </h2>
      <Card class="landing-faq__card" data-reveal>
        {
          landingCopy.faq.items.map((item, index) => (
            <Accordion summary={item.question} open={index === 0}>
              {item.answer}
            </Accordion>
          ))
        }
      </Card>
    </Section>

    <Section class="landing-final" aria-labelledby="final-title">
      <Card class="landing-final__card" data-reveal>
        <div class="landing-final__text">
          <h2 id="final-title" class="landing-final__title">
            {landingCopy.final.heading}
          </h2>
          <Button href="#join" class="landing-final__action" data-focus-signup>
            {landingCopy.final.action}
          </Button>
        </div>
        {
          /* Three logo-only banners from the showcase file, decorative, from
            48rem. They rise one after another, after the card's text. */
        }
        <div class="landing-final__visual" aria-hidden="true">
          {
            finalBanners.map((banner, index) => (
              <ProviderBanner
                banner={banner}
                size="final"
                revealIndex={index + 1}
              />
            ))
          }
        </div>
      </Card>
    </Section>
  </div>
</BaseLayout>

<style>
  .landing {
    margin-inline: calc(-1 * var(--space-3));
    margin-block-start: calc(-1 * var(--space-4));
  }
  .landing :global(h1),
  .landing :global(h2),
  .landing :global(h3),
  .landing :global(p) {
    margin-block-start: var(--space-0);
  }
  .landing :global(h1) {
    font-size: var(--step-5);
    font-weight: var(--weight-bold);
    line-height: var(--leading-5);
    letter-spacing: var(--tracking-tight);
  }
  .landing :global(h2) {
    font-size: var(--step-4);
    line-height: var(--leading-4);
  }
  .landing :global(h3) {
    font-size: var(--step-3);
    line-height: var(--leading-3);
  }
  /*
    The #join hero from the final design (Hero.dc.html, E11.5-11l), on the
    E11.5-11c layout. Small: one column, 16px top padding (the phone fold),
    the logo strip 24px below the form. Medium (48rem): 40px top padding, the
    text in columns 1-7 and the banner stack in 8-12, rows centred. Large
    (64rem): 48px top padding and the large stack. The section gap above the
    catalogue is the only space below the hero. The stack and the strip are
    E11.5-11c's, unchanged (final-design rule 4).
  */
  .landing-hero {
    padding-block-start: var(--space-2);
  }
  .landing-hero__copy {
    min-width: 0;
  }
  .landing-eyebrow {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    color: var(--ink-600);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
  }
  .landing-eyebrow :global(.icon) {
    color: var(--coral);
  }
  .landing-eyebrow__star {
    display: flex;
  }
  .landing-hero h1,
  .landing-hero :global(p) {
    margin-block-end: var(--space-0);
  }
  .landing-hero h1 {
    margin-block-start: var(--space-1-5);
    text-wrap: balance;
  }
  /* Under .landing-hero so it outranks the page's paragraph reset. */
  .landing-hero .landing-hero__body {
    max-inline-size: calc(var(--space-10) * 7.5);
    margin-block-start: var(--space-1-5);
    color: var(--ink-600);
    font-size: var(--step-2);
    line-height: var(--leading-2);
    text-wrap: pretty;
  }
  /* The form card, or the paused panel in its place, at most 600px wide. */
  .landing-hero :global(valstara-signup-form),
  .landing-paused {
    max-inline-size: calc(var(--space-10) * 7.5);
    margin-block-start: var(--space-3);
  }
  /*
    The star's entrance (E11.5-11l): the data-enter fade and rise, plus a
    turn from --star-turn and a scale from --star-scale, both to rest. Only
    without reduced motion, like every motion.css utility; the keyframe
    names no end, so the star finishes on its resting style.
  */
  @media (prefers-reduced-motion: no-preference) {
    .landing-eyebrow__star[data-enter] {
      animation-name: landing-star-enter;
    }

    @keyframes landing-star-enter {
      from {
        opacity: 0;
        translate: 0 var(--enter-distance);
        rotate: var(--star-turn);
        scale: var(--star-scale);
      }
    }
  }
  .landing-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2-5);
    margin: var(--space-0);
    padding: var(--space-0);
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
    list-style: none;
  }
  .landing-facts li {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
  }
  .landing-facts :global(.icon) {
    color: var(--ink-600);
  }
  /* Three 56px banners, 8px apart, flexing 1 : 1 : 1.35. */
  .landing-hero__strip {
    display: flex;
    gap: var(--space-1);
    margin-block-start: var(--space-3);
  }
  .landing-hero__strip :global(.hero-banner) {
    flex: 1 1 0;
  }
  .landing-hero__strip :global(.hero-banner:last-child) {
    flex-grow: 1.35;
  }
  .landing-hero__stack {
    display: none;
  }
  /*
    The paused panel (state 17, Hero.dc.html, E11.5-11m) is the signup
    form's success panel with the pause icon: a surface card, radius 12,
    --shadow-2 plus the dark-only edge, 24px padding (32px from 48rem), a
    column holding the head (the 48px neutral tile and the 24/32 600
    heading, 16px apart and centred on each other) and, 12px below, the
    16/24 ink-600 body, at most 32rem wide.
  */
  .landing-paused {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-3);
    background-color: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-2), var(--edge);
  }
  .landing-paused__head {
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .landing-paused__tile {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    color: var(--ink);
    background-color: var(--wash);
    border-radius: var(--radius-control);
  }
  .landing-paused h2 {
    margin: var(--space-0);
    text-wrap: balance;
    font-size: var(--step-4);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-4);
    letter-spacing: var(--tracking-tight);
  }
  .landing-hero .landing-paused p {
    max-inline-size: calc(var(--space-8) * 8);
    margin: var(--space-1-5) var(--space-0) var(--space-0);
    color: var(--ink-600);
    text-wrap: pretty;
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }
  .landing-steps,
  .landing-guarantee {
    margin: var(--space-0);
    padding: var(--space-0);
    list-style: none;
  }
  /* The FAQ's heading is the canvas's .faq__head, not .section-head, so it
     takes no 40rem cap (E11.5-11n). */
  .landing :global(.landing-faq .section__heading) {
    max-inline-size: none;
  }
  /*
    Below 64rem the catalogue rail bleeds into the right gutter. Its content
    cell spans that gutter as padding, so the bleed stays inside a box.
  */
  .landing :global(#catalogue .container__content) {
    grid-column: 2 / 4;
    padding-inline-end: var(--gutter);
  }
  /*
    "How it works" (E11.5-11n, Main.dc.html): one surface panel (shadow 1 and
    the edge; 24px 20px padding, 32px from 48rem, 40px 48px from 64rem).
    Small: one column, 32px apart, each step a row of the 56px tile and its
    16/24 title, 16px apart, joined by a 2px by 28px connector 27px from the
    left and 60px from the top, reaching the next tile. Medium and large:
    three columns, 24px apart, each step a column with 20px gaps and the 20/28
    title, and a connector 27px from the top from 72px right of the tile to
    8px past the column's end, with a 7 × 12 arrowhead whose tip is 2px
    further. The connector into the optional third step is dashed. The tile
    is a well with an inset line ("no card inside a card"); the optional one
    is dashed, with no fill. The badge sits at -10/-10 inside a 3px ring of
    the panel's surface.
  */
  .landing-steps-panel {
    padding: var(--space-3) var(--space-2-5);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1), var(--edge);
  }
  .landing-steps {
    display: grid;
    gap: var(--space-4);
  }
  .landing-step {
    position: relative;
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .landing-step__tile {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-7);
    block-size: var(--space-7);
    color: var(--ink);
    background: var(--well);
    border-radius: var(--radius-card);
    box-shadow: var(--inset-line);
  }
  .landing-step__tile :global(.landing-step__badge) {
    position: absolute;
    top: calc(var(--space-1) * -1.25);
    left: calc(var(--space-1) * -1.25);
    box-shadow: var(--ring-badge);
  }
  .landing-step--optional .landing-step__tile {
    color: var(--ink-600);
    background: transparent;
    border: var(--border-check) dashed var(--ink-300);
    box-shadow: none;
  }
  .landing-step--optional .landing-step__tile :global(.landing-step__badge) {
    background-color: var(--ink-600);
  }
  .landing-step__connector {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }
  .landing-step__connector--across {
    display: none;
  }
  /* Down: from 60px below the previous step's top to this step's top. */
  .landing-step__connector--down {
    top: calc(var(--space-1) * -3.5);
    left: calc(var(--space-1) * 3.375);
    inline-size: var(--border-strong);
    block-size: calc(var(--space-1) * 3.5);
  }
  .landing-step__line {
    stroke: var(--ink-300);
    stroke-width: var(--border-strong);
  }
  .landing-step__connector--dashed .landing-step__line {
    stroke-dasharray: var(--connector-dash);
  }
  .landing-step__head {
    fill: var(--ink-300);
  }
  /* The mask's stroke, wider than the connector, draws it. At rest it is
     whole; only the drawing animation, while it runs, holds it back. */
  .landing-step__draw {
    stroke: var(--banner-white);
    stroke-width: var(--space-2);
    stroke-dasharray: 1;
  }
  .landing .landing-step__title {
    margin-block: var(--space-0);
    text-wrap: balance;
    font-size: var(--step-2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-2);
    letter-spacing: var(--tracking-normal);
  }
  .landing-step--optional .landing-step__title {
    color: var(--ink-600);
  }
  /*
    The connector drawing (E11.5-11n): on a step's view timeline (the step
    it leaves from 48rem, shared with the list through timeline-scope; the
    step it sits in below), after that step's reveal ends, and finished by
    the time the step's top reaches 75% of the viewport height
    (--draw-range). Only with motion allowed and
    scroll-driven animations supported; otherwise it is drawn at rest.
  */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .landing-steps {
        timeline-scope: --landing-step-1, --landing-step-2;
      }
      .landing-step {
        view-timeline-inset: 0;
      }
      .landing-step:nth-child(1) {
        view-timeline-name: --landing-step-1;
      }
      .landing-step:nth-child(2) {
        view-timeline-name: --landing-step-2;
      }
      .landing-step:nth-child(3) {
        view-timeline-name: --landing-step-3;
      }
      .landing-step__draw {
        animation-name: landing-connector-draw;
        animation-duration: auto;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: backwards;
        animation-range: var(--draw-range);
      }
      /* Below 48rem the steps stack, so a connector, drawn inside the step
         it leads into, draws down on that step's own view timeline: once
         that step has revealed, never while its reveal still hides it
         (founder decision 2026-11-08). */
      .landing-step:nth-child(2) .landing-step__draw {
        animation-timeline: --landing-step-2;
      }
      .landing-step:nth-child(3) .landing-step__draw {
        animation-timeline: --landing-step-3;
      }
      /* From 48rem the steps share a row, and each connector draws on the
         view timeline of the step it leaves. */
      @media (min-width: 48rem) {
        .landing-step:nth-child(2) .landing-step__draw {
          animation-timeline: --landing-step-1;
        }
        .landing-step:nth-child(3) .landing-step__draw {
          animation-timeline: --landing-step-2;
        }
      }
    }
  }
  @keyframes landing-connector-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  /*
    "What you get" (E11.5-11e, final design E11.5-11o, Rewards.dc.html).
    Small: one column, 16px apart. Each card is padded 24px (32px from
    48rem) and holds a head row (the 40px icon tile and the 20/28 H3, 12px
    apart, over a 1px line divider 20px below: the dividers line up across
    the cards), then the visual block 20px below (16px below the access
    card's 16/24 body), a column with 16px gaps. Each data graphic sits on a
    well (radius 8, 16px padding): the wave track, the referral equation as
    a vertical sum, and the prize line. The footer row sits 24px below the
    cards.
  */
  .landing-rewards {
    display: grid;
    gap: var(--space-2);
  }
  .landing-rewards :global(.landing-reward) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .landing-reward__intro {
    display: flex;
    flex-direction: column;
  }
  .landing-reward__head {
    display: flex;
    gap: var(--space-1-5);
    align-items: center;
    padding-block-end: var(--space-2-5);
    border-block-end: var(--border-thin) solid var(--line);
  }
  .landing-rewards h3 {
    margin-block: var(--space-0);
    text-wrap: balance;
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
  }
  .landing-rewards p {
    margin-block: var(--space-0);
  }
  .landing-rewards .landing-reward__body {
    margin-block-start: var(--space-2-5);
    color: var(--ink-600);
    text-wrap: pretty;
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }
  .landing-reward__visual {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-start: var(--space-2-5);
  }
  .landing-reward__intro + .landing-reward__visual {
    margin-block-start: var(--space-2);
  }
  .landing-reward__well {
    position: relative;
    padding: var(--space-2);
    background: var(--well);
    border-radius: var(--radius-control);
  }
  /*
    The wave track: one row per access window, 12px apart, each a 56px mono
    13/18 600 label and a 10px --wash-strong track (radius 999) whose ink
    fill runs from the wave's share of the track (0%, 25%, 50%, 75%) to the
    right end, with a 10px coral dot in a 2px --surface ring at its start.
    A dashed quarter grid runs 6px past the rows over the tracks, and the
    axis ("earlier", a 1px ink-300 rule, "later") sits 12px below them,
    under the tracks.
  */
  /* The plot holds the grid's 6px above and below the rows in its own
     padding, offset by a matching negative margin, so no box overflows. */
  .landing-waves-plot {
    position: relative;
    margin-block: calc(var(--space-0-75) * -1);
    padding-block: var(--space-0-75);
  }
  .landing-waves {
    display: flex;
    flex-direction: column;
    gap: var(--space-1-5);
    margin: var(--space-0);
    padding: var(--space-0);
    list-style: none;
  }
  .landing-wave {
    display: grid;
    grid-template-columns: var(--space-7) minmax(0, 1fr);
    column-gap: var(--space-1-5);
    align-items: center;
  }
  .landing-wave__label {
    color: var(--ink);
    white-space: nowrap;
    font-size: var(--step-0);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-0);
  }
  .landing-wave__track {
    position: relative;
    block-size: calc(var(--space-1) * 1.25);
    background-color: var(--wash-strong);
    border-radius: var(--radius-pill);
  }
  .landing-wave__fill {
    position: absolute;
    inset-block: var(--space-0);
    inset-inline-start: var(--wave-start);
    inset-inline-end: var(--space-0);
    background-color: var(--ink);
    border-radius: var(--radius-pill);
    transform-origin: left center;
  }
  .landing-wave__track::after {
    content: '';
    position: absolute;
    inset-block: var(--space-0);
    inset-inline-start: var(--wave-start);
    inline-size: calc(var(--space-1) * 1.25);
    background-color: var(--coral);
    border-radius: var(--radius-pill);
    box-shadow: 0 0 0 var(--border-strong) var(--surface);
  }
  .landing-wave-grid {
    position: absolute;
    inset-block: var(--space-0);
    inset-inline-start: calc(var(--space-7) + var(--space-1-5));
    inset-inline-end: var(--space-0);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    pointer-events: none;
  }
  .landing-wave-grid > span + span {
    border-inline-start: var(--border-thin) dashed var(--line);
  }
  .landing-rewards .landing-wave-axis {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    margin-block-start: var(--space-1-5);
    margin-inline-start: calc(var(--space-7) + var(--space-1-5));
    color: var(--ink-600);
    font-size: var(--step-0);
    line-height: var(--leading-0);
  }
  .landing-wave-axis::before {
    content: '';
    flex: 1;
    order: 2;
    block-size: var(--border-thin);
    background-color: var(--ink-300);
  }
  .landing-wave-axis span:last-child {
    order: 3;
  }
  /* Read by assistive technology, clipped to nothing on screen, and boxed
     inside its parent so it never widens the page. */
  .landing-hidden {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .landing-tier {
    position: relative;
  }
  .landing-tier + .landing-tier {
    margin-block-start: var(--space-2);
    padding-block-start: var(--space-2);
    border-block-start: var(--border-thin) dashed var(--line);
  }
  /*
    The referral equation, a vertical sum: a 24px operator column beside
    the count, then the arrow beside "Up one access wave" and the "+" beside
    the coral "X% off at launch" pill, 8px apart. The count is N in mono
    32/40 600 (−0.02em), 12px before N 16px person icons over "confirmed
    referrals", with 4px below it.
  */
  .landing-tier__equation {
    display: grid;
    grid-template-columns: var(--space-3) minmax(0, 1fr);
    gap: var(--space-1);
    align-items: center;
    justify-items: start;
  }
  .landing-tier__referrals {
    display: flex;
    grid-column: 2;
    gap: var(--space-1-5);
    align-items: center;
    margin-block-end: var(--space-0-5);
  }
  .landing-figure {
    font-size: var(--step-5);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-5);
    letter-spacing: calc(var(--tracking-tight) * 2);
  }
  .landing-tier__meta {
    display: flex;
    flex-direction: column;
    gap: calc(var(--space-0-5) / 2);
  }
  .landing-tier__people {
    display: flex;
    gap: calc(var(--space-0-5) / 4);
    color: var(--ink-600);
  }
  .landing-tier__person {
    display: flex;
  }
  .landing-tier__label {
    color: var(--ink-600);
    font-size: var(--step-0);
    line-height: var(--leading-0);
  }
  .landing-tier__arrow,
  .landing-tier__plus {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-3);
    block-size: calc(var(--space-3) + var(--space-0-5) / 2);
    color: var(--ink-600);
    font-size: var(--step-2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-2);
  }
  .landing-tier__arrow {
    grid-row: 2;
    grid-column: 1;
  }
  .landing-tier__plus {
    grid-row: 3;
    grid-column: 1;
  }
  .landing-tier__reward {
    display: flex;
    grid-row: 2 / span 2;
    grid-column: 2;
    flex-direction: column;
    gap: var(--space-1);
    align-items: flex-start;
  }
  /* The arrow is drawn through a mask whose stroke, wider than the arrow,
     runs left to right. At rest the mask is whole; only the drawing
     animation, while it runs, holds it back. */
  .landing-tier__arrow-draw {
    inline-size: var(--icon-base);
    block-size: var(--icon-base);
    overflow: visible;
  }
  .landing-tier__draw {
    stroke: var(--banner-white);
    stroke-width: var(--space-3);
    stroke-dasharray: 1;
  }
  .landing-rewards .landing-held {
    display: flex;
    gap: var(--space-1);
    align-items: flex-start;
    color: var(--ink-600);
    text-wrap: pretty;
    font-size: var(--step-1);
    line-height: var(--leading-1);
  }
  .landing-held :global(.icon) {
    margin-block-start: calc(var(--space-0-5) / 2);
  }
  /*
    The prize line wraps on a shared baseline, 8px apart, the value and
    "each" kept together; one 20px ink-300 gift per prize sits 12px below.
  */
  .landing-rewards .landing-prize__line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-0) var(--space-1);
    align-items: baseline;
  }
  .landing-prize__words {
    font-size: var(--step-2);
    font-weight: var(--weight-medium);
    line-height: var(--leading-2);
  }
  .landing-prize__value {
    white-space: nowrap;
  }
  .landing-prize__gifts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-block-start: var(--space-1-5);
    color: var(--ink-300);
  }
  .landing-rewards .landing-reward__note {
    color: var(--ink-600);
    font-size: var(--step-1);
    line-height: var(--leading-1);
  }
  /* The rules link sits in a paragraph with the page's 16/24 line box, as
     the canvas sets it. */
  .landing-rewards .landing-reward__more {
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }
  /* 14/20 arrow links; below 48rem each is a 44px tap target, laid out at
     that height (TextLink's 12px padding above and below its line). */
  .landing :global(.landing-reward__link) {
    font-size: var(--step-1);
    line-height: var(--leading-1);
  }
  .landing-rewards__footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5) var(--space-4);
    align-items: center;
    margin-block-start: var(--space-3);
  }
  .landing .landing-rewards__verified {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    margin-block: var(--space-0);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
  }
  .landing-rewards__verified :global(.icon) {
    color: var(--ink-600);
  }
  /*
    The motion (E11.5-11o), only with motion allowed and scroll-driven
    animations supported; otherwise everything is drawn at rest. The cards,
    the prize block and the footer row reveal through data-reveal. Each wave
    fill grows from its start point to the right end (scaleX, origin at its
    start), on the access card's view timeline over --reveal-range, wave n
    starting n × --reveal-step in, as a --reveal-index would. On each tier's
    own view timeline (inset 0), from --sequence-start to --sequence-end into
    its cover range, the steps run one after another: each person icon
    appears, then the arrow draws, then the two pills rise in together;
    step k of a tier's N + 2 takes the k-th equal share. The figures never
    move.
  */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .landing-rewards :global(.landing-reward--access) {
        view-timeline-name: --landing-access;
        view-timeline-inset: 0;
      }
      .landing-wave__fill {
        animation-name: landing-wave-grow;
        animation-duration: auto;
        animation-timing-function: var(--ease-enter);
        animation-fill-mode: backwards;
        animation-timeline: --landing-access;
        animation-range: var(--reveal-range);
        animation-range-start: entry
          calc(min(var(--wave-index), 4) * var(--reveal-step));
      }
      .landing-tier {
