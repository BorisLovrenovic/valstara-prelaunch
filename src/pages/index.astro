---
import { thinSliceCopy } from '../copy/e1-11.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title={thinSliceCopy.signupTitle}
  description={thinSliceCopy.signupDescription}
>
  <form action="/api/signup" method="post">
    <input name="email" type="email" autocomplete="email" required />
    <input name="turnstile_token" type="hidden" />
    <button type="submit">{thinSliceCopy.signupSubmit}</button>
  </form>
</BaseLayout>
