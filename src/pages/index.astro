---
import Accordion from '../components/accordion.astro';
import Button from '../components/button.astro';
import Card from '../components/card.astro';
import Container from '../components/container.astro';
import Icon from '../components/icon.astro';
import Pill from '../components/pill.astro';
import ProviderBanner from '../components/provider-banner.astro';
import ProviderRail from '../components/provider-rail.astro';
import Section from '../components/section.astro';
import landingHeroList from '../content/landing-hero.json';
import { svgIntrinsicSize } from '../components/provider-banner.ts';
import { resolveLandingHero } from '../content/landing-hero.ts';
import providerData from '../content/provider-showcase.json';
import type { Provider } from '../content/provider-showcase.ts';
import { landingCopy } from '../copy/landing.ts';
import SignupForm from '../islands/SignupForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  hasNonDefaultFlagState,
  landingCacheVary,
  landingFlagGeneration,
} from '../server/cache/landing.ts';
import { getConfig } from '../server/config.ts';
import { getFlagService } from '../server/flags/app-service.ts';
import { campaignFlagRegistry } from '../server/flags/registry.ts';
import { currentRules } from '../server/giveaway/rules-catalog.ts';
import { accessWindows, milestoneTiers } from '../server/referral/config.ts';
import { createReferralCaptureService } from '../server/referral/capture.ts';

const flags = await getFlagService().list();
const enabled = (key: keyof typeof campaignFlagRegistry) =>
  flags.find((flag) => flag.key === key)?.enabled ?? campaignFlagRegistry[key];
const signupEnabled = enabled('signup.enabled');
const referralEnabled = enabled('referral.enabled');
const giveawayEnabled = enabled('giveaway.open');
const leaderboardEnabled = enabled('leaderboard.public');
const rules = giveawayEnabled ? currentRules() : null;
const providers = providerData as Provider[];
// The logos' declared sizes, bundled at build time, so each hero image
// reserves its box before it loads (no layout shift).
const logoSources = import.meta.glob<string>('/public/images/providers/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const hero = resolveLandingHero(landingHeroList, providers, (logo) => {
  const source = logoSources[`/public${logo}`];
  return source === undefined ? null : svgIntrinsicSize(source);
});
const enabledTiers = milestoneTiers.filter((tier) => tier.enabled);
// The "How it works" step icons, in step order (E11.5-11d).
const stepIcons = ['mail', 'check-circle', 'upload-share'] as const;

const referralCaptureService = createReferralCaptureService(
  getConfig().referralSigningSecret,
);
const referralCapture = referralCaptureService.capture(Astro.url);
const signedReferralCapture =
  referralEnabled &&
  (referralCapture.ref !== null || referralCapture.utm !== null)
    ? referralCaptureService.signRef(referralCapture)
    : null;
const hasReferralQuery = Astro.url.searchParams.has('ref');
const bypassLandingCache = hasReferralQuery || hasNonDefaultFlagState(flags);
Astro.response.headers.set(
  'Cache-Control',
  bypassLandingCache ? 'private, no-store' : 'public, max-age=0, s-maxage=300',
);
Astro.response.headers.set('Vary', landingCacheVary);
Astro.response.headers.set(
  'X-Valstara-Flag-Generation',
  landingFlagGeneration(flags),
);
---

<BaseLayout
  title={landingCopy.meta.title}
  description={landingCopy.meta.description}
>
  <div class="landing">
    <section id="join" class="landing-hero" aria-labelledby="landing-title">
      <Container>
        <div class="landing-hero__grid">
          <div class="landing-hero__copy">
            <p class="landing-eyebrow">
              <Icon name="star" size="sm" />{landingCopy.hero.eyebrow}
            </p>
            <h1 id="landing-title">{landingCopy.hero.heading}</h1>
            <p class="landing-hero__body">{landingCopy.hero.body}</p>
            {
              signupEnabled ? (
                <SignupForm
                  signedReferralCapture={signedReferralCapture}
                  giveawayEnabled={giveawayEnabled}
                >
                  <ul class="landing-facts" slot="facts">
                    {landingCopy.hero.facts.map((fact) => (
                      <li>
                        <Icon name={fact.icon} size="base" />
                        <span>{fact.text}</span>
                      </li>
                    ))}
                  </ul>
                </SignupForm>
              ) : (
                <div class="landing-paused">
                  <h2>{landingCopy.paused.heading}</h2>
                  <p>{landingCopy.paused.body}</p>
                </div>
              )
            }
            <div class="landing-hero__strip" aria-hidden="true">
              {
                hero.strip.map((banner) => (
                  <ProviderBanner banner={banner} size="strip" />
                ))
              }
            </div>
          </div>
          <div class="landing-hero__stack" aria-hidden="true">
            {
              hero.stack.map((banner) => (
                <ProviderBanner banner={banner} size="stack" />
              ))
            }
          </div>
        </div>
      </Container>
    </section>

    <Section id="catalogue" aria-labelledby="catalogue-title">
      <h2 id="catalogue-title" slot="heading">
        {landingCopy.catalogue.heading}
      </h2>
      <p slot="heading">{landingCopy.catalogue.body}</p>
      <ProviderRail providers={providers} />
    </Section>

    <Section id="how" aria-labelledby="how-title">
      <h2 id="how-title" slot="heading">{landingCopy.how.heading}</h2>
      <ol class="landing-steps">
        {
          landingCopy.how.steps.map((step, index) => {
            // The last step, sharing your link, is drawn as optional.
            const optional = index === landingCopy.how.steps.length - 1;
            return (
              <li
                class:list={[
                  'landing-step',
                  { 'landing-step--optional': optional },
                ]}
              >
                <span class="landing-step__tile" aria-hidden="true">
                  <Pill variant="step" class="landing-step__badge">
                    {index + 1}
                  </Pill>
                  <Icon name={stepIcons[index]} size="md" />
                </span>
                {!optional && (
                  <span
                    class:list={[
                      'landing-step__connector',
                      {
                        'landing-step__connector--dashed':
                          index === landingCopy.how.steps.length - 2,
                      },
                    ]}
                    aria-hidden="true"
                  />
                )}
                <p class="landing-step__title">{step}</p>
              </li>
            );
          })
        }
      </ol>
    </Section>

    <Section id="rewards" aria-labelledby="rewards-title">
      <h2 id="rewards-title" slot="heading">{landingCopy.rewards.heading}</h2>
      <div class="landing-rewards">
        <Card>
          <Icon name="clock" />
          <h3>{landingCopy.rewards.accessHeading}</h3>
          <p>{landingCopy.rewards.accessBody}</p>
          <ol class="landing-waves">
            {
              accessWindows.map((_, index) => (
                <li>{landingCopy.rewards.waveLabel(index + 1)}</li>
              ))
            }
          </ol>
        </Card>
        {
          referralEnabled && enabledTiers.length > 0 && (
            <Card data-referral-card>
              <Icon name="link" />
              <h3>{landingCopy.rewards.referralHeading}</h3>
              <ul class="landing-tiers">
                {enabledTiers.map((tier) => (
                  <li>{landingCopy.rewards.tier(tier)}</li>
                ))}
              </ul>
              <p>{landingCopy.rewards.held}</p>
              <p>{landingCopy.rewards.verifiedOnly}</p>
            </Card>
          )
        }
        {
          rules !== null && (
            <Card data-giveaway-card>
              <Icon name="star" />
              <h3>{landingCopy.rewards.giveawayHeading}</h3>
              <p>{landingCopy.rewards.prize(rules)}</p>
              <p>
                {landingCopy.rewards.freeEntry} · {landingCopy.rewards.age}
              </p>
              <a href="/giveaway/rules">{landingCopy.rewards.rulesLink}</a>
            </Card>
          )
        }
      </div>
      {
        leaderboardEnabled && (
          <p class="landing-leaderboard">
            <a href="/leaderboard">{landingCopy.rewards.leaderboardLink}</a>
          </p>
        )
      }
    </Section>

    <Section
      id="guarantee"
      variant="midnight"
      aria-labelledby="guarantee-title"
    >
      <h2 id="guarantee-title" slot="heading">{landingCopy.trust.heading}</h2>
      <p class="landing-intro">{landingCopy.trust.intro}</p>
      <ol class="landing-guarantee">
        {
          landingCopy.trust.promises.map((promise) => (
            <li>
              <span class="landing-guarantee__numeral" aria-hidden="true">
                {promise.numeral}
              </span>
              <h3>{promise.title}</h3>
              <p>{promise.line}</p>
            </li>
          ))
        }
      </ol>
      <a class="landing-guarantee__link" href="/guarantee">
        {landingCopy.trust.link}
      </a>
    </Section>

    <Section aria-labelledby="trust-links-title">
      <h2 id="trust-links-title" slot="heading">
        {landingCopy.trustLinks.heading}
      </h2>
      <div class="landing-trust-links">
        {
          landingCopy.trustLinks.items.map((item) => (
            <Card interactive>
              <h3>
                <a href={item.href}>{item.heading}</a>
              </h3>
              <p>{item.line}</p>
            </Card>
          ))
        }
      </div>
    </Section>

    <Section id="faq" aria-labelledby="faq-title">
      <h2 id="faq-title" slot="heading">{landingCopy.faq.heading}</h2>
      <div class="landing-faq">
        {
          landingCopy.faq.items.map((item) => (
            <Accordion summary={item.question}>{item.answer}</Accordion>
          ))
        }
      </div>
    </Section>

    <Section class="landing-final" aria-labelledby="final-title">
      <h2 id="final-title" slot="heading">{landingCopy.final.heading}</h2>
      <Button href="#join" data-focus-signup>{landingCopy.final.action}</Button>
    </Section>
  </div>
</BaseLayout>

<style>
  .landing {
    margin-inline: calc(-1 * var(--space-3));
    margin-block-start: calc(-1 * var(--space-4));
  }
  .landing :global(h1),
  .landing :global(h2),
  .landing :global(h3),
  .landing :global(p) {
    margin-block-start: var(--space-0);
  }
  .landing :global(h1) {
    font-size: var(--step-5);
    font-weight: var(--weight-bold);
    line-height: var(--leading-5);
    letter-spacing: var(--tracking-tight);
  }
  .landing :global(h2) {
    font-size: var(--step-4);
    line-height: var(--leading-4);
  }
  .landing :global(h3) {
    font-size: var(--step-3);
    line-height: var(--leading-3);
  }
  /*
    The #join hero from the wireframes (E11.5-11c). Small: one column, 24px
    top padding, the logo strip 24px below the form. Medium (48rem): 40px top
    padding, the text in columns 1-7 and the banner stack in 8-12, rows
    centred. Large (64rem): 48px top padding and the large stack. The section
    gap above the catalogue is the only space below the hero.
  */
  .landing-hero {
    padding-block-start: var(--space-3);
  }
  .landing-hero__copy {
    min-width: 0;
  }
  .landing-eyebrow {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    color: var(--ink-600);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
  }
  .landing-eyebrow :global(.icon) {
    color: var(--coral);
  }
  .landing-hero h1,
  .landing-hero :global(p) {
    margin-block-end: var(--space-0);
  }
  .landing-hero h1 {
    margin-block-start: var(--space-1-5);
  }
  /* Under .landing-hero so it outranks the page's paragraph reset. */
  .landing-hero .landing-hero__body {
    max-inline-size: calc(var(--space-10) * 7.5);
    margin-block-start: var(--space-1-5);
    color: var(--ink-600);
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }
  .landing-intro {
    max-width: var(--measure);
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }
  .landing-hero :global(valstara-signup-form),
  .landing-paused {
    max-inline-size: calc(var(--space-10) * 7);
    margin-block-start: var(--space-3);
  }
  .landing-facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2-5);
    margin: var(--space-0);
    padding: var(--space-0);
    color: var(--ink);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
    list-style: none;
  }
  .landing-facts li {
    display: inline-flex;
    gap: var(--space-1);
    align-items: center;
  }
  .landing-facts :global(.icon) {
    color: var(--ink-600);
  }
  /* Three 56px banners, 8px apart, flexing 1 : 1 : 1.35. */
  .landing-hero__strip {
    display: flex;
    gap: var(--space-1);
    margin-block-start: var(--space-3);
  }
  .landing-hero__strip :global(.hero-banner) {
    flex: 1 1 0;
  }
  .landing-hero__strip :global(.hero-banner:last-child) {
    flex-grow: 1.35;
  }
  .landing-hero__stack {
    display: none;
  }
  .landing-paused {
    padding: var(--space-3);
    background: var(--surface);
    border: thin solid var(--line);
    border-radius: var(--radius-card);
  }
  .landing-steps,
  .landing-waves,
  .landing-tiers,
  .landing-guarantee {
    margin: var(--space-0);
    padding: var(--space-0);
    list-style: none;
  }
  .landing-intro {
    margin-block-end: var(--space-4);
  }
  /*
    Below 64rem the catalogue rail bleeds into the right gutter. Its content
    cell spans that gutter as padding, so the bleed stays inside a box.
  */
  .landing :global(#catalogue .container__content) {
    grid-column: 2 / 4;
    padding-inline-end: var(--gutter);
  }
  .landing-rewards,
  .landing-guarantee,
  .landing-trust-links {
    display: grid;
    gap: var(--space-3);
  }
  /*
    "How it works" (E11.5-11d). Small: one column, 28px apart, each step a row
    of the 56px tile and its 16/24 title, joined by a 2px by 24px vertical
    connector 27px from the left and 60px from the top. Medium and large:
    three columns, 24px apart, each step a column with 16px gaps, the 20/28
    title, and a horizontal connector 27px from the top, from 72px right of
    the tile to 8px short of the column's end, with an arrowhead. The
    connector into the optional third step is dashed.
  */
  /* The 28px between small steps is each step's own bottom padding, so the
     connector into the next step stays inside its list item. */
  .landing-steps {
    display: grid;
  }
  .landing-step:not(:last-child) {
    padding-block-end: calc(var(--space-1) * 3.5);
  }
  .landing-step {
    position: relative;
    display: flex;
    gap: var(--space-2);
    align-items: center;
  }
  .landing-step__tile {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-7);
    block-size: var(--space-7);
    color: var(--ink);
    background: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1), var(--edge);
  }
  .landing-step__tile :global(.landing-step__badge) {
    position: absolute;
    top: calc(var(--space-1) * -1.25);
    left: calc(var(--space-1) * -1.25);
  }
  .landing-step--optional .landing-step__tile {
    color: var(--ink-600);
    background: var(--paper);
    border: var(--border-check) dashed var(--ink-300);
    box-shadow: none;
  }
  .landing-step--optional .landing-step__tile :global(.landing-step__badge) {
    background-color: var(--ink-600);
  }
  .landing-step__connector {
    position: absolute;
    top: calc(var(--space-1) * 7.5);
    left: calc(var(--space-1) * 3.375);
    inline-size: var(--border-strong);
    block-size: var(--space-3);
    background: var(--ink-300);
  }
  .landing-step__connector--dashed {
    inline-size: var(--space-0);
    background: none;
    border-inline-start: var(--border-strong) dashed var(--ink-300);
  }
  .landing .landing-step__title {
    margin-block: var(--space-0);
    font-size: var(--step-2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-2);
    letter-spacing: var(--tracking-tight);
  }
  .landing-step--optional .landing-step__title {
    color: var(--ink-600);
  }
  .landing-rewards :global(.card) {
    min-width: 0;
  }
  .landing-rewards :global(.icon) {
    color: var(--coral);
  }
  .landing-rewards {
    font-variant-numeric: tabular-nums;
  }
  .landing-waves {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-1);
    margin-block-start: var(--space-3);
  }
  .landing-waves li {
    padding: var(--space-1);
    text-align: center;
    font-size: var(--step-0);
    background: var(--coral-tint);
    color: var(--ink);
    border-radius: var(--radius-control);
  }
  .landing-tiers {
    display: grid;
    gap: var(--space-2);
  }
  .landing-tiers li {
    font-weight: var(--weight-semibold);
  }
  .landing-leaderboard {
    margin-block-start: var(--space-3);
  }
  .landing-guarantee__numeral {
    display: block;
    color: var(--coral);
    font-size: var(--step-4);
    font-weight: var(--weight-bold);
    line-height: var(--leading-4);
  }
  .landing-guarantee p {
    margin-block-end: var(--space-0);
  }
  .landing-guarantee__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-block-start: var(--space-3);
    color: var(--on-midnight);
  }
  .landing-trust-links :global(.card) {
    min-width: 0;
  }
  .landing-trust-links a,
  .landing-rewards a,
  .landing-leaderboard a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--ink);
  }
  .landing-faq {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }
  .landing-final {
    padding-block-end: var(--space-8);
  }
  @media (min-width: 48rem) {
    .landing :global(#catalogue .container__content) {
      padding-inline-end: var(--gutter-wide);
    }
    .landing-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-3);
    }
    .landing-step:not(:last-child) {
      padding-block-end: var(--space-0);
    }
    .landing-step {
      flex-direction: column;
      align-items: flex-start;
    }
    .landing-step__connector {
      top: calc(var(--space-1) * 3.375);
      right: var(--space-1);
      left: calc(var(--space-1) * 9);
      inline-size: auto;
      block-size: var(--border-strong);
    }
    .landing-step__connector::after {
      position: absolute;
      top: calc(var(--space-1) * -0.625);
      right: calc(var(--space-1) * -0.25);
      border-block: calc(var(--space-1) * 0.75) solid transparent;
      border-inline-start: calc(var(--space-1) * 0.875) solid var(--ink-300);
      content: '';
    }
    .landing-step__connector--dashed {
      block-size: var(--space-0);
      border-inline-start: none;
      border-block-start: var(--border-strong) dashed var(--ink-300);
    }
    .landing-step__connector--dashed::after {
      top: calc(var(--space-1) * -0.875);
    }
    .landing .landing-step__title {
      font-size: var(--step-3);
      line-height: var(--leading-3);
    }
    .landing-hero {
      padding-block-start: var(--space-5);
    }
    .landing-hero__grid {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns-wide), minmax(0, 1fr));
      column-gap: var(--grid-gap-wide);
      align-items: center;
    }
    .landing-hero__copy {
      grid-column: 1 / span 7;
    }
    .landing-hero .landing-hero__body {
      margin-block-start: var(--space-2);
    }
    .landing-hero :global(valstara-signup-form),
    .landing-paused {
      margin-block-start: var(--space-4);
    }
    .landing-hero__strip {
      display: none;
    }
    /*
      Medium: 290px tall; 136px banners at 84.5% of the column (236px at
      768), stepped 76px down and 8% and 15.5% of the column in (22px and
      43px at 768, drawn 22 and 44). Width plus the last offset is exactly
      the column, so the stack never crosses into column 7. Netflix, last,
      is drawn on top.
    */
    .landing-hero__stack {
      position: relative;
      display: block;
      grid-column: 8 / span 5;
      block-size: calc(var(--space-10) * 3.625);
    }
    .landing-hero__stack :global(.hero-banner) {
      position: absolute;
      width: 84.5%;
    }
    .landing-hero__stack :global(.hero-banner:nth-child(1)) {
      top: var(--space-0);
      right: var(--space-0);
    }
    .landing-hero__stack :global(.hero-banner:nth-child(2)) {
      top: calc(var(--space-1) * 9.5);
      right: calc(100% * 0.08);
    }
    .landing-hero__stack :global(.hero-banner:nth-child(3)) {
      top: calc(var(--space-1) * 19);
      right: calc(100% * 0.155);
    }
  }
  @media (min-width: 64rem) {
    .landing :global(#catalogue .container__content) {
      grid-column: 2;
      padding-inline-end: var(--space-0);
    }
    .landing-hero {
      padding-block-start: var(--space-6);
    }
    .landing-eyebrow {
      font-size: var(--step-2);
      line-height: var(--leading-2);
    }
    .landing-facts {
      column-gap: var(--space-3);
    }
    /*
      Large: 400px tall; 184px banners at 70% of the column (340px at 1440),
      stepped 104px down and 15% of the column in.
    */
    .landing-hero__stack {
      block-size: calc(var(--space-10) * 5);
    }
    .landing-hero__stack :global(.hero-banner) {
      width: 70%;
    }
    .landing-hero__stack :global(.hero-banner:nth-child(2)) {
      top: calc(var(--space-1) * 13);
      right: calc(100% * 0.15);
    }
    .landing-hero__stack :global(.hero-banner:nth-child(3)) {
      top: calc(var(--space-1) * 26);
      right: calc(100% * 0.3);
    }
    .landing-guarantee,
    .landing-trust-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .landing-rewards {
