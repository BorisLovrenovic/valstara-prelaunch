---
import { leaderboardCopy } from '../copy/leaderboard.ts';
import Container from '../components/container.astro';
import LeaderboardPaused from '../layouts/leaderboard-paused.astro';
import Leaderboard from '../islands/Leaderboard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFlagService } from '../server/flags/app-service.ts';

const leaderboardEnabled =
  await getFlagService().isEnabled('leaderboard.public');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<BaseLayout
  title={leaderboardCopy.meta.title}
  description={leaderboardCopy.meta.description}
>
  <div class="leaderboard-page">
    <Container class="leaderboard-container">
      {
        // With the switch off, the heading, the intro and the paused card
        // only, outside the flagged section (E11.5-11r decision 3).
        leaderboardEnabled ? <Leaderboard /> : <LeaderboardPaused />
      }
    </Container>
  </div>
</BaseLayout>

<style>
  /* The page takes back the shell's main padding, as /verify and /me do, so
     the intro sits on the canvas's gutters 32, 48 or 64px below the header. */
  .leaderboard-page {
    margin-inline: calc(-1 * var(--space-3));
    margin-block-start: calc(-1 * var(--space-4));
  }

  :global(.leaderboard-container) {
    padding-block-start: var(--space-4);
  }

  @media (min-width: 48rem) {
    :global(.leaderboard-container) {
      padding-block-start: var(--space-6);
    }
  }

  @media (min-width: 64rem) {
    :global(.leaderboard-container) {
      padding-block-start: var(--space-8);
    }
  }
</style>
