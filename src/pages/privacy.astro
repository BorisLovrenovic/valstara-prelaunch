---
import { getEntry, render } from 'astro:content';
import { legalPageCopy } from '../copy/legal.ts';
import TrustPage from '../layouts/trust-page.astro';

export const prerender = true;

const entry = await getEntry('legal', 'privacy');
if (!entry || entry.data.portTarget !== '/privacy') {
  throw new Error('Missing or misrouted /privacy content.');
}
const { Content } = await render(entry);
---

<TrustPage
  title={legalPageCopy.privacy.title}
  description={legalPageCopy.privacy.description}
>
  <Content />
</TrustPage>
