---
import Button from '../../../components/button.astro';
import Container from '../../../components/container.astro';
import Icon from '../../../components/icon.astro';
import { pricesCopy } from '../../../copy/prices.ts';
import SignupForm from '../../../islands/SignupForm.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TaskCard from '../../../layouts/task-card.astro';
import {
  hasNonDefaultFlagState,
  landingCacheVary,
  landingFlagGeneration,
} from '../../../server/cache/landing.ts';
import { landingReferralField } from '../../../server/cache/render.ts';
import { getConfig } from '../../../server/config.ts';
import { getFlagService } from '../../../server/flags/app-service.ts';
import { campaignFlagRegistry } from '../../../server/flags/registry.ts';
import { bundledPriceSite } from '../../../server/prices/bundled.ts';
import { pricesPausedRetryAfterSeconds } from '../../../server/prices/route.ts';
import { createReferralCaptureService } from '../../../server/referral/capture.ts';
import { jsonLd } from '../../../server/seo.ts';

// The service × market price page (E11.6-10). Server-rendered on request from
// the price data bundled at build (D1), through the origin render cache, with
// the landing page's cache contract and its server-signed referral field
// (E4-02). The view model is `src/server/prices/site.ts`; this page only
// renders it. E11.6-11 adds the price history, the cross-market comparison,
// the Valstara comparison (behind `prices.valstara_comparison`), related
// services and the FAQ, each rendered only when the data holds it.
// E11.6-12 adds the links to the page's two hubs, and answers a URL the
// founder has retired, while it generates no page, with a 301 to its
// recorded hub (D2 and D-037 Q2). E11.6-13 adds the link to the methodology
// at `/price-index`.

const flags = await getFlagService().list();
const enabled = (key: keyof typeof campaignFlagRegistry) =>
  flags.find((flag) => flag.key === key)?.enabled ?? campaignFlagRegistry[key];
const pagesEnabled = enabled('prices.pages');
const flagGeneration = landingFlagGeneration(flags);
Astro.response.headers.set('Vary', landingCacheVary);
Astro.response.headers.set('X-Valstara-Flag-Generation', flagGeneration);

// `prices.pages` off pulls every price route at once, before any lookup: a
// 503 that asks crawlers to come back, never a 404 (docs/features/
// price-index.md#feature-flag).
if (!pagesEnabled) {
  Astro.response.status = 503;
  Astro.response.headers.set(
    'Retry-After',
    String(pricesPausedRetryAfterSeconds),
  );
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}

const path = `/prices/${Astro.params.service ?? ''}/${Astro.params.country ?? ''}`;
// A retired URL that generates no page answers 301 to the hub the ledger
// records (E11.6-12, D2 and D-037 Q2); a generated page is always served.
const retiredTo = pagesEnabled ? bundledPriceSite().redirect(path) : null;
if (retiredTo !== null) {
  return Astro.redirect(retiredTo, 301);
}
const view = pagesEnabled ? bundledPriceSite().route(path) : null;
// A pair that is neither generated nor in the ledger answers the branded 404.
if (pagesEnabled && view === null) {
  return new Response(null, { status: 404 });
}

const signupEnabled = enabled('signup.enabled');
// E11.6-11: no Valstara price renders while this is off, whatever
// config/valstara-prices.json holds.
const valstaraEnabled = enabled('prices.valstara_comparison');
const giveawayEnabled = enabled('giveaway.open');
const signedReferralCapture = landingReferralField(
  createReferralCaptureService(getConfig().referralSigningSecret),
  Astro.url,
  flags,
);
if (view !== null) {
  // The origin render cache stores this render under its flag generation and
  // substitutes each request's own signed field (G7-1-I4).
  Astro.locals.renderCache = {
    generation: flagGeneration,
    field: signedReferralCapture,
  };
  const bypassCache =
    Astro.url.searchParams.has('ref') || hasNonDefaultFlagState(flags);
  Astro.response.headers.set(
    'Cache-Control',
    bypassCache ? 'private, no-store' : 'public, max-age=0, s-maxage=300',
  );
  if (view.kind === 'unavailable') {
    Astro.response.headers.set('X-Robots-Tag', 'noindex');
  }
}
const lastCrumb = view === null ? -1 : view.breadcrumbs.length - 1;
---

{
  view === null ? (
    <BaseLayout
      title={pricesCopy.paused.meta.title}
      description={pricesCopy.paused.meta.description}
    >
      <meta slot="head" name="robots" content="noindex" />
      <TaskCard
        heading={pricesCopy.paused.heading}
        icon="pause"
        tone="neutral"
        state="prices-paused"
        line={pricesCopy.paused.body}
      >
        <div class="task-card__actions">
          <Button href="/">{pricesCopy.paused.home}</Button>
        </div>
      </TaskCard>
    </BaseLayout>
  ) : (
    <BaseLayout title={view.meta.title} description={view.meta.description}>
      {view.kind === 'unavailable' && (
        <meta slot="head" name="robots" content="noindex" />
      )}
      <script
        is:inline
        slot="head"
        type="application/ld+json"
        set:html={jsonLd(view.structuredData)}
      />
      {view.kind === 'generated' && view.faqStructuredData !== null && (
        <script
          is:inline
          slot="head"
          type="application/ld+json"
          set:html={jsonLd(view.faqStructuredData)}
        />
      )}
      <article
        class="price-page"
        data-price-page={view.kind}
        data-service={view.serviceId}
        data-market={view.market}
      >
        <Container class="price-page__body">
          <nav
            class="price-breadcrumbs"
            aria-label={pricesCopy.breadcrumbLabel}
          >
            <ol>
              {view.breadcrumbs.map((crumb, index) =>
                index === lastCrumb ? (
                  <li>
                    <span aria-current="page">{crumb.name}</span>
                  </li>
                ) : (
                  <li>
                    <a href={new URL(crumb.url).pathname}>{crumb.name}</a>
                  </li>
                ),
              )}
            </ol>
          </nav>
          <h1>{view.heading}</h1>
          {view.kind === 'generated' ? (
            <div class="price-page__plans">
              <table class="price-table" data-price-table>
                <caption>{view.tableCaption}</caption>
                <thead>
                  <tr>
                    <th scope="col">{pricesCopy.page.columns.plan}</th>
                    <th scope="col">{pricesCopy.page.columns.price}</th>
                    <th scope="col">{pricesCopy.page.columns.verified}</th>
                  </tr>
                </thead>
                <tbody>
                  {view.rows.map((row) => (
                    <tr
                      data-plan={row.planId}
                      data-billing-period={row.billingPeriod}
                    >
                      <th scope="row">{row.planName}</th>
                      <td>
                        <span
                          class="price-table__amount"
                          data-price-amount={row.amount}
                          data-price-currency={row.currency}
                        >
                          {row.priceText}
                        </span>
                        <span class="price-table__period">
                          {row.periodText}
                        </span>
                      </td>
                      <td>
                        <time datetime={row.verifiedOn}>
                          {row.verifiedText}
                        </time>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="price-page__verified" data-verified-line>
                {view.verifiedLine}
              </p>
            </div>
          ) : (
            <p class="price-page__unavailable" role="status" data-unavailable>
              <Icon name="info" size="base" />
              <span>{view.note}</span>
            </p>
          )}
          <p class="price-page__verified">
            <a href={view.methodologyLink.path} data-methodology-link>
              {view.methodologyLink.label}
            </a>
          </p>
          {view.kind === 'generated' && view.history.length > 0 && (
            <section
              class="price-block"
              aria-labelledby="price-history-title"
              data-price-history
            >
              <h2 id="price-history-title">
                {pricesCopy.page.history.heading}
              </h2>
              <ul class="price-history">
                {view.history.map((item) => (
                  <li
                    data-history-plan={item.planId}
                    data-history-old={item.oldAmount}
                    data-history-new={item.newAmount}
                    data-history-currency={item.currency}
                    data-history-date={item.detectedOn}
                  >
                    <span class="price-history__plan">{item.planName}</span>
                    <span class="price-history__change">{item.text}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
          {view.kind === 'generated' && view.comparisons.length > 0 && (
            <section
              class="price-block"
              aria-labelledby="price-comparison-title"
              data-price-comparison
            >
              <h2 id="price-comparison-title">
                {pricesCopy.page.comparison.heading}
              </h2>
              {view.comparisons.map((comparison) => (
                <div
                  class="price-comparison"
                  data-comparison-plan={comparison.planId}
                  data-comparison-rank={comparison.rank}
                  data-comparison-markets={comparison.rankedMarkets}
                >
                  <p data-rank-sentence>{comparison.sentence}</p>
                  {comparison.extremes !== null && (
                    <table class="price-table" data-extremes-table>
                      <caption>{comparison.tableCaption}</caption>
                      <thead>
                        <tr>
                          <th scope="col">
                            {pricesCopy.page.comparison.columns.position}
                          </th>
                          <th scope="col">
                            {pricesCopy.page.comparison.columns.market}
                          </th>
                          <th scope="col">
                            {pricesCopy.page.comparison.columns.price}
                          </th>
                        </tr>
                      </thead>
                      <tbody>
                        {(
                          [
                            [
                              pricesCopy.page.comparison.mostExpensive,
                              comparison.extremes.mostExpensive,
                            ],
                            [
                              pricesCopy.page.comparison.cheapest,
                              comparison.extremes.cheapest,
                            ],
                          ] as const
                        ).map(([position, extreme]) => (
                          <tr data-extreme-market={extreme.market}>
                            <th scope="row">{position}</th>
                            <td>{extreme.marketName}</td>
                            <td>
                              <span
                                class="price-table__amount"
                                data-extreme-amount={extreme.amount}
                                data-extreme-currency={extreme.currency}
                              >
                                {extreme.priceText}
                              </span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}
                </div>
              ))}
            </section>
          )}
          {view.kind === 'generated' &&
            valstaraEnabled &&
            view.valstara !== null && (
              <section
                class="price-block"
                aria-labelledby="price-valstara-title"
                data-valstara-comparison
              >
                <h2 id="price-valstara-title">
                  {pricesCopy.page.valstara.heading}
                </h2>
                <table class="price-table">
                  <caption>{view.valstara.tableCaption}</caption>
                  <thead>
                    <tr>
                      <th scope="col">
                        {pricesCopy.page.valstara.columns.plan}
                      </th>
                      <th scope="col">
                        {pricesCopy.page.valstara.columns.term}
                      </th>
                      <th scope="col">
                        {pricesCopy.page.valstara.columns.list}
                      </th>
                      <th scope="col">
                        {pricesCopy.page.valstara.columns.valstara}
                      </th>
                      <th scope="col">
                        {pricesCopy.page.valstara.columns.below}
                      </th>
                    </tr>
                  </thead>
                  <tbody>
                    {view.valstara.rows.map((row) => (
                      <tr
                        data-valstara-plan={row.planId}
                        data-valstara-term={row.termMonths}
                      >
                        <th scope="row">{row.planName}</th>
                        <td>{row.termText}</td>
                        <td>
                          <span
                            class="price-table__amount"
                            data-list-amount={row.listAmount}
                          >
                            {row.listText}
                          </span>
                        </td>
                        <td>
                          <span
                            class="price-table__amount"
                            data-valstara-amount={row.valstaraAmount}
                          >
                            {row.valstaraText}
                          </span>
                        </td>
                        <td>
                          <span
                            class="price-table__amount"
                            data-below-percent={row.belowPercent}
                          >
                            {row.belowText}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {view.valstara.rows
                  .filter((row) => row.basis !== null)
                  .map((row) => (
                    <p
                      class="price-block__note"
                      data-valstara-basis={`${row.planId}/${row.termMonths}`}
                    >
                      {row.basis}
                    </p>
                  ))}
              </section>
            )}
          {view.kind === 'generated' && view.related.length > 0 && (
            <nav
              class="price-block"
              aria-labelledby="price-related-title"
              data-price-related
            >
              <h2 id="price-related-title">
                {pricesCopy.page.related.heading(view.marketName)}
              </h2>
              <ul class="price-related">
                {view.related.map((link) => (
                  <li>
                    <a href={link.path} data-related-service={link.serviceId}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          {view.kind === 'generated' && view.faq.length > 0 && (
            <section
              class="price-block"
              aria-labelledby="price-faq-title"
              data-price-faq
            >
              <h2 id="price-faq-title">{pricesCopy.page.faq.heading}</h2>
              <dl class="price-faq">
                {view.faq.map((entry) => (
                  <div class="price-faq__entry">
                    <dt>{entry.question}</dt>
                    <dd>{entry.answer}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}
          {view.hubLinks.length > 0 && (
            <nav
              class="price-block"
              aria-labelledby="price-hubs-title"
              data-price-hubs
            >
              <h2 id="price-hubs-title">{pricesCopy.hubs.pageLinksHeading}</h2>
              <ul class="price-related">
                {view.hubLinks.map((link) => (
                  <li>
                    <a href={link.path} data-hub-link={link.path}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          <p class="price-page__independent">{view.notAffiliated}</p>
        </Container>
        <section id="join" class="price-cta" aria-labelledby="price-cta-title">
          <Container class="price-cta__inner">
            <h2 id="price-cta-title">{pricesCopy.page.cta.heading}</h2>
            <p class="price-cta__body">{pricesCopy.page.cta.body}</p>
            {signupEnabled ? (
              <SignupForm
                signedReferralCapture={signedReferralCapture}
                giveawayEnabled={giveawayEnabled}
              />
            ) : (
              <div class="price-cta__paused" role="status">
                <h3>{pricesCopy.page.signupPaused.heading}</h3>
                <p>{pricesCopy.page.signupPaused.body}</p>
              </div>
            )}
          </Container>
        </section>
      </article>
    </BaseLayout>
  )
}

<style>
  .price-page {
    display: grid;
    gap: var(--section-gap);
  }

  :global(.price-page__body) {
    display: grid;
    gap: var(--space-3);
  }

  .price-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink-600);
    font-size: var(--step-0);
  }

  .price-breadcrumbs li + li::before {
    content: '/';
    margin-inline-end: var(--space-1);
    color: var(--ink-300);
  }

  .price-breadcrumbs a {
    color: inherit;
    text-underline-offset: var(--underline-offset);
  }

  .price-page h1 {
    margin: 0;
    max-inline-size: var(--measure);
    font-size: var(--step-4);
    line-height: var(--leading-1);
    letter-spacing: var(--tracking-tight);
  }

  .price-page__plans {
    display: grid;
    gap: var(--space-2);
  }

  .price-table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--step-0);
  }

  .price-table caption {
    padding-block-end: var(--space-1-5);
    color: var(--ink-600);
    text-align: start;
  }

  .price-table th,
  .price-table td {
    padding: var(--space-1-5) var(--space-1);
    border-block-end: var(--border-thin) solid var(--line);
    text-align: start;
    vertical-align: top;
    overflow-wrap: anywhere;
  }

  .price-table thead th {
    color: var(--ink-600);
    font-weight: var(--weight-medium);
  }

  .price-table tbody th {
    font-weight: var(--weight-semibold);
  }

  /* Every published number is set in the monospace token. */
  .price-table__amount,
  .price-table time {
    font-family: var(--font-mono);
  }

  .price-table__amount {
    display: block;
    font-weight: var(--weight-semibold);
  }

  .price-table__period {
    color: var(--ink-600);
  }

  .price-page__verified,
  .price-page__independent {
    margin: 0;
    max-inline-size: var(--measure);
    color: var(--ink-600);
  }

  .price-page__verified a {
    text-underline-offset: var(--underline-offset);
  }

  .price-page__unavailable {
    display: flex;
    gap: var(--space-1);
    align-items: flex-start;
    margin: 0;
    padding: var(--space-2);
    border-radius: var(--radius-card);
    background: var(--well);
    max-inline-size: var(--measure);
  }

  .price-block {
    display: grid;
    gap: var(--space-2);
    max-inline-size: var(--measure);
  }

  .price-block h2 {
    margin: 0;
    font-size: var(--step-3);
    line-height: var(--leading-3);
  }

  .price-block p,
  .price-block ul,
  .price-faq,
  .price-faq dd {
    margin: 0;
  }

  .price-block__note {
    color: var(--ink-600);
  }

  .price-history,
  .price-related {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .price-history li {
    display: grid;
    gap: var(--space-0-5);
  }

  .price-history__plan {
    font-weight: var(--weight-semibold);
  }

  .price-comparison {
    display: grid;
    gap: var(--space-1-5);
  }

  .price-related a {
    text-underline-offset: var(--underline-offset);
  }

  .price-faq {
    display: grid;
    gap: var(--space-2);
  }

  .price-faq dt {
    font-weight: var(--weight-semibold);
  }

  .price-faq dd {
    color: var(--ink-600);
  }

  .price-cta {
    padding-block: var(--section-gap);
    background: var(--wash);
  }

  :global(.price-cta__inner) {
    display: grid;
    gap: var(--space-2);
    max-inline-size: var(--measure);
  }

  .price-cta h2 {
    margin: 0;
    font-size: var(--step-3);
    line-height: var(--leading-2);
  }

  .price-cta__body {
    margin: 0;
    color: var(--ink-600);
  }

  .price-cta__paused h3 {
    margin: 0;
    font-size: var(--step-1);
  }

  .price-cta__paused p {
    margin: 0;
  }

  @media (min-width: 48rem) {
    .price-table th,
    .price-table td {
      padding-inline: var(--space-2);
    }

    .price-page h1 {
      font-size: var(--step-5);
    }
  }
</style>
