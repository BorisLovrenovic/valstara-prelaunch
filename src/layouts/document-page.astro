---
import Button from '../components/button.astro';
import Container from '../components/container.astro';
import TextLink from '../components/text-link.astro';
import { documentPagesCopy } from '../copy/document-pages.ts';
import { landingCopy } from '../copy/landing.ts';
import { layoutCopy } from '../copy/layout.ts';
import type { ContentsEntry } from '../server/content/contents.ts';

interface Props {
  kind: 'trust' | 'legal' | 'rules';
  // The page's summary line: its content description (trust, rules) or its
  // legal.ts entry. It is never written here.
  summary: string;
  // Section anchors already present in the rendered content (legal, rules).
  contents?: ContentsEntry[];
}

const { kind, summary, contents = [] } = Astro.props;
const eyebrow = documentPagesCopy.eyebrow[kind];
const onGuarantee = Astro.url.pathname.replace(/\/+$/u, '') === '/guarantee';
const hasAside = kind === 'trust' || contents.length > 0;
---

{
  /*
  E11.5-09, restyled by E11.5-11s (Doc.dc.html). The default slot is the
  page's content article, with class "document__prose": the content's own H1
  is its first child and stays the page's only H1. Nothing is added inside
  that article, and the giveaway rules article stays byte-identical to its
  recorded hash. The eyebrow sits immediately before the article and the
  summary immediately after it; the grid below draws the H1 between them in
  the full-bleed header band. The side card follows the summary in the source
  and is placed beside the prose from 64rem, after it below. Styling is CSS
  only, hides no part of the content, and never animates inside the article.
*/
}
<Container class="document-container">
  <slot name="notice" />
  <div
    class="document"
    data-document-kind={kind}
    data-document-variant={onGuarantee ? 'guarantee' : undefined}
  >
    <div class="document__main" data-document-aside={hasAside ? '' : undefined}>
      <p class="document__eyebrow" data-document-eyebrow>{eyebrow}</p>
      <slot />
      <p class="document__summary" data-document-summary>{summary}</p>
      {
        kind === 'trust' ? (
          <aside
            class="document__aside"
            aria-label={documentPagesCopy.guarantee.label}
          >
            <div
              class="document__card"
              data-document-card="guarantee"
              data-enter="shift"
              style="--enter-index: 3"
            >
              <h2 class="document__card-heading">
                {documentPagesCopy.guarantee.heading}
              </h2>
              <ol class="document__promises">
                {landingCopy.trust.promises.map((promise) => (
                  <li class="document__promise">
                    <span class="document__numeral" aria-hidden="true">
                      {promise.numeral}
                    </span>
                    <span class="document__promise-title">{promise.title}</span>
                  </li>
                ))}
              </ol>
              <div class="document__card-actions">
                {!onGuarantee && (
                  <TextLink class="document__card-link" href="/guarantee" arrow>
                    {documentPagesCopy.guarantee.readLink}
                  </TextLink>
                )}
                <Button
                  class="document__join"
                  href={`/${layoutCopy.joinAnchor}`}
                  full
                >
                  {layoutCopy.joinLabel}
                </Button>
              </div>
            </div>
          </aside>
        ) : (
          contents.length > 0 && (
            <nav
              class="document__aside"
              aria-label={documentPagesCopy.contents.label}
            >
              <div
                class="document__card"
                data-document-card="contents"
                data-enter="shift"
                style="--enter-index: 3"
              >
                <h2 class="document__card-heading">
                  {documentPagesCopy.contents.heading}
                </h2>
                <ol class="document__contents">
                  {contents.map((entry) => (
                    <li>
                      <a href={`#${entry.id}`}>{entry.text}</a>
                    </li>
                  ))}
                </ol>
              </div>
            </nav>
          )
        )
      }
    </div>
  </div>
</Container>
{
  /* Small widths, trust pages only: a link to the signup form, not a form. It
     needs no script, so it is always present below 48rem and never above. */
  kind === 'trust' && (
    <div class="document-join-bar" data-join-bar>
      <Button
        class="document-join-bar__link"
        href={`/${layoutCopy.joinAnchor}`}
      >
        {documentPagesCopy.joinBar.label}
      </Button>
    </div>
  )
}

<style is:global>
  /* The page starts at the header: the band (or an archived revision's
     notice) takes the place of the shell's top padding (.site-main). */
  .document-container {
    margin-block-start: calc(-1 * var(--space-4));
  }

  .document {
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }

  /* One grid holds the band, the prose and the side card. The article is
     display: contents, so its children are grid items: the eyebrow, the
     content's H1 and the summary take the first three rows, in the band,
     and the rest of the content flows below in source order. */
  .document__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    min-inline-size: 0;
  }

  /* The band: a surface paint behind the first three rows, bled to both
     viewport edges. A shadow is ink overflow, so the bleed never widens the
     page, and the clip keeps it to the band's own height. */
  .document__main::before {
    grid-row: 1 / 4;
    grid-column: 1 / -1;
    background-color: var(--surface);
    box-shadow: 0 0 0 var(--bleed) var(--surface);
    clip-path: inset(0 calc(-1 * var(--bleed)));
    content: '';
  }

  .document[data-document-variant='guarantee'] .document__main::before {
    background-color: var(--midnight);
    box-shadow: 0 0 0 var(--bleed) var(--midnight);
  }

  .document__eyebrow,
  .document__prose > h1:first-child,
  .document__summary {
    position: relative;
    grid-column: 1 / -1;
    margin: 0;
    max-inline-size: calc(var(--space-10) * 9.4);
  }

  /* The eyebrow: 14/20 600 ink-600 after a 16 × 2 coral rule. */
  .document__eyebrow {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    grid-row: 1;
    padding-block-start: var(--space-5);
    color: var(--ink-600);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-1);
  }

  .document__eyebrow::before {
    flex: none;
    inline-size: var(--space-2);
    block-size: var(--border-strong);
    background-color: var(--coral);
    border-radius: var(--radius-link);
    content: '';
  }

  .document__prose {
    display: contents;
  }

  .document__prose > * {
    grid-column: 1;
    min-inline-size: 0;
    max-inline-size: var(--measure);
    margin-block: var(--space-2) 0;
  }

  /* The H1, drawn into the band: the canvas's t-h1, 32/40 700. */
  .document__prose > h1:first-child {
    grid-row: 2;
    margin-block-start: var(--space-1-5);
    color: var(--ink);
    font-size: var(--step-5);
    font-weight: var(--weight-bold);
    line-height: var(--leading-5);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .document__summary {
    grid-row: 3;
    max-inline-size: var(--measure);
    margin-block-start: var(--space-1-5);
    padding-block-end: var(--space-5);
    color: var(--ink-600);
    font-size: var(--step-2);
    line-height: var(--leading-2);
    text-wrap: pretty;
  }

  .document[data-document-variant='guarantee'] .document__eyebrow,
  .document[data-document-variant='guarantee'] .document__summary {
    color: var(--on-midnight-600);
  }

  .document[data-document-variant='guarantee'] .document__eyebrow::before {
    background-color: var(--coral-lift);
  }

  .document[data-document-variant='guarantee']
    .document__prose
    > h1:first-child {
    color: var(--on-midnight);
  }

  /* The body starts 40px below the band (48 from 48rem, 64 from 64rem). */
  .document__prose > h1:first-child + * {
    margin-block-start: var(--space-5);
  }

  /* Prose: 16/24, paragraphs 16 apart, an H2 48 above and 12 over its
     text, an H3 32 above. */
  .document__prose h2 {
    margin-block-start: var(--space-6);
    font-size: var(--step-4);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-4);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
    scroll-margin-block-start: var(--space-3);
  }

  .document__prose h3 {
    margin-block-start: var(--space-4);
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-3);
    letter-spacing: var(--tracking-tight);
    scroll-margin-block-start: var(--space-3);
  }

  .document__prose > :is(h2, h3) + * {
    margin-block-start: var(--space-1-5);
  }

  .document__prose p {
    text-wrap: pretty;
  }

  .document__prose ul,
  .document__prose ol {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-inline-start: var(--space-3);
    list-style: none;
  }

  .document__prose li {
    position: relative;
  }

  /* A 6px coral dot for bullets, a mono figure for numbered items. */
  .document__prose ul > li::before {
    position: absolute;
    inset-block-start: calc(var(--space-2-5) / 2);
    inset-inline-start: calc(-1 * var(--space-2-5));
    inline-size: var(--space-0-75);
    block-size: var(--space-0-75);
    background-color: var(--coral);
    border-radius: var(--radius-pill);
    content: '';
  }

  .document__prose ol {
    counter-reset: document-ol;
  }

  .document__prose ol > li {
    counter-increment: document-ol;
  }

  .document__prose ol > li::before {
    position: absolute;
    inset-block-start: var(--space-0);
    inset-inline-start: calc(-1 * var(--space-3));
    color: var(--ink-600);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    content: counter(document-ol) '.';
  }

  .document__prose strong {
    font-weight: var(--weight-semibold);
  }

  .document__prose code {
    padding: var(--border-thin) var(--space-0-75);
    font-family: var(--font-mono);
    font-size: var(--step-1);
    background-color: var(--wash-strong);
    border-radius: var(--radius-check);
    overflow-wrap: anywhere;
  }

  .document__prose blockquote {
    margin-inline: 0;
    padding: var(--space-2) var(--space-3);
    color: var(--ink);
    background-color: var(--wash);
    border-radius: var(--radius-control);
  }

  /* Prose links: ink 500 with the 2px coral underline. At small widths each
     is a full-size target; from 48rem it is plain inline text. */
  .document__prose a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    min-inline-size: var(--tap-min);
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration-line: underline;
    text-decoration-color: var(--coral);
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
    overflow-wrap: anywhere;
  }

  .document__prose a:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  /* Tables sit on a surface card with a hairline edge. Each table is its own
     grid, and its row groups and rows are subgrids, so every element keeps
     its box and the table spans the prose column; it is also its own
     horizontal scroll container, so it can never widen the page. Cells wrap
     long words, so at every test width the tables fit rather than scroll
     (axe scrollable-region-focusable). */
  .document__prose > table {
    max-inline-size: none;
  }

  .document__prose table {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, auto));
    overflow-x: auto;
    font-size: var(--step-1);
    line-height: var(--leading-1);
    background-color: var(--surface);
    border-radius: var(--radius-control);
    box-shadow: var(--inset-line), var(--shadow-1);
    border-spacing: 0;
  }

  .document__prose table:has(:is(td, th):nth-child(3)) {
    grid-template-columns: repeat(3, minmax(0, auto));
  }

  .document__prose table:has(:is(td, th):nth-child(4)) {
    grid-template-columns: repeat(4, minmax(0, auto));
  }

  .document__prose :is(thead, tbody, tr) {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  .document__prose th,
  .document__prose td {
    padding: var(--space-1-5) var(--space-2);
    text-align: start;
    vertical-align: top;
    overflow-wrap: anywhere;
    hyphens: auto;
  }

  .document__prose td code {
    overflow-wrap: break-word;
    white-space: nowrap;
  }

  .document__prose thead tr {
    background-color: var(--well);
    border-block-end: var(--border-thin) solid var(--line);
    border-start-start-radius: var(--radius-control);
    border-start-end-radius: var(--radius-control);
  }

  .document__prose th {
    color: var(--ink);
    font-weight: var(--weight-semibold);
  }

  .document__prose tbody tr + tr {
    border-block-start: var(--border-thin) solid var(--line);
  }

  .document__prose td:first-child {
    font-weight: var(--weight-medium);
  }

  /* A key-value table: the content gives it an empty header row. That row
     is not hidden; with no text and no padding it simply has no height. */
  .document__prose table:has(thead th:empty) {
    grid-template-columns: minmax(0, 38%) minmax(0, 1fr);
  }

  .document__prose table:has(thead th:empty) thead tr {
    border-block-end: 0;
  }

  .document__prose th:empty {
    padding: 0;
  }

  .document__prose table:has(thead th:empty) td:first-child {
    color: var(--ink-600);
  }

  .document__prose table:has(thead th:empty) td:last-child {
    font-weight: var(--weight-medium);
  }

  /* /guarantee: the three promises carry the band's weight, styled from
     outside the article. */
  .document[data-document-variant='guarantee']
    .document__prose
    > h2:nth-of-type(-n + 3) {
    padding-block-start: var(--space-3);
    font-size: var(--step-5);
    font-weight: var(--weight-bold);
    line-height: var(--leading-5);
    border-block-start: var(--border-strong) solid var(--ink);
  }

  .document[data-document-variant='guarantee']
    .document__prose
    > h2:nth-of-type(1) {
    margin-block-start: var(--space-5);
  }

  .document[data-document-variant='guarantee']
    .document__prose
    > h2:nth-of-type(-n + 3)
    + p {
    color: var(--ink);
    font-size: var(--step-3);
    font-weight: var(--weight-medium);
    line-height: var(--leading-3);
  }

  .document[data-document-variant='guarantee']
    .document__prose
    > h2:nth-of-type(4) {
    margin-block-start: var(--space-8);
  }

  /* The side card: E1 on surface, padded 24 (32 from 48rem). */
  .document__aside {
    grid-column: 1;
    margin-block-start: var(--space-5);
  }

  .document__card {
    display: flex;
    flex-direction: column;
    padding: var(--space-3);
    background-color: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1), var(--edge);
  }

  .document__card-heading {
    margin: 0;
    color: var(--ink);
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-3);
    letter-spacing: var(--tracking-tight);
  }

  .document__promises,
  .document__contents {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Three promises 12px apart under hairlines, each numeral in a 32px
     coral ring. */
  .document__promises {
    margin-block-start: var(--space-2);
  }

  .document__promise {
    display: flex;
    gap: var(--space-1-5);
    align-items: center;
    padding-block: var(--space-1-5);
  }

  .document__promise + .document__promise {
    border-block-start: var(--border-thin) solid var(--line);
  }

  .document__numeral {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: var(--space-4);
    block-size: var(--space-4);
    color: var(--ink);
    font-size: var(--step-0);
    font-weight: var(--weight-bold);
    line-height: var(--leading-0);
    border-radius: var(--radius-pill);
    box-shadow: var(--ring-numeral);
  }

  .document__promise-title {
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-1);
  }

  .document__card-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }

  .document__card-link {
    align-self: start;
  }

  /* The contents list: 14/20 ink-600 links, 44px tall below 64rem and 36px
     from it, on the card's padding. Hover fills the link with --wash and
     brings in ink text and the coral underline: the colour, the fill and the
     underline's colour transition over --duration-fast (the E11.5-11k link
     motion). */
  /* The list, not each link, reaches 12px into the card's padding, so each
     link's capsule lines its text up with the heading without overflowing
     its own list item. */
  .document__contents {
    margin-block-start: var(--space-1-5);
    margin-inline: calc(-1 * var(--space-1-5));
  }

  .document__contents a {
    display: flex;
    box-sizing: border-box;
    gap: var(--space-1);
    align-items: center;
    min-block-size: var(--tap-min);
    padding: var(--space-1) var(--space-1-5);
    color: var(--ink-600);
    font-size: var(--step-1);
    line-height: var(--leading-1);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
    border-radius: var(--radius-control);
    transition-property: color, background-color, text-decoration-color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .document__contents a:hover {
    color: var(--ink);
    text-decoration-color: var(--coral);
    background-color: var(--wash);
  }

  .document__contents a:focus-visible {
    color: var(--ink);
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--space-0);
  }

  /* An archived revision's notice: full-bleed coral tint above the band,
     14/20 500 beside the history icon. Calm, not an alarm. */
  .rules-archived-notice {
    display: flex;
    gap: var(--space-1-5);
    align-items: flex-start;
    padding-block: var(--space-2);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
    background-color: var(--coral-tint);
    box-shadow: 0 0 0 var(--bleed) var(--coral-tint);
    clip-path: inset(0 calc(-1 * var(--bleed)));
  }

  .rules-archived-notice > svg {
    flex: none;
  }

  .rules-archived-notice p {
    margin: 0;
    text-wrap: pretty;
  }

  .rules-archived-notice a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-min);
    color: var(--ink);
    font-weight: var(--weight-medium);
    text-decoration-line: underline;
    text-decoration-color: var(--coral);
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
    overflow-wrap: anywhere;
  }

  .rules-archived-notice a:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  /* The join bar: docked on surface with the sticky shadow, padded 12px and
     the gutter, and at the bottom the safe area or 12px, whichever is
     larger. */
  .document-join-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--layer-dock);
    padding: var(--space-1-5) var(--gutter);
    padding-block-end: max(var(--space-1-5), env(safe-area-inset-bottom));
    background-color: var(--surface);
    box-shadow: var(--shadow-sticky), var(--edge);
  }

  .document-join-bar__link {
    inline-size: 100%;
  }

  /* The bar never covers content or a focused element (WCAG 2.2 SC 2.4.11):
     the page reserves its height, the footer's midnight runs on under it, and
     scrolling keeps focus above it. */
  html:has(.document-join-bar) {
    --join-bar-block: calc(
      var(--control-height) + var(--space-1-5) +
        max(var(--space-1-5), env(safe-area-inset-bottom))
    );
    scroll-padding-block-end: var(--join-bar-block);
  }

  body:has(.document-join-bar) .site-footer {
    padding-block-end: calc(var(--space-6) + var(--join-bar-block));
  }

  /* Nothing inside the article ever moves: no transition and no animation,
     in any state, so reading is never disturbed. */
  .document__main .document__prose,
  .document__main .document__prose * {
    transition-property: none;
    animation-name: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The band enters at first paint from outside the article, on the
       motion system's entrance (E11.5-11i): the eyebrow at index 0, then the
       summary at index 2. The title between them is the content's H1, inside
       the article, so it never moves. The side card follows at index 3
       (data-enter="shift"). Like the /verify and /me cards, nothing fades:
       each part only rises, so every word, the Join button and the contents
       links are at full opacity, readable and usable from first paint
       (design rule 12). */
    .document__eyebrow,
    .document__summary {
      animation-name: motion-enter-shift;
      animation-duration: var(--duration-enter);
      animation-timing-function: var(--ease-enter);
      animation-fill-mode: backwards;
    }

    .document__summary {
      animation-delay: calc(var(--stagger) * 2);
    }

    /* The join bar slides in on load, as the sticky bar does. */
    .document-join-bar {
      animation-name: document-join-bar-in;
      animation-duration: var(--duration-base);
      animation-timing-function: var(--ease-out);
    }

    @keyframes document-join-bar-in {
      from {
        transform: translateY(100%);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .document__contents a {
      transition-property: none;
    }
  }

  @media (min-width: 48rem) {
    .document__eyebrow {
      padding-block-start: var(--space-8);
    }

    .document__summary {
      padding-block-end: var(--space-6);
    }

    .document__prose > h1:first-child + * {
