---
import Button from '../components/button.astro';
import Container from '../components/container.astro';
import { layoutCopy } from '../copy/layout.ts';
import { providerShowcaseCopy } from '../copy/provider-showcase.ts';
import ThemeToggle from '../islands/ThemeToggle.astro';
import PageViewEmitter from './page-view-emitter.astro';
import { themeBootstrapScript } from '../islands/theme-toggle.ts';
import { seoCopy } from '../copy/seo.ts';
import {
  canonicalUrl,
  jsonLd,
  organisationData,
  socialFallbackImageUrl,
  socialImageUrl,
  socialPageKind,
} from '../server/seo.ts';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  // Trust and legal pages ship no client JavaScript beyond the page-view
  // emitter (E9-02, E9-03, E9-04), so they render the shell without the toggle.
  themeToggle?: boolean;
}

const { title, description, themeToggle = true } = Astro.props;
// Header anchors target the landing sections; elsewhere they lead back to them.
const sectionPrefix = Astro.url.pathname === '/' ? '' : '/';
const footerGroups = layoutCopy.footerGroups.map((group) => ({
  ...group,
  links: layoutCopy.footerLinks.filter((link) => link.group === group.id),
}));
const canonical = canonicalUrl(Astro.url.pathname);
const image = socialImageUrl(Astro.url.pathname);
const fallbackImage = socialFallbackImageUrl(
  socialPageKind(Astro.url.pathname),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seoCopy.organisationName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image" content={fallbackImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seoCopy.organisationName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={title} />
    <script
      is:inline
      type="application/ld+json"
      set:html={jsonLd(organisationData())}
    />
    <slot name="head" />
    <PageViewEmitter />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {themeToggle && <script is:inline set:html={themeBootstrapScript} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{layoutCopy.skipToContent}</a>
    <header class="site-header">
      <Container class="site-header__inner">
        <a class="site-name" href="/">{layoutCopy.siteName}</a>
        <nav class="site-nav" aria-label={layoutCopy.headerNavLabel}>
          <ul class="site-nav__links">
            {
              layoutCopy.headerLinks.map((link) => (
                <li>
                  <a href={`${sectionPrefix}${link.anchor}`}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="site-header__actions">
          {themeToggle && <ThemeToggle />}
          <Button
            class="site-header__join"
            size="xs"
            href={`${sectionPrefix}${layoutCopy.joinAnchor}`}
          >
            {layoutCopy.joinLabel}
          </Button>
        </div>
      </Container>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <Container class="site-footer__inner">
        <div class="site-footer__grid">
          <a class="site-name site-name--footer" href="/"
            >{layoutCopy.siteName}</a
          >
          <nav class="site-footer__nav" aria-label={layoutCopy.footerNavLabel}>
            {
              footerGroups.map((group) => (
                <div class="site-footer__column">
                  <h2 class="site-footer__heading" id={`footer-${group.id}`}>
                    {group.heading}
                  </h2>
                  <ul
                    class="footer-links"
                    aria-labelledby={`footer-${group.id}`}
                  >
                    {group.links.map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>
          <div class="site-footer__column site-footer__column--contact">
            <h2 class="site-footer__heading">{layoutCopy.contactHeading}</h2>
            <a
              class="site-footer__contact"
              href={`mailto:${layoutCopy.supportEmail}`}
            >
              {layoutCopy.supportEmail}
            </a>
          </div>
        </div>
        <div class="site-footer__lines">
          <p class="site-footer__trademark">{providerShowcaseCopy.trademark}</p>
          <p class="site-footer__legal">{layoutCopy.legalLine}</p>
        </div>
      </Container>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    background-color: var(--paper);
  }

  /* Visually hidden until focused, then revealed at the gutter (E11.5-11b). */
  .skip-link {
    position: absolute;
    inset-block-start: var(--space-1);
    inset-inline-start: var(--gutter);
    z-index: var(--layer-skip);
    padding: var(--space-1) var(--space-2);
    color: var(--midnight);
    font-family: var(--font-sans);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-1);
    background-color: var(--coral);
    border-radius: var(--radius-control);
    transform: translateY(calc(-100% - var(--space-2)));
    transition-property: transform;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
    outline: medium solid var(--midnight);
    outline-offset: var(--space-1);
  }

  /* The header is not sticky, so it never obscures focus. Small: 72px tall
     with 8px gaps; the wordmark, then the toggle and Join (E11.5-11b). */
  .site-header {
    background-color: var(--paper);
  }

  .site-header__inner {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    block-size: var(--header-height);
  }

  .site-name {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-block-size: var(--tap-min);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-3);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .site-name:focus-visible,
  .site-nav__links a:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  /* Small widths have no section links and no menu: the links are not
     rendered until medium width. */
  .site-nav {
    display: none;
  }

  .site-nav__links {
    display: flex;
    gap: var(--space-0);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__links a {
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-1-5);
    /* 10px: half the 20px step. */
    padding-inline: calc(var(--space-2-5) / 2);
    color: var(--ink-600);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
    white-space: nowrap;
    text-decoration: none;
    border-radius: var(--radius-control);
  }

  .site-nav__links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .site-header__actions {
    display: flex;
    flex: none;
    gap: var(--space-1);
    align-items: center;
    margin-inline-start: auto;
  }

  /* Below 22.5rem the Join button is the xs size so the row fits at 320px;
     from 22.5rem it is h44. */
  @media (min-width: 22.5rem) {
    .site-header :global(.site-header__join) {
      padding-inline: var(--space-2-5);
      font-size: var(--step-2);
      line-height: var(--leading-2);
    }
  }

  .site-main {
    padding-inline: var(--space-3);
    padding-block: var(--space-4);
  }

  /* The footer is a full-width midnight band (identity §5.2), the section
     gap below the page. Small: the wordmark, then a 4-column grid with
     Company and Legal side by side and Contact below (E11.5-11b). */
  .site-footer {
    margin-block-start: var(--section-gap);
    padding-block: var(--space-8) var(--space-6);
    color: var(--on-midnight);
    background-color: var(--midnight);
    box-shadow: var(--edge);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-3);
  }

  /* The wordmark keeps a 44px target. Its box starts 8px above the text, so
     the text, not the box, sits on the band's padding, and the box's lower
     8px plus the 24px row gap make the drawn 32px to the columns. */
  .site-name--footer {
    grid-column: 1 / -1;
    place-self: start;
    margin-block-start: calc((var(--leading-3) - var(--tap-min)) / 2);
    color: var(--on-midnight);
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  .site-footer__nav .site-footer__column {
    grid-column: span 2;
  }

  .site-footer__column--contact {
    grid-column: 1 / -1;
  }

  .site-footer__heading {
    margin: 0;
    margin-block-end: var(--space-1);
    color: var(--on-midnight);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-1);
  }

  .footer-links {
    display: grid;
    justify-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a,
  .site-footer__contact {
    display: inline-block;
    min-inline-size: var(--tap-min);
    padding-block: var(--space-1-5);
    color: var(--on-midnight);
    font-family: var(--font-sans);
    font-size: var(--step-1);
    line-height: var(--leading-1);
    text-decoration: none;
  }

  .footer-links a:hover,
  .site-footer__contact:hover {
    color: var(--coral-lift);
    text-decoration: underline;
  }

  .footer-links a:focus-visible,
  .site-footer__contact:focus-visible,
  .site-name--footer:focus-visible {
    outline: var(--focus-width) solid var(--coral-lift);
    outline-offset: var(--focus-offset);
  }

  .site-footer__lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    /* The frames' 760px measure and 85% opacity for the two lines. */
    max-inline-size: calc(var(--space-10) * 9.5);
    margin-block-start: var(--space-4);
    opacity: 0.85;
  }

  .site-footer__trademark,
  .site-footer__legal {
    margin: 0;
    color: var(--on-midnight);
    font-size: var(--step-1);
    line-height: var(--leading-1);
  }

  /* Medium: 80px tall, 24px gaps, links padded 12px 10px. The footer
     wordmark takes its own row over three equal columns. */
  @media (min-width: 48rem) {
    .skip-link {
      inset-inline-start: var(--gutter-wide);
    }

    .site-header__inner {
      gap: var(--space-3);
      block-size: var(--header-height-wide);
    }

    .site-nav {
      display: block;
    }

    .site-header__actions {
      gap: var(--space-1-5);
    }

    .site-footer__grid {
      grid-template-columns: repeat(var(--grid-columns-wide), minmax(0, 1fr));
      column-gap: var(--grid-gap-wide);
    }

    .site-footer__nav {
      grid-column: 1 / span 8;
    }

    .site-footer__nav .site-footer__column,
    .site-footer__column--contact {
      grid-column: span 4;
    }

    .site-footer__lines {
      margin-block-start: var(--space-5);
    }
  }

  /* Large: 40px gaps, links padded 12px with 4px between. The footer
     columns sit on the 12-column grid: 1–4, 5–6, 7–8 and 9–12. */
  @media (min-width: 64rem) {
    .site-header__inner {
      gap: var(--space-5);
    }

    .site-nav__links {
      gap: var(--space-0-5);
    }

    .site-nav__links a {
      padding-inline: var(--space-1-5);
    }

    .site-footer {
      margin-block-start: var(--section-gap-wide);
    }

    .site-footer__grid {
      row-gap: var(--space-4);
    }

    .site-name--footer {
      grid-column: 1 / span 4;
    }

    .site-footer__nav {
      grid-column: 5 / span 4;
    }

    .site-footer__nav .site-footer__column {
      grid-column: span 2;
    }

    .site-footer__column--contact {
      grid-column: 9 / span 4;
    }

    .footer-links a,
    .site-footer__contact {
      padding-block: var(--space-0-75);
    }

    .site-footer__lines {
      margin-block-start: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition-property: none;
    }
  }
</style>
