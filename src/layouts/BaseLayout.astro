---
import Button from '../components/button.astro';
import Container from '../components/container.astro';
import { layoutCopy } from '../copy/layout.ts';
import { providerShowcaseCopy } from '../copy/provider-showcase.ts';
import ThemeToggle from '../islands/ThemeToggle.astro';
import PageViewEmitter from './page-view-emitter.astro';
import { themeBootstrapScript } from '../islands/theme-toggle.ts';
import { seoCopy } from '../copy/seo.ts';
import {
  canonicalUrl,
  jsonLd,
  organisationData,
  socialFallbackImageUrl,
  socialImageUrl,
  socialPageKind,
} from '../server/seo.ts';
import '../styles/tokens.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  // Trust and legal pages ship no client JavaScript beyond the page-view
  // emitter (E9-02, E9-03, E9-04), so they render the shell without the toggle.
  themeToggle?: boolean;
}

const { title, description, themeToggle = true } = Astro.props;
// Header anchors target the landing sections; elsewhere they lead back to them.
const isLanding = Astro.url.pathname === '/';
const sectionPrefix = isLanding ? '' : '/';
const footerGroups = layoutCopy.footerGroups.map((group) => ({
  ...group,
  links: layoutCopy.footerLinks.filter((link) => link.group === group.id),
}));
const canonical = canonicalUrl(Astro.url.pathname);
const image = socialImageUrl(Astro.url.pathname);
const fallbackImage = socialFallbackImageUrl(
  socialPageKind(Astro.url.pathname),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seoCopy.organisationName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image" content={fallbackImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seoCopy.organisationName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={title} />
    <script
      is:inline
      type="application/ld+json"
      set:html={jsonLd(organisationData())}
    />
    <slot name="head" />
    <PageViewEmitter />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {themeToggle && <script is:inline set:html={themeBootstrapScript} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{layoutCopy.skipToContent}</a>
    <header class="site-header">
      <Container class="site-header__inner">
        <a class="site-name" href="/">{layoutCopy.siteName}</a>
        <nav class="site-nav" aria-label={layoutCopy.headerNavLabel}>
          <ul class="site-nav__links">
            {
              layoutCopy.headerLinks.map((link) => (
                <li>
                  <a href={`${sectionPrefix}${link.anchor}`}>{link.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="site-header__actions">
          {themeToggle && <ThemeToggle />}
          <Button
            class="site-header__join"
            variant={isLanding ? 'primary' : 'secondary'}
            size="h44"
            href={`${sectionPrefix}${layoutCopy.joinAnchor}`}
          >
            {layoutCopy.joinLabel}
          </Button>
        </div>
      </Container>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <Container class="site-footer__inner">
        <div class="site-footer__grid">
          <a class="site-name site-name--footer" href="/"
            >{layoutCopy.siteName}</a
          >
          <nav class="site-footer__nav" aria-label={layoutCopy.footerNavLabel}>
            {
              footerGroups.map((group) => (
                <div class="site-footer__column">
                  <h2 class="site-footer__heading" id={`footer-${group.id}`}>
                    {group.heading}
                  </h2>
                  <ul
                    class="footer-links"
                    aria-labelledby={`footer-${group.id}`}
                  >
                    {group.links.map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>
          <div class="site-footer__column site-footer__column--contact">
            <h2 class="site-footer__heading">{layoutCopy.contactHeading}</h2>
            <a
              class="site-footer__contact"
              href={`mailto:${layoutCopy.supportEmail}`}
            >
              {layoutCopy.supportEmail}
            </a>
          </div>
        </div>
        <div class="site-footer__lines">
          <p class="site-footer__trademark">{providerShowcaseCopy.trademark}</p>
          <p class="site-footer__legal">{layoutCopy.legalLine}</p>
        </div>
      </Container>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-sans);
    background-color: var(--paper);
  }

  /* Above the viewport until focused, then shown at the gutter on a raised
     surface (E11.5-11k). The reveal is instant: no transition is drawn. */
  .skip-link {
    position: absolute;
    inset-block-start: calc(var(--space-6) * -2);
    inset-inline-start: var(--gutter);
    z-index: var(--layer-skip);
    padding: var(--space-1-5) var(--space-2);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-2);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-2);
    text-decoration: none;
    background-color: var(--surface);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-2), var(--edge);
  }

  .skip-link:focus-visible {
    inset-block-start: var(--space-1);
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  /* The header is not sticky, so it never obscures focus. Small: 72px tall
     with 8px gaps; the wordmark, then the toggle and Join (E11.5-11b). */
  .site-header {
    background-color: var(--paper);
  }

  .site-header__inner {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    block-size: var(--header-height);
  }

  .site-name {
    display: inline-flex;
    flex: none;
    align-items: center;
    min-block-size: var(--tap-min);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: var(--step-3);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-3);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
    border-radius: var(--radius-check);
  }

  .site-name:focus-visible,
  .site-nav__links a:focus-visible {
    outline: var(--focus-width) solid var(--coral);
    outline-offset: var(--focus-offset);
  }

  /* Small widths have no section links and no menu: the links are not
     rendered until medium width. */
  .site-nav {
    display: none;
  }

  /* The surface capsule that anchors the links on plain paper (E11.5-11k). */
  .site-nav__links {
    display: flex;
    align-items: center;
    margin: 0;
    padding: var(--space-0-5);
    list-style: none;
    background-color: var(--surface);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-1), var(--edge);
  }

  .site-nav__links li {
    display: flex;
  }

  /* 36px tall (20px + 16px), padded 12px. Hover and press fill the link;
     the fill and the text colour are all that transition. */
  .site-nav__links a {
    display: inline-flex;
    align-items: center;
    block-size: calc(var(--space-2) + var(--space-2-5));
    padding-inline: var(--space-1-5);
    color: var(--ink-600);
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    line-height: var(--leading-1);
    white-space: nowrap;
    text-decoration: none;
    border-radius: var(--radius-control);
    transition-property: background-color, color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .site-nav__links a:hover {
    color: var(--ink);
    background-color: var(--wash);
  }

  .site-nav__links a:active {
    color: var(--ink);
    background-color: var(--wash-strong);
  }

  .site-nav__links a:focus-visible {
    color: var(--ink);
  }

  .site-header__actions {
    display: flex;
    flex: none;
    gap: var(--space-1);
    align-items: center;
    margin-inline-start: auto;
  }

  /* A fixed, token-derived width: the label's width differs slightly between
     the metric-matched fallback and the loaded face, and the right-aligned
     actions must not move when the font swaps (zero CLS, E2-02). 160px is the
     canvas's Join in either variant (E11.5-11k). */
  .site-header :global(.site-header__join) {
    inline-size: calc(var(--space-10) * 2);
    white-space: nowrap;
  }

  /* Below 22.5rem the Join button is the xs size so the row fits at 320px:
     130px, a 106px label padded 12px each side. */
  @media (width < 22.5rem) {
    .site-header :global(.site-header__join) {
      inline-size: calc(var(--space-2-5) * 6.5);
      padding-inline: var(--space-1-5);
      font-size: var(--step-1);
      line-height: var(--leading-1);
    }
  }

  /* The footer's section gap is the only space above it on every page, so
     main has no bottom padding (E11.5-11b). */
  .site-main {
    padding-inline: var(--space-3);
    padding-block-start: var(--space-4);
  }

  /* The footer is a full-width midnight band (identity §5.2), the section
     gap below the page. Small: the wordmark, then a 4-column grid with
     Company and Legal side by side and Contact below (E11.5-11b). */
  .site-footer {
    margin-block-start: var(--section-gap);
    padding-block: var(--space-8) var(--space-6);
    color: var(--on-midnight);
    background-color: var(--midnight);
    box-shadow: var(--shadow-band);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-3);
  }

  /* The wordmark keeps a 44px target. Its box starts 8px above the text, so
     the text, not the box, sits on the band's padding, and the box's lower
     8px plus the 24px row gap make the drawn 32px to the columns. */
  .site-name--footer {
    grid-column: 1 / -1;
    place-self: start;
    margin-block-start: calc((var(--leading-3) - var(--tap-min)) / 2);
    color: var(--on-midnight);
  }

  .site-footer__nav {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  .site-footer__nav .site-footer__column {
    grid-column: span 2;
  }

  .site-footer__column--contact {
    grid-column: 1 / -1;
  }

  .site-footer__heading {
    margin: 0;
    margin-block-end: var(--space-1);
    color: var(--on-midnight);
    font-size: var(--step-1);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-1);
  }

  .footer-links {
    display: grid;
    justify-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a,
  .site-footer__contact {
    display: inline-block;
    min-inline-size: var(--tap-min);
    padding-block: var(--space-1-5);
    color: var(--on-midnight-600);
    font-family: var(--font-sans);
    font-size: var(--step-1);
    line-height: var(--leading-1);
    text-decoration: none;
    border-radius: var(--radius-link);
    transition-property: color, text-decoration-color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-out);
  }

  .footer-links a:hover,
  .site-footer__contact:hover {
    color: var(--on-midnight);
    text-decoration-line: underline;
    text-decoration-color: var(--coral-lift);
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
  }

  .footer-links a:focus-visible,
  .site-footer__contact:focus-visible {
    color: var(--on-midnight);
    outline: var(--focus-width) solid var(--coral-lift);
    outline-offset: var(--focus-offset);
  }

  /* The two lines sit under a hairline rule, in secondary text on midnight. */
  .site-footer__lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    /* The canvas's 760px measure. */
    max-inline-size: calc(var(--space-10) * 9.5);
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-3);
    border-block-start: var(--border-thin) solid var(--on-midnight-line);
  }

  .site-footer__trademark,
  .site-footer__legal {
    margin: 0;
    color: var(--on-midnight-600);
    font-size: var(--step-1);
    line-height: var(--leading-1);
    text-wrap: pretty;
  }

  /* Medium: 80px tall, no gap between the section links. The
     footer wordmark takes its own row over three equal columns. */
  @media (min-width: 48rem) {
    .skip-link {
      inset-inline-start: var(--gutter-wide);
    }

    /* The canvas's 24px gaps need 5.4px more than the 704px track at 768, and
       the row must stay on the grid (design rule 8). So the 24px is kept after
       the wordmark only, and the actions' auto margin takes what is left. */
    .site-header__inner {
      gap: var(--space-0);
      block-size: var(--header-height-wide);
    }

    .site-nav {
      display: block;
      margin-inline-start: var(--space-3);
    }

    .site-header__actions {
      gap: var(--space-1-5);
    }

    .site-footer__grid {
      grid-template-columns: repeat(var(--grid-columns-wide), minmax(0, 1fr));
      column-gap: var(--grid-gap-wide);
      row-gap: var(--space-4);
    }

    .site-footer__nav {
      grid-column: 1 / span 8;
    }

    .site-footer__nav .site-footer__column,
    .site-footer__column--contact {
      grid-column: span 4;
    }

    .site-footer__lines {
      margin-block-start: var(--space-6);
    }
  }

  /* Large: 40px gaps, section links 2px apart. The footer
     columns sit on the 12-column grid: 1–4, 5–6, 7–8 and 9–12. */
  @media (min-width: 64rem) {
    .site-header__inner {
      gap: var(--space-5);
    }

    .site-nav {
      margin-inline-start: var(--space-0);
    }

    .site-nav__links {
      gap: calc(var(--space-0-5) / 2);
    }

    .site-footer {
      margin-block-start: var(--section-gap-wide);
    }

    .site-name--footer {
      grid-column: 1 / span 4;
    }

    .site-footer__nav {
      grid-column: 5 / span 4;
    }

    .site-footer__nav .site-footer__column {
      grid-column: span 2;
    }

    .site-footer__column--contact {
      grid-column: 9 / span 4;
    }

    .footer-links a,
    .site-footer__contact {
      padding-block: var(--space-0-75);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__links a,
    .footer-links a,
    .site-footer__contact {
      transition-property: none;
    }
  }
</style>
