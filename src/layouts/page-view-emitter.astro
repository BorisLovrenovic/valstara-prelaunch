---
// Public Umami website ID. The same ID is used when creating the site in Umami.
const websiteId = 'a4041033-3269-4a73-8772-c16f9bdf1a33';
const path = Astro.url.pathname;
// The prerendered 404 and 500 pages answer for any failing URL, whose path is
// arbitrary visitor input, so they never send a page view (E11.5-10).
const excluded =
  /^\/(?:me|verify|unsubscribe|404|500)(?:\/|$)/u.test(path) ||
  /^\/(?:api\/)?admin(?:\/|$)/u.test(path);
---

{
  !excluded && (
    <script is:inline defer src="/page-view.js" data-website-id={websiteId} />
  )
}
