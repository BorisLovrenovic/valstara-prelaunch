---
import { layoutCopy } from '../copy/layout.ts';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="preload"
      href="/fonts/instrument-sans-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{layoutCopy.skipToContent}</a>
    <header class="site-header">
      <a class="site-name" href="/">{layoutCopy.siteName}</a>
    </header>
    <main id="main-content" class="site-main">
      <article class="trust-content">
        <slot />
      </article>
    </main>
    <footer class="site-footer">
      <nav aria-label={layoutCopy.footerNavLabel}>
        <ul class="footer-links">
          {
            layoutCopy.footerLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--font-sans);
  }

  .skip-link {
    position: absolute;
    inset-block-start: var(--space-1);
    inset-inline-start: var(--space-1);
    padding: var(--space-1) var(--space-2);
    color: var(--midnight);
    background: var(--coral);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  .site-header,
  .site-footer {
    padding: var(--space-3);
  }

  .site-header {
    border-block-end: thin solid var(--line);
  }

  .site-footer {
    border-block-start: thin solid var(--line);
  }

  .site-name,
  .footer-links a,
  .trust-content a {
    color: var(--ink-600);
  }

  a:focus-visible {
    outline: medium solid var(--coral);
    outline-offset: var(--space-1);
  }

  .site-main {
    padding: var(--space-4) var(--space-3);
  }

  .trust-content {
    max-inline-size: 70ch;
    margin-inline: auto;
    font-size: var(--step-2);
    line-height: var(--leading-2);
  }

  .trust-content h1 {
    font-size: var(--step-5);
    line-height: var(--leading-5);
  }

  .trust-content h2 {
    margin-block-start: var(--space-4);
    font-size: var(--step-4);
    line-height: var(--leading-4);
  }

  .trust-content p,
  .trust-content ul,
  .trust-content table {
    margin-block: var(--space-2);
  }

  .trust-content table {
    border-collapse: collapse;
    overflow-wrap: anywhere;
  }

  .trust-content td,
  .trust-content th {
    padding: var(--space-1);
    border-block-end: thin solid var(--line);
    text-align: start;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }
</style>
