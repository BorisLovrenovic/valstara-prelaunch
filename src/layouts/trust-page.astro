---
import BaseLayout from './BaseLayout.astro';
import DocumentPage from './document-page.astro';
import { contentsFromRenderedHtml } from '../server/content/contents.ts';

interface Props {
  title: string;
  description: string;
  // Trust pages carry the guarantee card and the small-width join bar; legal
  // pages carry a contents list of the content's own section anchors.
  kind: 'trust' | 'legal';
  summary: string;
  renderedHtml: string;
}

const { title, description, kind, summary, renderedHtml } = Astro.props;
const contents = kind === 'legal' ? contentsFromRenderedHtml(renderedHtml) : [];
---

{
  /*
  Trust and legal pages share the site shell. They ship no client JavaScript
  beyond the page-view emitter (E9-02), so the shell renders without the theme
  toggle.
*/
}
<BaseLayout title={title} description={description} themeToggle={false}>
  <DocumentPage kind={kind} summary={summary} contents={contents}>
    <article class="document__prose">
      <slot />
    </article>
  </DocumentPage>
</BaseLayout>
