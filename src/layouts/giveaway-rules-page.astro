---
import BaseLayout from './BaseLayout.astro';
import DocumentPage from './document-page.astro';
import Icon from '../components/icon.astro';
import { giveawayRulesCopy } from '../copy/giveaway-rules.ts';
import { currentRules } from '../server/giveaway/rules-catalog.ts';
import type { RulesRevision } from '../server/giveaway/rules.ts';
import { contentsFromRenderedHtml } from '../server/content/contents.ts';
import { jsonLd, rulesPageData, rulesPageMetadata } from '../server/seo.ts';

interface Props {
  revision: RulesRevision;
}

const { revision } = Astro.props;
const archived = revision.rulesVersion !== currentRules().rulesVersion;
const metadata = rulesPageMetadata(
  revision,
  Astro.url.pathname.replace(/\/+$/u, '') === '/giveaway/rules',
);
---

<BaseLayout title={metadata.title} description={metadata.description}>
  {archived && <meta slot="head" name="robots" content="noindex" />}
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={jsonLd(rulesPageData(revision, Astro.url.pathname))}
  />
  <DocumentPage
    kind="rules"
    summary={revision.description}
    contents={contentsFromRenderedHtml(revision.html)}
  >
    {
      archived && (
        <aside
          slot="notice"
          class="rules-archived-notice"
          data-archived-rules-notice
        >
          <Icon name="alert" />
          <p>
            {giveawayRulesCopy.archivedNoticeBeforeLink}
            <a href="/giveaway/rules">{giveawayRulesCopy.archivedNoticeLink}</a>
            {giveawayRulesCopy.archivedNoticeAfterLink}
          </p>
        </aside>
      )
    }
    <article
      class="document__prose"
      data-rules-version={revision.rulesVersion}
      data-rules-sha256={revision.sha256}
      set:html={revision.html}
    />
  </DocumentPage>
</BaseLayout>
