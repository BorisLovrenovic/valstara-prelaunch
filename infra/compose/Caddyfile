http://{$SITE_HOST} {
	import cloudflare_only
	redir https://{$SITE_HOST}{uri} permanent
}

https://{$SITE_HOST} {
	import cloudflare_only
	tls /run/secrets/caddy_origin_cert /run/secrets/caddy_origin_key
	encode zstd gzip

	handle /analytics/api/send {
		uri strip_prefix /analytics
		reverse_proxy umami:3000
