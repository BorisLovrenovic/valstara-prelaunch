mary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden\",\"children\":[\"Does Netflix have regional pricing?\",[\"$\",\"span\",null,{\"className\":\"grid size-7 shrink-0 place-items-center rounded-full bg-surface-2 text-muted transition-transform group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 leading-relaxed text-muted\",\"children\":\"Yes. Standard has 69 different prices across the 245 verified countries, in 40 currencies: from â‰ˆ $2.89 a month in Pakistan to â‰ˆ $27.29 in Liechtenstein and 1 more, a 9.4Ã— gap. Some of these prices are before tax and others include it, so part of the difference is tax.\"}]]}]\n5c:[\"$\",\"details\",\"Which country is cheapest for each Netflix plan?\",{\"className\":\"group px-5 py-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden\",\"children\":[\"Which country is cheapest for each Netflix plan?\",[\"$\",\"span\",null,{\"className\":\"grid size-7 shrink-0 place-items-center rounded-full bg-surface-2 text-muted transition-transform group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 leading-relaxed text-muted\",\"children\":\"Standard: Pakistan (â‰ˆ $2.89 a month); Standard with ads: Brazil (â‰ˆ $4.57 a month); Basic: Pakistan (â‰ˆ $1.63 a month); Premium: Pakistan (â‰ˆ $3.97 a month); Mobile: Pakistan (â‰ˆ $0.90 a month). Only verified prices count, and yearly prices are divided by twelve.\"}]]}]\n5d:[\"$\",\"details\",\"Why do subscription prices differ by country?\",{\"className\":\"group px-5 py-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden\",\"children\":[\"Why do subscription prices differ by country?\",[\"$\",\"span\",null,{\"className\":\"grid size-7 shrink-0 place-items-center rounded-full bg-surface-2 text-muted transition-transform group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 leading-relaxed text-muted\",\"children\":\"Companies set a price for each market based on what people there earn, what local rivals charge, taxes and the local currency. The same plan can cost several times more in one country than in another.\"}]]}]\n5e:[\"$\",\"details\",\"Why might I see a different price than the one here?\",{\"className\":\"group px-5 py-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden\",\"children\":[\"Why might I see a different price than the one here?\",[\"$\",\"span\",null,{\"className\":\"grid size-7 shrink-0 place-items-center rounded-full bg-surface-2 text-muted transition-transform group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 leading-relaxed text-muted\",\"children\":\"Taxes, an introductory offer, paying in the iPhone app instead of on the website, or a recent price change. Prices in US dollars also move a little with the exchange rate, updated every week.\"}]]}]\n5f:[\"$\",\"details\",\"Where do these prices come from?\",{\"className\":\"group px-5 py-4\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden\",\"children\":[\"Where do these prices come from?\",[\"$\",\"span\",null,{\"className\":\"grid size-7 shrink-0 place-items-center rounded-full bg-surface-2 text-muted transition-transform group-open:rotate-45\",\"children\":\"+\"}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 leading-relaxed text-muted\",\"children\":\"From each service's own website or its App Store listing, read as a visitor from that country sees it. We check every month, convert w