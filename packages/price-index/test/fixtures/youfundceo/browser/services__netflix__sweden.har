            "mimeType": "application/javascript; charset=utf-8",
            "compression": 49834,
            "text": "(()=>{\"use strict\";(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push([\"object\"==typeof document?document.currentScript:void 0,51529,e=>{var a=e.i(43476),t=e.i(71645);e.i(20125);var s=e.i(70002),r=e.i(29330),o=e.i(97002),i=e.i(79896),n=e.i(56324),c=e.i(9484),l=e.i(8852),h=e.i(98022);let p='<svg role=\"img\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><title>',u='</title><path d=\"',d='\"/></svg>',m={title:\"Apple\",slug:\"apple\",get svg(){return p+\"Apple\"+u+this.path+d},path:\"M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701\",source:\"https://www.apple.com\",hex:\"000000\"},y=(e,a)=>{let{website:t,helpCenter:s,mostlyHelp:r}=a.sources;return t&&s?r?`${e}'s Help Center and its own pricing pages`:`${e}'s own pricing pages and Help Center`:s?`${e}'s Help Center`:`${e}'s own pricing pages`},f=e=>e.us&&!e.us.atEnd?`, ${e.us.usd} in the United States`:\"\",g=e=>e.cheaperThanUs?` ${e.cheaperThanUs} of the ${e.countries} countries we checked pay less than in the US.`:\"\",w={color:\"#5b6853\",tagline:\"Subscription\",intro:e=>`${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country} and ${e.priciest.usd} in ${e.priciest.country}, a ${e.spread} difference across ${e.countries} countries.`,faqs:()=>[]};function $(e,a,t,s={}){return{color:a,tagline:t,intro:a=>`${s.why?`${s.why} `:\"\"}${e} sets a different in-app price in each country's App Store. ${a.planName} costs ${a.cheapest.local} (${a.cheapest.usd}) in ${a.cheapest.country}${f(a)} and ${a.priciest.usd} in ${a.priciest.country}. These are iPhone app prices for ${a.countries} countries, converted with the same exchange rates, updated every week.`,faqs:a=>[{q:`Where is ${e} cheapest in ${a.year}?`,a:`${a.cheapest.country}, at ${a.cheapest.local} a month (${a.cheapest.usd}) for ${a.planName} in the iPhone app.`},...s.faqs?.(a)??[],{q:\"Is the App Store price the same as the website price?\",a:\"Not always. Some services charge more in their iPhone app to cover Apple's fee, so the website can be cheaper. The ranking compares App Store prices in every country, so it stays like for like.\"},{q:`Why isn't ${e} listed for my country?`,a:`Either ${e} isn't sold in that country's App Store, or its price list there was unclear and is waiting for a manual check.`}]}}let b=e=>`We read each price from ${y(\"Apple\",e)} for that country (apple.com/de, apple.com/jp and so on). Where none of them gives a country's price for the service, the country is listed as not verified rather than guessed.`,v={spotify:{color:\"#1ed760\",tagline:\"Music streaming\",intro:e=>`Spotify sets a different price in almost every market, matched to local incomes and local rivals rather than to what you get. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same catalogue and the same app.${g(e)}`,faqs:e=>[{q:\"Why does Spotify cost less in some countries?\",a:\"Spotify prices each market against local incomes and local competitors. In markets with cheaper local music apps it sets Premium low to win subscribers; in richer markets it charges more. It also relies on the free, ad-supported tier to bring in listeners who may upgrade later.\"},{q:`Where is Spotify Premium cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}). The ranking uses the ${e.planName} plan in every country so the comparison is like for like.`},{q:\"Do cheaper countries get a worse Spotify?\",a:\"No. Premium has the same features and sound quality in every country. The core catalogue is the same worldwide; a few tracks are limited by regional licensing, which has nothing to do with the price.\"},{q:\"Can I pay the price of another country?\",a:\"Spotify charges the price of the country your account and payment method belong to. It usually requires a local payment method and asks you to re-confirm your country, so a cheaper country's price isn't available just by changing your location.\"},{q:\"What happens to my price when I travel or move?\",a:\"Premium keeps working abroad at your home country's price. If you move, Spotify asks you to update your country, and from then on you pay the new country's price.\"}]},netflix:{color:\"#e50914\",tagline:\"Streaming\",intro:e=>`Netflix prices each country on its own, by what people there can pay and what competes locally, not by how big the catalogue is. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same plan.${g(e)} We read each country's prices from ${y(\"Netflix\",e)}.`,faqs:e=>[{q:`Where is Netflix cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}.`},{q:\"Why is Netflix cheaper in some countries?\",a:\"Netflix sets each country's price by local incomes and competition, and accepts lower prices in growing markets to win subscribers. The size of the local catalogue isn't what drives it: two countries with similar libraries can pay very different prices.\"},{q:\"Is the picture quality worse in cheaper countries?\",a:\"No. Quality depends on the plan, not the country: each plan has the same resolution and number of screens wherever it's sold. What differs is the catalogue, which follows regional licensing deals rather than the price.\"},{q:\"Why don't all countries have the same plans?\",a:\"Netflix sells different plans per market. Some countries have a cheap Mobile plan, others have Standard with ads instead of Basic. Each plan is compared only with the same plan in other countries.\"},{q:\"Can I pay another country's Netflix price?\",a:\"Netflix bills in the country where you sign up and checks your location and payment method, so another country's price isn't available just by changing your location.\"}]},chatgpt:{color:\"#10a37f\",tagline:\"AI assistant\",intro:e=>`OpenAI sets a ChatGPT price for each country, and in some of them you pay in US dollars rather than the local currency. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same plan.${g(e)} We read the prices chatgpt.com shows on its pricing page for each country.`,faqs:e=>[{q:`Which country has the cheapest ChatGPT Plus in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}), as listed on chatgpt.com's pricing page for that country.`},{q:\"Do these prices include tax?\",a:\"They're the price chatgpt.com lists for each country. Some countries list it with tax included and others add tax at checkout, as the US does with sales tax, so the amount you're charged can be a little higher.\"},{q:\"Why are some prices in US dollars?\",a:\"OpenAI bills some countries in US dollars instead of their own currency. We show the price in the currency you'd actually pay, then convert it to US dollars for the ranking.\"},{q:\"Where is ChatGPT not available?\",a:\"Countries where chatgpt.com doesn't sell a plan are listed on this page as not available.\"},{q:\"What is ChatGPT Go?\",a:\"Go is OpenAI's lower-cost plan with higher limits than the free tier. Its price varies by country just like Plus, and you can compare both with the plan tabs.\"}]},claude:{color:\"#d97757\",tagline:\"AI assistant\",intro:e=>`Anthropic bills Claude in US dollars in most countries, in euros across the European Union and in a handful of local currencies, and shows some countries' prices with tax included. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same plan.${g(e)} We read the price list claude.com's pricing page loads for each country.`,faqs:e=>[{q:`Where is ${e.planName} cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}), as claude.com's pricing page lists it there.`},{q:\"Do these prices include tax?\",a:\"Where claude.com shows prices with tax included (the UK and Australia, for example), so do we. Elsewhere, the US and the European Union included, the price is before tax, which is added at checkout. Each price is marked the way the page shows it.\"},{q:\"Why are some prices in US dollars or euros?\",a:\"Anthropic bills most countries in US dollars and every European Union country in euros, including members with their own currency. We show the price in the currency you'd actually pay, then convert it to US dollars for the ranking.\"},{q:\"Where is Claude not available?\",a:\"Anthropic's Supported Regions Policy lists where Claude is offered, with territories of a listed country included. Countries it doesn't list are shown as not available.\"},{q:\"What is the difference between Pro and Max?\",a:\"Max gives several times Pro's usage, in two sizes named for that multiple, and is billed monthly only. Pro can also be paid by the year; both prices are listed.\"}]},gemini:{color:\"#1a73e8\",tagline:\"AI assistant\",intro:e=>`Google sells its AI plans (Google AI Plus, Pro and Ultra) at a different price in each country, in the local currency. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same plan.${g(e)} We read each country's own page on gemini.google, which shows that country's prices to any visitor and names the country in its region picker.`,faqs:e=>[{q:`Where is ${e.planName} cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}).`},{q:\"Why are there two Google AI Ultra prices?\",a:\"Google AI Ultra comes in two tiers with different usage limits, each with its own monthly price, so they are listed as two plans.\"},{q:\"Is this the same as Google One?\",a:\"Google AI Pro is also sold as a Google One plan. This page uses the prices on gemini.google; the Google One page uses Google One's own plans page.\"},{q:\"Why is a plan missing for my country?\",a:\"Some country pages offer only some of the plans, and a few show an empty or broken price. Those plans are left out or marked not verified rather than guessed.\"}]},grok:{color:\"#111111\",tagline:\"AI assistant\",intro:e=>`xAI sells Grok and X Premium together as one X Subscription, with its own price list for each country. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same plan.${g(e)} We read the price list that grok.com's own plans page loads, which names the country every price is for.`,faqs:e=>[{q:`Where is ${e.planName} cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}).`},{q:\"Does the X Subscription include X Premium?\",a:\"Yes. Every tier (Plus, Premium, Super and Ultra) includes X Premium benefits, so one price covers Grok and X. The older X Premium plans sold on x.com need a login to see, so they aren't listed.\"},{q:\"Are the launch discounts in the price?\",a:\"No. Discounts on the first months are listed as offers next to the plan; the ranking uses the regular price that follows them.\"},{q:\"Is tax included?\",a:\"Prices in the United States are before sales tax. For other countries grok.com's page and its price data disagree on whether tax is included, so we don't say either way.\"},{q:\"Why is my country missing?\",a:\"grok.com's price list is empty for some countries and territories, including several US territories and French overseas departments. Those are marked as not verified rather than filled in from a neighbour.\"}]},perplexity:$(\"Perplexity\",\"#1f6f6a\",\"AI search\"),\"disney-plus\":{color:\"#113ccf\",tagline:\"Streaming\",intro:e=>`Disney+ charges what each market will bear: the Disney, Pixar, Marvel and Star Wars library is the core everywhere, but the price follows local incomes. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same plan.${g(e)} We read each country's prices from its own page on disneyplus.com.`,faqs:e=>[{q:`Where is Disney+ cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}, as disneyplus.com lists it for that country.`},{q:\"Is the Disney+ library the same in every country?\",a:\"The Disney, Pixar, Marvel, Star Wars and National Geographic core is shared. Extra content varies by region because of licensing, and some countries add local sport or partner channels to the higher plans.\"},{q:\"Why don't all countries have the same Disney+ plans?\",a:\"Disney+ sells different plans per market. Much of Europe and the Americas has Premium, Standard and Standard with Ads; parts of Asia have Standard and Premium; Turkey has one plan with ads and one without; and the Middle East, Israel and South Africa have a single plan. Each plan is compared only with the same plan in other countries.\"},{q:\"Are there intro offers?\",a:\"Often. In much of Europe Disney+ charges less per month if you commit to a minimum term, and in Latin America it runs discounts for the first months. Where a country's page shows one, it's listed next to the regular price, which is what the ranking uses.\"},{q:\"Do these prices include tax?\",a:\"Most countries list Disney+ with VAT or sales tax included, and some pages say so outright, such as Brazil, Mexico and Japan. Where a page states it, the price is marked that way.\"},{q:\"Do cheaper countries get lower streaming quality?\",a:\"No. Picture quality depends on the plan you choose, not on the country you pay in.\"},{q:\"Why is my country missing?\",a:\"Disney+ isn't sold on its own everywhere: in India it's part of JioHotstar. Some country pages, mostly in the Caribbean, show no prices at all, so we leave those countries out rather than guess.\"}]},\"hbo-max\":{color:\"#002be7\",tagline:\"Streaming\",intro:e=>`HBO Max sets its plans and prices country by country, and even names them differently: the top plan is Premium in Europe, Ultimate in parts of Asia and Platinum in Latin America. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap.${g(e)} We read each country's prices from its own hbomax.com sign-up page, and the US prices from HBO Max's Help Center.`,faqs:e=>[{q:`Where is HBO Max cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}.`},{q:\"Are partner bundles included?\",a:\"No. Bundles with other services, such as Viu, RTL+, DAZN or TNT Sports, are left out, and so are yearly plans paid in monthly instalments with a minimum term. Only HBO Max's own monthly and yearly plans are compared.\"},{q:\"What if HBO Max shows a limited-time price?\",a:\"Some countries show a lower price until a set date, with the regular price after it. The ranking uses the regular price; the limited-time one is listed as an offer next to the plan.\"},{q:\"Do these prices include tax?\",a:\"The US prices are before tax, as HBO Max's Help Center says. Other countries' sign-up pages don't say either way, so their prices are shown as listed.\"},{q:\"Why is my country missing?\",a:\"Some countries and territories have no hbomax.com page of their own, and a few pages show prices only as text without plan data. Those countries are flagged rather than filled in from a neighbouring country.\"}]},\"paramount-plus\":{color:\"#0064ff\",tagline:\"Streaming\",intro:e=>`Paramount+ sets its prices market by market, in the local currency across Europe, Latin America, Canada and Australia. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap.${g(e)} We read the prices from ${y(\"Paramount+\",e)}${e.sources.helpCenter?\", whose pricing article lists its markets' plans in a table for each language\":\"\"}.`,faqs:e=>[{q:`Where is Paramount+ cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}.`},{q:\"Which plans are compared?\",a:\"Premium everywhere, plus Standard and Basic with Ads where they're sold, and Essential in the US, monthly and yearly. Not every market has every plan: France, Italy and Latin America have no ad-supported plan, and Germany lists monthly prices only.\"},{q:\"Do these prices include tax?\",a:\"The Help Center notes that Argentina's prices are before tax. It doesn't say either way for other markets, so their prices are shown as listed.\"},{q:\"Why are some Latin American prices in US dollars?\",a:\"Paramount+ lists Ecuador, El Salvador and Venezuela in US dollars. Ecuador and El Salvador use the dollar as their own currency; Venezuela is billed in dollars.\"}]},\"youtube-premium\":{color:\"#ff0033\",tagline:\"Video streaming\",intro:e=>`YouTube Premium competes with free YouTube, so in lower-income markets Google prices it low enough that removing ads is worth paying for. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same app.${g(e)} YouTube shows each visitor the prices of the country it places them in, so we read youtube.com/premium from a server in each country and keep a page only when YouTube itself says which country it served.`,faqs:e=>[{q:`Where is YouTube Premium cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}.`},{q:\"Does YouTube Premium include YouTube Music?\",a:\"Yes. YouTube Premium includes YouTube Music Premium in every country where it's sold. The cheaper Premium Lite plan, where it's offered, removes most ads from videos but doesn't include music.\"},{q:\"Do cheaper countries get fewer YouTube Premium features?\",a:\"No. Ad-free videos, background play and downloads are the same everywhere. A few music tracks can differ by region because of licensing, which isn't related to the price.\"},{q:\"Is there a free trial?\",a:\"Usually, for new members. Where YouTube's page offers one in a country, it's listed next to the plan. The ranking always uses the regular price that starts after the trial.\"},{q:\"What is the yearly price?\",a:\"Some countries sell a prepaid year of the Individual plan. It doesn't renew automatically, and it's shown as the yearly price next to the monthly one.\"},{q:\"Why isn't my country listed?\",a:\"YouTube sometimes hides its plans from our automated checks, even in countries where Premium is sold. A country is only listed once YouTube's own page has confirmed it and shown its prices.\"}]},\"youtube-music\":{color:\"#ff0033\",tagline:\"Music streaming\",intro:e=>`YouTube Music Premium is YouTube's music-only membership: ad-free music, downloads and background play, without the ad-free videos of YouTube Premium. Google prices it country by country, like Premium. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same app.${g(e)} YouTube shows each visitor the prices of the country it places them in, so we read youtube.com/musicpremium from a server in each country and keep a page only when YouTube itself says which country it served.`,faqs:e=>[{q:`Where is YouTube Music Premium cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}.`},{q:\"Is YouTube Music Premium the same as YouTube Premium?\",a:\"No. YouTube Premium includes YouTube Music Premium and adds ad-free videos. YouTube Music Premium covers music only, and has its own prices in each country.\"},{q:\"Is there a free trial?\",a:\"Usually, for new members. Where YouTube's page offers one in a country, it's listed next to the plan. The ranking always uses the regular price that starts after the trial.\"},{q:\"Does the iPhone app charge the same?\",a:\"Not always: the YouTube Music app sets its own App Store prices. Where both are known, the Website vs App Store page compares the two for the same plan and country.\"},{q:\"Why isn't my country listed?\",a:\"YouTube sometimes hides its plans from our automated checks, even in countries where Music Premium is sold. A country is only listed once YouTube's own page has confirmed it and shown its prices.\"}]},\"x-premium\":$(\"X Premium\",\"#111111\",\"Social\"),\"meta-verified\":$(\"Meta Verified\",\"#e1306c\",\"Social\"),\"playstation-plus\":{color:\"#0070d1\",tagline:\"Gaming\",intro:e=>`Sony sets PlayStation Plus prices country by country on its regional PlayStation Store, and the gaps are wide for a subscription that unlocks the same online play and largely the same game catalogue. ${e.planName} costs ${e.cheapest.local} in ${e.cheapest.country} (${e.cheapest.usd} a month)${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap.${g(e)} We read each country's prices from its own page on playstation.com, for the monthly and the yearly plan.`,faqs:e=>[{q:`Where is PlayStation Plus cheapest in ${e.year}?`,a:`${e.cheapest.country}, where ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd} a month), as listed on playstation.com for that country.`},{q:\"Is the yearly plan cheaper than paying monthly?\",a:\"Yes, in every country we checked the yearly plan works out cheaper per month than the monthly one. The price list for each country shows both, and the ranking uses the monthly plan wherever it's sold so countries are compared like for like. Sony also sells a three-month plan, which we leave out.\"},{q:\"What's the difference between Premium and Deluxe?\",a:\"Both are the top tier, above Essential and Extra. Premium includes cloud game streaming; Deluxe is sold in countries where Sony doesn't offer streaming, so it has the classics catalogue and game trials but no streaming. They're listed as separate plans.\"},{q:\"Are there PlayStation Plus discounts?\",a:\"Sony runs sales a few times a year that lower the first term of a plan, often the yearly one. When a country's page shows a sale, we list it as an offer next to the regular price, which is what the plan renews at.\"},{q:\"Can I buy PlayStation Plus from another country's store?\",a:\"Your PlayStation account is tied to the country it was created in, and the store only takes payment methods from that country. Gift cards are region-locked too, so a cheaper country's price generally isn't available to you.\"}]},\"xbox-game-pass\":{color:\"#107c10\",tagline:\"Gaming\",intro:e=>`Microsoft prices Xbox Game Pass separately in each market it sells it in. ${e.planName} costs ${e.cheapest.local} in ${e.cheapest.country} (${e.cheapest.usd})${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same catalogue.${g(e)} We read the prices xbox.com shows for each country, straight from the Microsoft Store catalog it loads them from.`,faqs:e=>[{q:`Where is Xbox Game Pass cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}.`},{q:\"What happened to Game Pass Core and Standard?\",a:\"Microsoft renamed them: Core is now Game Pass Essential and Standard is now Game Pass Premium. Ultimate and PC Game Pass kept their names.\"},{q:\"Do these prices include tax?\",a:\"We show the price Microsoft lists for each country. Many countries list it with VAT included; others, such as the US and India, list it before tax and add tax at checkout, and the price list marks which is which.\"},{q:\"Is there a Game Pass trial?\",a:\"In some countries Microsoft offers a short first period at a token price before the regular monthly price starts. Where xbox.com offers one, it's shown as an offer next to the plan.\"},{q:\"Why isn't every plan sold in my country?\",a:\"Microsoft sells console Game Pass in fewer countries than PC Game Pass. We only list the plans xbox.com says are available in each country.\"}]},\"apple-music\":{color:\"#fa243c\",tagline:\"Music streaming\",intro:e=>`Apple Music keeps its prices closer together than most music apps: it discounts less in lower-income markets and leans on Apple's own devices rather than on price. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}, a ${e.spread} gap across ${e.countries} countries.${g(e)}`,faqs:e=>[{q:`Where is Apple Music cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for the ${e.planName} plan, as listed on Apple's website for that country.`},{q:\"Does Apple Music have a free trial?\",a:\"Apple offers new subscribers a free first month in most countries, and longer offers when you buy a new Apple device. Where Apple's page for a country shows a trial, it's listed next to that country's price.\"},{q:\"Do I need an Apple device to use Apple Music?\",a:\"No. Apple Music also works on Android, Windows and the web. Some extras, such as Siri and HomePod control, only work on Apple devices.\"},{q:\"Is the sound quality the same in cheaper countries?\",a:\"Yes. Every subscriber gets the same audio options, including lossless, wherever they pay.\"},{q:\"Where do the Apple Music prices come from?\",a:b(e)}]},\"apple-tv-plus\":{color:\"#111111\",tagline:\"Streaming\",intro:e=>`Apple TV (the subscription once called Apple TV+) is one of the few streaming services with a single catalogue of originals everywhere, yet Apple still prices it country by country. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same shows.${g(e)}`,faqs:e=>[{q:`Where is Apple TV cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}), as listed on Apple's website for that country.`},{q:\"Is Apple TV the same as Apple TV+?\",a:\"Yes. Apple renamed the Apple TV+ subscription to Apple TV. It's the same service of Apple Originals, separate from the Apple TV app and the Apple TV box.\"},{q:\"Is the Apple TV catalogue the same in every country?\",a:\"Mostly. Apple TV is built on Apple Originals, which are released worldwide, so cheaper countries get the same shows and films. Some countries get extra sports or partner bundles.\"},{q:\"Does Apple TV have a free trial?\",a:\"New subscribers usually get a free week, and buying a new Apple device often comes with a few months free. Where Apple's page for a country shows a trial, it's listed next to that country's price.\"},{q:\"Where do the Apple TV prices come from?\",a:b(e)}]},\"apple-arcade\":{color:\"#ff3b30\",tagline:\"Gaming\",intro:e=>`Apple Arcade is one subscription for a catalogue of games without ads or in-app purchases, shared with up to five family members. Apple sets its price per country: ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}, a ${e.spread} gap across ${e.countries} countries.${g(e)}`,faqs:e=>[{q:`Where is Apple Arcade cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}), as listed on Apple's website for that country.`},{q:\"Can my family share one Apple Arcade subscription?\",a:\"Yes. With Family Sharing, up to five other people can play on one subscription at no extra cost, in every country.\"},{q:\"Are the games the same in every country?\",a:\"Nearly all of them. The catalogue is the same worldwide apart from a few titles limited by age ratings or local rules, so the price difference isn't about what you get.\"},{q:\"Where do the Apple Arcade prices come from?\",a:b(e)}]},\"icloud-plus\":{color:\"#3693f3\",tagline:\"Cloud storage\",intro:e=>`iCloud+ is Apple's paid storage plan, from the smallest tier up to the largest family-sized ones, plus privacy extras like Hide My Email. Apple sets the price of each tier per country: ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}.${g(e)} Use the plan tabs to compare the larger tiers.`,faqs:e=>[{q:`Where is iCloud+ cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}, as listed on Apple's website for that country.`},{q:\"Can I share iCloud+ with my family?\",a:\"Yes. Every iCloud+ plan can be shared with your Family Sharing group, so one plan can cover the whole household's storage.\"},{q:\"Does my iCloud+ price change if I travel?\",a:\"No. You pay the price of the country your Apple Account is set to, wherever you use it. Changing your account's country changes the price.\"},{q:\"Where do the iCloud+ prices come from?\",a:b(e)}]},\"apple-one\":{color:\"#1d1d1f\",tagline:\"Subscription bundle\",intro:e=>`Apple One bundles Apple Music, Apple TV, Apple Arcade and iCloud+ storage (plus more on Premier, where it's sold) into one monthly price. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same bundle.${g(e)}`,faqs:e=>[{q:`Where is Apple One cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}, as listed on Apple's website for that country.`},{q:\"Why isn't Apple One sold in some countries anymore?\",a:\"Apple has stopped selling Apple One to new subscribers in a number of countries. Existing subscribers there keep it as long as they don't cancel. Those countries are listed as not available.\"},{q:\"Is Apple One cheaper than paying for each service?\",a:\"Usually, if you'd use at least two of the services anyway. Compare the bundle price here with the Apple Music, Apple TV, Apple Arcade and iCloud+ pages for your country.\"},{q:\"Where do the Apple One prices come from?\",a:b(e)}]},\"microsoft-365\":{color:\"#0078d4\",tagline:\"Office apps and cloud storage\",intro:e=>`Microsoft sets a separate price for its Office and OneDrive plans in each country, in the local currency almost everywhere. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same apps and storage.${g(e)} We read each country's prices from Microsoft's own store, for the plans its store sells there.`,faqs:e=>[{q:`Where is ${e.planName} cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}), as Microsoft's store lists it for that country.`},{q:\"Is it cheaper to pay yearly?\",a:\"Usually. Microsoft's yearly price is normally lower than twelve monthly payments. Each plan shows both where the store sells both, so you can compare them country by country.\"},{q:\"Do these prices include tax?\",a:\"Most countries' stores list prices with VAT or GST included and say so next to the price. The US lists them before sales tax, which is added at checkout.\"},{q:\"What is the Basic plan?\",a:\"Basic is Microsoft's storage-only plan: extra OneDrive space and ad-free Outlook, without the desktop Office apps that Personal and Family include.\"},{q:\"Why is a plan missing for my country?\",a:\"Microsoft doesn't sell every plan everywhere; Japan's store has no Personal plan, for example. A country is only listed with the plans its own store offers for sale.\"}]},adobe:{color:\"#eb1000\",tagline:\"Creative and PDF apps\",intro:e=>`Adobe prices its apps country by country, and since adding regional pricing it charges markedly less in countries such as India and Thailand. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same apps.${g(e)} We read the prices each country's adobe.com plans page shows, from Adobe's own price data.`,faqs:e=>[{q:`Where is ${e.planName} cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) on the annual plan billed monthly, as adobe.com lists it there.`},{q:\"What's the difference between Adobe's monthly and annual plans?\",a:\"Adobe sells most apps three ways: an annual plan paid monthly, which is the price we rank by; the same annual plan paid up front, shown as the yearly price; and a monthly plan you can cancel any time, which costs more per month. Cancelling an annual plan early can cost a fee.\"},{q:\"Do these prices include tax?\",a:\"Adobe shows prices with VAT or GST included in most countries and before sales tax in the US. Each price is marked the way adobe.com shows it.\"},{q:\"Are there free trials or intro offers?\",a:\"Often. Adobe runs introductory prices, such as a discount for the first months, that vary by country. Where the plans page shows one, it's listed next to the regular price, which is what the ranking uses.\"},{q:\"Why is my country missing?\",a:\"Some countries only have a regional adobe.com site shared with neighbours, or a site without a plans page. We only list a price that a country's own plans page shows.\"}]},\"google-one\":{color:\"#1a73e8\",tagline:\"Cloud storage\",intro:e=>`Google prices Google One storage and its Google AI plans separately in each country, in the local currency. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same storage.${g(e)} Google shows each visitor the prices of the country it places them in, so we read Google One's plans page from a server in each country and keep it only when Google's own page data names that country.`,faqs:e=>[{q:`Where is ${e.planName} cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}).`},{q:\"Is it cheaper to pay yearly?\",a:\"Usually. Google's yearly price is lower than twelve monthly payments. Both are shown where the plans page offers both.\"},{q:\"What is Google AI Pro?\",a:\"Google AI Pro is the Google One plan that adds Google's Gemini AI features on top of a large amount of storage for Gmail, Drive and Photos.\"},{q:\"Why isn't every plan sold in my country?\",a:\"Google doesn't offer every storage size everywhere: some countries' plans pages show fewer tiers. A country is only listed with the plans its own page offers.\"}]},deezer:{color:\"#a238ff\",tagline:\"Music streaming\",intro:e=>`Deezer charges a different price for Premium depending on the country you sign up from. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same catalogue.${g(e)} Deezer shows each visitor the prices of the country it places them in, so we read its offers page from a server in each country and keep it only when the page itself names that country.`,faqs:e=>[{q:`Where is Deezer Premium cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}). The ranking uses the ${e.planName} plan in every country.`},{q:\"Does Deezer have yearly plans?\",a:\"In countries where Deezer's offers page has an Annual tab, we list the yearly total as the page shows it, next to the monthly price, never a monthly equivalent.\"},{q:\"Why are some Deezer prices missing?\",a:\"Some pages show prices with a bare dollar sign and no currency name. Unless the US dollar is that country's own currency, we can't tell which dollar is meant, so the price stays unverified instead of being guessed.\"}]},\"prime-video\":{color:\"#1a98ff\",tagline:\"Streaming\",intro:e=>`Prime Video on its own, without the rest of Amazon Prime, is priced country by country on primevideo.com. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same service. On primevideo.com Amazon shows each visitor the prices of the country it places them in, so we read the sign-up page from a server in each country and keep it only when the page names that country. In the United States it is sold on amazon.com, and its price comes from Amazon's own help article on membership fees; Guam and Puerto Rico, which primevideo.com serves like the United States with no price of their own, take the US price, marked as likely.`,faqs:e=>[{q:`Where is Prime Video cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}).`},{q:\"Is this the same as Amazon Prime?\",a:\"No. In countries with their own Amazon store, Prime Video usually comes with an Amazon Prime membership, which has its own page. This page covers the Prime Video subscription sold by itself: on primevideo.com, and on amazon.com in the United States.\"},{q:\"Why are the UK or Germany missing?\",a:\"Amazon sells Prime Video in those countries through its own stores (amazon.co.uk, amazon.de and a few others), not on primevideo.com, and no official page there states the price of Prime Video on its own, so they are marked as not verified here.\"}]},tidal:{color:\"#111111\",tagline:\"Music streaming\",intro:e=>`Tidal sets its own price in each of the countries it sells in, in the local currency. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same catalogue.${g(e)} Tidal's pricing page shows each visitor the prices of their own country, so we read it from a server in each country and keep it only when Tidal's own price data names that country.`,faqs:e=>[{q:`Where is Tidal cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}).`},{q:\"What is the Tidal DJ plan?\",a:\"DJ is Tidal's plan for DJs, priced above Individual; its Help Center lists it next to Individual, Family and Student. Students pay a reduced DJ Student price where Tidal offers it.\"},{q:\"Is tax included in Tidal's prices?\",a:\"Not in the United States or Canada: Tidal adds state and provincial taxes on top, as its Help Center explains. Elsewhere the listed price is what Tidal shows on its pricing page.\"}]},\"nintendo-switch-online\":{color:\"#e60012\",tagline:\"Gaming\",intro:e=>`Nintendo prices Switch Online separately in each country's eShop, in the local currency. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same online service.${g(e)} We read each country's prices from the Nintendo eShop's own membership page, the place you actually buy it.`,faqs:e=>[{q:`Where is Nintendo Switch Online cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} (${e.cheapest.usd}) for ${e.planName}.`},{q:\"What does the Expansion Pack add?\",a:\"The Expansion Pack adds more classic game libraries and some add-on content on top of the standard membership. It is sold as a yearly membership, for one account or for a family group.\"},{q:\"Is there a free trial?\",a:\"Where the eShop offers one, the free trial is listed as an offer next to the one-month individual membership, which it turns into unless you cancel.\"},{q:\"Is tax included?\",a:\"In the United States, Canada and some Caribbean shops the eShop adds tax at checkout. Most other shops say on the page that tax is included.\"},{q:\"Why isn't my country listed?\",a:\"Nintendo only sells Switch Online where its eShop sells memberships. Countries without one are listed as not available.\"}]},audible:{color:\"#f7991c\",tagline:\"Audiobooks\",intro:e=>`Audible runs a separate store, with its own plans and prices, in each country it has a marketplace for. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap.${g(e)} We read each marketplace's own plans page (audible.com, audible.de, audible.co.jp and the rest), which names the marketplace it belongs to.`,faqs:e=>[{q:`Where is Audible cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}.`},{q:\"What are the annual plans?\",a:\"Some marketplaces sell Premium as a yearly plan with a fixed number of credits, paid once a year. They are separate plans here, not a yearly price for monthly Premium. In some countries they end after a year instead of renewing.\"},{q:\"Why is there only one plan in some countries?\",a:\"Some marketplaces sell a single membership instead of Standard and Premium. It is listed as the only plan Audible sells there.\"},{q:\"Are the intro offers in the price?\",a:\"No. Seasonal offers and free trials are listed as offers next to the plan; the ranking uses the regular price that follows them.\"},{q:\"Why isn't my country listed?\",a:\"Audible sends some countries to another country's store, at that store's prices and in its currency. We only list the countries Audible has its own marketplace for.\"}]},nordvpn:{color:\"#4687ff\",tagline:\"VPN\",intro:e=>`NordVPN charges one global price list in most of the world, but some countries have a price of their own in their own currency. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap.${g(e)} We read NordVPN's own checkout price list, and list only the countries that have a price list of their own, plus the United States.`,faqs:e=>[{q:`Where is NordVPN cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}.`},{q:\"Why are so few countries listed?\",a:\"NordVPN picks the currency it shows from where the visitor is, and most countries share one global price list. We can't tell which currency each of those countries sees without visiting from there, so only countries with a price list of their own are listed.\"},{q:\"Which prices are shown?\",a:\"The monthly price is NordVPN's one-month plan. The yearly price is what the one- and two-year plans renew at after their first term. The discounted first term, often with extra months, is listed as an offer.\"},{q:\"Is tax included?\",a:\"No. NordVPN adds VAT or sales tax at checkout, depending on where you are.\"}]},\"ubisoft-plus\":{color:\"#0070ff\",tagline:\"Gaming\",intro:e=>`Ubisoft sells Ubisoft+ through regional Ubisoft Store sites, each with its own currency. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap for the same games.${g(e)} We read each store's own Ubisoft+ page, which says which country the store is for.`,faqs:e=>[{q:`Where is Ubisoft+ cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}) for ${e.planName}.`},{q:\"What is the difference between Classics and Premium?\",a:\"Classics is a catalogue of older Ubisoft games on PC. Premium adds new releases from launch day and premium editions. Both are sold monthly or yearly.\"},{q:\"Why are so few countries listed?\",a:\"Ubisoft's European store serves many countries at one euro price without saying which, and several regional stores show no plans to visitors from abroad. Only stores that name their own country are listed.\"}]},\"amazon-prime\":{color:\"#1399ff\",tagline:\"Shopping and streaming\",intro:e=>`Amazon runs a separate store in each country it sells in, and each store sets its own Prime fee. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap.${g(e)} We read each country's price from its own Amazon store's Prime sign-up page and check it against that store's help page on the Prime fee.`,faqs:e=>[{q:`Where is Amazon Prime cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}), as that country's Amazon store lists it.`},{q:\"Why does Prime cost so much less in some countries?\",a:\"Each Amazon store prices Prime for its own market. Where the store is newer or competes with strong local shops, Prime is priced low to win members. What's included also differs: delivery perks and the Prime Video catalogue vary by country.\"},{q:\"Which countries are listed?\",a:\"Countries with their own Amazon store, plus a few that a store's help page prices by delivery address: Austria and Luxembourg on amazon.de, Colombia on amazon.com. Belgium uses the price of its own store, amazon.com.be.\"},{q:\"Are free trials and intro offers included?\",a:\"Most stores give new members a free trial, and some offer a lower price for the first months. These are listed next to the plan; the ranking uses the regular price that follows.\"},{q:\"Are student or discounted plans compared?\",a:\"No. Student, young-adult and means-tested plans need proof of eligibility, so they're left out. India's cheaper Prime Lite is listed as its own plan.\"},{q:\"Do these prices include tax?\",a:\"Where the store's help page says so, the price is marked: Japan and the Gulf stores include tax, while the US and Canada add it at checkout. Other stores don't say either way.\"}]},proton:{color:\"#6d4aff\",tagline:\"Private email and storage\",intro:e=>`Proton doesn't price by country but by currency: it sells in US dollars, euros and Swiss francs worldwide, and in a local currency in a handful of countries such as the UK, Japan and Brazil. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap.${g(e)} We read the prices from Proton's own price list, the one its pricing page shows.`,faqs:e=>[{q:`Where is ${e.planName} cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}), in the currency Proton bills there.`},{q:\"Why are only some countries listed?\",a:\"Proton has a local price only in the few countries whose currency it accepts. Everyone else pays the same amount in US dollars, euros or Swiss francs, so we list the countries that use one of those as their own currency rather than repeat the same price for every other country.\"},{q:\"Is the yearly plan cheaper?\",a:\"Yes. Proton's yearly price is lower than twelve monthly payments. Both are shown; the ranking uses the monthly plan.\"},{q:\"Do these prices include tax?\",a:\"Proton's pricing page shows prices with tax included. The amount at checkout can still change with the billing country's VAT.\"}]},\"twitch-turbo\":{color:\"#9146ff\",tagline:\"Ad-free Twitch\",intro:e=>`Twitch Turbo removes ads across Twitch. Twitch sells it at one US-dollar price in most of the world and sets a price of its own for a few dozen countries, mostly in their currency. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}: a ${e.spread} gap.${g(e)} We read the prices from Twitch's own Help Center article on Turbo pricing by country.`,faqs:e=>[{q:`Where is Twitch Turbo cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}), as Twitch's Help Center lists it.`},{q:\"Why do so many countries pay the same price?\",a:\"Twitch's article gives a few dozen countries a Turbo price of their own and says every other country pays one price in US dollars. We show that price for those countries, marked as likely rather than verified, except where nothing shows Twitch sells Turbo: countries under sanctions, and mainland China, where Twitch is blocked.\"},{q:\"How up to date are these prices?\",a:\"Twitch's article shows when it was last edited, and that date is listed with each price. Prices from an article more than a year old are marked as likely rather than verified. We also compare the article with the price twitch.tv itself shows in the country we check from; if they disagree, that country is held back for review.\"},{q:\"Is there a yearly Turbo plan?\",a:\"No. Turbo is a monthly subscription. The prices are for buying on Twitch's website; buying through a phone's app store can cost a different amount.\"}]},\"apple-fitness-plus\":{color:\"#3aa335\",tagline:\"Fitness\",intro:e=>`Apple Fitness+ is Apple's workout and meditation service, built around iPhone and Apple Watch, and what it costs depends on where you live. ${e.planName} costs ${e.cheapest.local} (${e.cheapest.usd}) in ${e.cheapest.country}${f(e)} and ${e.priciest.usd} in ${e.priciest.country}, a ${e.spread} gap across ${e.countries} countries.${g(e)}`,faqs:e=>[{q:`Where is Apple Fitness+ cheapest in ${e.year}?`,a:`${e.cheapest.country}, at ${e.cheapest.local} a month (${e.cheapest.usd}), as listed on Apple's website for that country.`},{q:\"Do I need an Apple Watch for Apple Fitness+?\",a:\"No. Apple Fitness+ works with an iPhone on its own. An Apple Watch, compatible AirPods or a Bluetooth heart rate monitor adds live metrics on screen.\"},{q:\"Can I pay for Apple Fitness+ by the year?\",a:\"Yes. Apple sells Fitness+ by the month or by the year, and both prices are listed for each country. The ranking uses the monthly price.\"},{q:\"Does Apple Fitness+ have a free trial?\",a:\"New subscribers usually get a free month, and buying a new Apple device often comes with a longer free period. Where Apple's page for a country shows a trial, it's listed next to that country's price.\"},{q:\"Why is my country listed as not verified?\",a:\"Some of Apple's country pages give one monthly price in the main text and another in the small print. Until the page agrees with itself, that country is listed as not verified rather than shown with either price.\"},{q:\"Where do the Apple Fitness+ prices come from?\",a:b(e)}]}};({...v,default:w});let x={spotify:{title:\"Spotify\",slug:\"spotify\",get svg(){return p+\"Spotify\"+u+this.path+d},path:\"M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z\",source:\"https://developer.spotify.com/documentation/general/design-and-branding/#using-our-logo\",hex:\"1ED760\",guidelines:\"https://developer.spotify.com/documentation/general/design-and-branding/#using-our-logo\"},netflix:{title:\"Netflix\",slug:\"netflix\",get svg(){return p+\"Netflix\"+u+this.path+d},path:\"m5.398 0 8.348 23.602c2.346.059 4.856.398 4.856.398L10.113 0H5.398zm8.489 0v9.172l4.715 13.33V0h-4.715zM5.398 1.5V24c1.873-.225 2.81-.312 4.715-.398V14.83L5.398 1.5z\",source:\"ht