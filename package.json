{
  "name": "valstara-prelaunch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "backup:drill": "sh infra/backups/restore-drill.sh",
    "coverage": "EMAIL_TOKEN_SECRET=local-only-email-token-secret-32-chars EMAIL_BASE_URL=http://localhost:4321 node scripts/ci/run-coverage.mjs",
    "ci:red-paths": "node --test test/ci-red-paths.test.mjs",
    "ci:security-red-paths": "node --test test/security-gates.test.mjs",
    "db:migrate": "tsx src/server/db/run-migrations.ts",
    "email:apply-unsubscribe": "tsx scripts/apply-unsubscribe.ts",
    "dev": "astro dev",
    "format": "prettier --check .",
    "fraud:allow-domain": "tsx scripts/allow-domain.ts",
    "lint": "eslint .",
    "security": "node scripts/ci/security-gates.mjs",
    "test:a11y": "EMAIL_TOKEN_SECRET=local-only-email-token-secret-32-chars EMAIL_BASE_URL=http://localhost:4321 node --test test/accessibility.test.mjs",
    "test:privacy": "node scripts/ci/security-gates.mjs && EMAIL_TOKEN_SECRET=local-only-email-token-secret-32-chars EMAIL_BASE_URL=http://localhost:4321 node --test --test-concurrency=1 test/e1-11-rendered-page.test.mjs test/signup-form-rendered-page.test.mjs",
    "preview": "astro preview",
    "test": "EMAIL_TOKEN_SECRET=local-only-email-token-secret-32-chars EMAIL_BASE_URL=http://localhost:4321 tsx --test --test-concurrency=1",
    "test:production-stack": "node infra/compose/assert-production-stack.mjs",
    "test:stack": "node infra/compose/assert-stack.mjs",
    "typecheck": "astro check"
  },
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "dependencies": {
    "@astrojs/node": "11.1.4",
    "astro": "7.2.8",
    "drand-client": "1.4.2",
    "imapflow": "2.1.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler": "2.13.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.15.3",
    "@types/pg": "8.15.6",
    "axe-core": "4.10.3",
    "c8": "12.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "fast-check": "4.5.3",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
