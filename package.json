    "@eslint/js": "10.0.1",
    "@types/node": "22.15.3",
    "@types/pg": "8.15.6",
    "c8": "12.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "fast-check": "4.5.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
